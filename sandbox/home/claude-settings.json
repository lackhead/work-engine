{
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.vault-token)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)"
    ],
    "ask": [
      "Bash(git push:*)"
    ]
  },
  "statusLine": { "type": "command", "command": "bash ~/work/engine/bin/claude-statusline" },
  "effortLevel": "high",
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/work/engine/bin/work-session-breadcrumb"
          }
        ]
      }
    ]
  }
}
