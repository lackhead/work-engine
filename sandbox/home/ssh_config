# Sandbox SSH config — maps each git endpoint to its dedicated, mounted key.
#
# Not secret (no key material). The private keys are bind-mounted read-only at
# runtime by ~/work/engine/bin/sandbox; this file just says which key to use
# where and offers ONLY that key (IdentitiesOnly) so nothing leaks the wrong
# identity. See data/items/archived/isolated-claude-workspace Phase 2.

Host github.com
    User git
    IdentityFile ~/.ssh/sandbox_github
    IdentitiesOnly yes
    StrictHostKeyChecking accept-new

# Production (the dual-push target of `origin`): the `sig` system account. The
# deploy key is git-only-restricted in sig's authorized_keys, so this can push
# but never open a shell on prod.
Host sec.sci.utah.edu
    User sig
    IdentityFile ~/.ssh/sandbox_deploy
    IdentitiesOnly yes
    StrictHostKeyChecking accept-new

# Staging (the `test` remote): pushes as clake to the staging SecureHost. Same
# deploy key, also git-only-restricted there.
Host sec.stg.sci.utah.edu
    User clake
    IdentityFile ~/.ssh/sandbox_deploy
    IdentitiesOnly yes
    StrictHostKeyChecking accept-new
