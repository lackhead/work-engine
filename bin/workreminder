#!/usr/bin/env bash
#
# workreminder — create, list, show, complete, cancel, delete, and set due
# dates on reminders under ~/work/data/reminders/.
#
# Engine tool for the work system. Lives at ~/work/engine/bin/workreminder
# (the work-engine repo, on PATH). Companion completion:
# ~/work/engine/bin/completions/workreminder.fish.
#

set -u

# Shared boilerplate: WORK root, print_* output functions, trim/kebab/trunc/
# iso_now. Resolves to lib.sh in this script's own bin/ dir. See
# docs/bin-coding-standards.md.
# shellcheck source=lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

IFS='' read -r -d '' usage <<"EOF"

workreminder: create, list, show, complete, cancel, delete, promote, and set due dates on reminders

Usage:
   workreminder [ -h|--help ]
   workreminder [ -v|--verbose ] [ -d|--debug ] create   [-i|--item <slug>] [description...]
   workreminder [ -v|--verbose ] [ -d|--debug ] list     [--archived|--all]
   workreminder [ -v|--verbose ] [ -d|--debug ] show     <name>
   workreminder [ -v|--verbose ] [ -d|--debug ] complete <name>
   workreminder [ -v|--verbose ] [ -d|--debug ] cancel   <name>
   workreminder [ -v|--verbose ] [ -d|--debug ] delete   <name> [--force]
   workreminder [ -v|--verbose ] [ -d|--debug ] due      <name> [date]
   workreminder [ -v|--verbose ] [ -d|--debug ] promote  <name> [workitem create args...]

Arguments:
   -h|--help     Show what you are seeing right now
   -v|--verbose  Show what is happening as it happens
   -d|--debug    Show diagnostic detail (implies --verbose)

Description:
   create   With a description given, creates reminders/<slug>.md
            immediately, no prompts. With none, prompts for the
            description, whether to attach an existing item (picked
            interactively), and a slug to confirm.

   list     Display active reminders, sorted by created date;
            --archived/--all broaden the scope

   show     Prints the reminder information — piped through $PAGER if set,
            else plain output

   complete Sets status to completed and moves the reminder to
            reminders/archived/.

   cancel   Sets status to cancelled and moves the reminder to
            reminders/archived/.

   delete   Removes a reminder outright (delete from inventory). Prompts
            for confirmation; --force skips the prompt and is required to
            delete non-interactively.

   due      Sets or changes the (optional) due date (bare YYYY-MM-DD format);
            omitting the date clears any existing due date.

   promote  Creates a work item (title defaults to the reminder's own
            heading unless overridden by trailing args) and completes the
            reminder, in one step.

Examples:
   workreminder create
   workreminder create -i nagios
   workreminder create Call John back about the firewall exception
   workreminder list
   workreminder list --all
   workreminder show check-on-mikes-pr-progress
   workreminder complete check-on-mikes-pr-progress
   workreminder cancel beta-lm-license-hague
   workreminder due check-on-mikes-pr-progress 2026-05-15
   workreminder due check-on-mikes-pr-progress
   workreminder promote check-on-mikes-pr-progress
   workreminder promote check-on-mikes-pr-progress -b Review Mike's PR properly

EOF

# Resolve a reminder name to its full path, checking both zones. Echoes the
# path and returns 0 if found; returns 1 with no output otherwise.
resolve_reminder() {
    local name=$1 root="$WORK/data/reminders"
    if [ -f "$root/$name.md" ]; then
        printf '%s' "$root/$name.md"; return 0
    elif [ -f "$root/archived/$name.md" ]; then
        printf '%s' "$root/archived/$name.md"; return 0
    fi
    return 1
}

###
### Subcommands
###
# Interactive picker over item slugs across all three zones (top-level,
# backlog/, archived/) -- a reminder's related-item is a soft cross-
# reference, not a write target the way workitem log's resolution is, so
# unlike wi_log_pick_item this deliberately doesn't exclude backlog/archived.
# fzf if available, else a numbered-menu fallback (copied, not shared --
# see docs/bin-coding-standards.md's no-shared-library convention -- this is
# a different script from workitem, so it gets its own copy of the same
# shape wi_log_pick_item uses). Echoes the chosen slug on stdout; a clean
# cancel (empty fzf selection, or a blank fallback answer) prints a status
# line and returns 1 with nothing echoed -- never an error.
wr_pick_item() {
    local root="$WORK/data/items" slugs=() titles=() zones=() p slug title_f z dir
    for z in '' backlog/ archived/; do
        dir="$root/$z"
        [ -d "$dir" ] || continue
        for p in "$dir"*/; do
            [ -d "$p" ] || continue
            slug=$(basename "$p")
            case "$slug" in backlog|archived) continue ;; esac
            [ -f "$p$slug.md" ] || continue
            title_f=$(sed -n 's/^title: *//p' "$p$slug.md" | head -1)
            slugs+=("$slug")
            titles+=("${title_f:-$slug}")
            zones+=("$z")
        done
    done
    if [ ${#slugs[@]} -eq 0 ]; then
        print_status "No items to attach to." >&2
        return 1
    fi

    # Archived entries get a visual tag -- a combined-zone list shouldn't
    # silently blur "currently active" with "already closed".
    local i tag entries=()
    for i in "${!slugs[@]}"; do
        tag=''
        [ "${zones[$i]}" = "archived/" ] && tag=' (archived)'
        entries+=("${slugs[$i]}  —  ${titles[$i]}${tag}")
    done

    if command -v fzf >/dev/null 2>&1; then
        local choice
        choice=$(printf '%s\n' "${entries[@]}" | fzf --prompt='item> ') || true
        if [ -z "$choice" ]; then
            print_status "No item selected." >&2
            return 1
        fi
        printf '%s' "${choice%% *}"
    else
        local choice
        for i in "${!entries[@]}"; do
            printf '%2d) %s\n' "$((i + 1))" "${entries[$i]}" >&2
        done
        read -r -p "Which item? [1-${#slugs[@]}, blank for none] " choice
        if [ -z "$choice" ]; then
            print_status "No item selected." >&2
            return 1
        fi
        if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt "${#slugs[@]}" ]; then
            print_error "Invalid selection."
            return 1
        fi
        printf '%s' "${slugs[$((choice - 1))]}"
    fi
}

wr_create() {
    local item='' desc_parts=() a
    while [ $# -gt 0 ]; do
        a=$1
        case "$a" in
            -i|--item) shift; item=${1:-} ;;
            --item=*)  item=${a#--item=} ;;
            -*)        print_error "Unknown option: $a"; return 1 ;;
            *)         desc_parts+=("$a") ;;
        esac
        shift
    done

    # --- description: positional args make this a fire-and-forget quick
    # add (skips every remaining prompt below); otherwise fall back to the
    # original always-prompted flow, unchanged. ---
    local desc=''
    [ ${#desc_parts[@]} -gt 0 ] && desc="${desc_parts[*]}"
    desc="$(trim "$desc")"

    local quick=false
    if [ -n "$desc" ]; then
        quick=true
    else
        read -r -p "reminder: " desc
        desc="$(trim "$desc")"
        if [ -z "$desc" ]; then
            print_error "Empty description — nothing created."; return 1
        fi
    fi

    if [ -z "$item" ] && [ "$quick" = false ]; then
        read -r -p "Attach to an existing item? [y/N] " reply
        if printf '%s' "$reply" | grep -qiE '^y'; then
            item=$(wr_pick_item) || item=''
        fi
    fi
    # Unconditional on $item being non-empty, exactly as before -- quick
    # mode can only populate $item via -i, so this still fires correctly
    # for -i in quick mode with zero special-casing.
    if [ -n "$item" ] && [ ! -f "$WORK/data/items/$item/$item.md" ] \
       && [ ! -f "$WORK/data/items/backlog/$item/$item.md" ] \
       && [ ! -f "$WORK/data/items/archived/$item/$item.md" ]; then
        print_warning "'$item' isn't an existing item; tagging anyway."
    fi

    # --- slug: in quick mode, auto-generate silently; otherwise proffer a
    # truncated default and let the user override it right here -- now that
    # the description is fully written out, this is the best moment to
    # judge whether the mechanical slug is any good. ---
    local default_slug slug
    default_slug=$(kebab "$desc")
    if [ "$quick" = true ]; then
        slug="$default_slug"
    else
        read -r -p "slug [$default_slug]: " slug
        slug="$(trim "$slug")"
        if [ -n "$slug" ]; then
            slug=$(kebab "$slug" 200)
        else
            slug="$default_slug"
        fi
    fi

    # Resolve a collision by appending -2, -3, ... rather than refusing --
    # once slugs are truncated/short, two unrelated descriptions legitimately
    # landing on the same slug is expected, not an error.
    local base="$slug" n=1
    while [ -e "$WORK/data/reminders/$slug.md" ] || [ -e "$WORK/data/reminders/archived/$slug.md" ]; do
        n=$((n + 1))
        slug="$base-$n"
    done
    [ "$slug" != "$base" ] && print_verbose "Slug '$base' taken — using '$slug'"

    local date_str file
    date_str=$(date +%Y-%m-%d)
    file="$WORK/data/reminders/$slug.md"
    print_verbose "Creating reminder: $file"

    {
        echo "---"
        echo "created: $date_str"
        echo "status: active"
        echo "source: manual"
        # Quoted deliberately: a bare [[slug]] is a YAML flow sequence, so the
        # unquoted form parses as the nested list [['slug']] rather than the
        # wikilink string every reader expects. See schema/items/CLAUDE.md's
        # related-items row for the same trap.
        [ -n "$item" ] && echo "related-item: \"[[$item]]\""
        echo "---"
        echo
        echo "# $desc"
    } > "$file"

    print_success "Created → ${file/#$HOME/\~}"
}

wr_list() {
    local scope=active a
    while [ $# -gt 0 ]; do
        a=$1
        case "$a" in
            --archived) scope=archived ;;
            --all)      scope=all ;;
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)  print_error "Unexpected argument: $a"; return 1 ;;
        esac
        shift
    done

    local root="$WORK/data/reminders"
    local show_status=false
    [ "$scope" != active ] && show_status=true

    local dirs=()
    case "$scope" in
        active)   dirs=("$root") ;;
        archived) dirs=("$root/archived") ;;
        all)      dirs=("$root" "$root/archived") ;;
    esac

    # Gather rows as tab-separated fields and sort by created date ascending
    # (oldest first) -- filenames no longer carry the date (it's frontmatter
    # only), so chronological order can't just fall out of an alphabetical
    # glob anymore.
    local rows='' dir f name status due desc created
    for dir in "${dirs[@]}"; do
        [ -d "$dir" ] || continue
        for f in "$dir"/*.md; do
            [ -f "$f" ] || continue
            name=$(basename "$f" .md)
            status=$(sed -n 's/^status: *//p' "$f" | head -1)
            [ "$scope" = active ] && [ "$status" != active ] && continue
            created=$(sed -n 's/^created: *//p' "$f" | head -1)
            due=$(sed -n 's/^due: *//p' "$f" | head -1)
            desc=$(sed -n 's/^# *//p' "$f" | head -1)
            rows="${rows}${created:-9999-99-99}"$'\t'"${due:--}"$'\t'"$status"$'\t'"$desc"$'\t'"$name"$'\n'
        done
    done

    if [ -z "$rows" ]; then
        echo "(none)"
        return 0
    fi

    if [ "$show_status" = true ]; then
        printf '%-11s %-9s %-44s %s\n' DUE STATUS DESC NAME
    else
        printf '%-11s %-44s %s\n' DUE DESC NAME
    fi

    while IFS=$'\t' read -r created due status desc name; do
        [ -n "$created" ] || continue
        if [ "$show_status" = true ]; then
            printf '%-11s %-9s %-44s %s\n' "$due" "$status" "$(trunc "$desc" 44)" "$name"
        else
            printf '%-11s %-44s %s\n' "$due" "$(trunc "$desc" 44)" "$name"
        fi
    done < <(printf '%s' "$rows" | sort -t $'\t' -k1,1)
}

wr_show() {
    local name='' a
    for a in "$@"; do
        case "$a" in
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)
                if [ -z "$name" ]; then name=$a
                else print_error "Too many arguments."; return 1
                fi ;;
        esac
    done
    if [ -z "$name" ]; then
        print_error "Usage: workreminder show <name>"; return 1
    fi

    local src
    src="$(resolve_reminder "$name")" || {
        print_error "No reminder '$name' found."; return 1
    }

    if [ -n "${PAGER:-}" ]; then
        # Intentionally unquoted: $PAGER commonly carries flags (e.g. "less -R"),
        # and quoting it would treat the whole string as one command name.
        $PAGER "$src"
    else
        cat "$src"
    fi
}

wr_finish() {
    local name=$1 newstatus=$2

    local root="$WORK/data/reminders"
    if [ -f "$root/archived/$name.md" ]; then
        print_error "'$name' is already archived."; return 1
    fi
    local src="$root/$name.md"
    if [ ! -f "$src" ]; then
        print_error "No reminder '$name' found."; return 1
    fi

    local tmp; tmp=$(mktemp)
    sed "s/^status:.*/status: $newstatus/" "$src" > "$tmp"
    mv "$tmp" "$src"
    print_debug "Frontmatter updated: status=$newstatus"
    # Stage the edit now, at its current path, before the `git mv` below --
    # otherwise `git mv` can stage the rename using the index's stale
    # (pre-edit) blob instead of this file's current content, silently
    # dropping the frontmatter edit from the eventual commit.
    if git -C "$WORK/data" rev-parse --git-dir >/dev/null 2>&1; then
        git -C "$WORK/data" add "$src" 2>/dev/null || true
    fi

    mkdir -p "$root/archived"
    local dest="$root/archived/$name.md"
    if [ -e "$dest" ]; then
        print_error "Target already exists: reminders/archived/$name.md"; return 1
    fi
    if git -C "$WORK/data" rev-parse --git-dir >/dev/null 2>&1 \
       && [ -n "$(git -C "$WORK/data" ls-files "reminders/$name.md")" ]; then
        git -C "$WORK/data" mv "reminders/$name.md" "reminders/archived/$name.md" || {
            print_error "Move to reminders/archived/$name.md failed — reminder left in place."
            return 1
        }
    else
        mv "$src" "$dest" || {
            print_error "Move to reminders/archived/$name.md failed — reminder left in place."
            return 1
        }
    fi

    print_success "Archived → reminders/archived/$name.md ($newstatus)"
}

wr_complete() {
    local name='' a
    for a in "$@"; do
        case "$a" in
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)
                if [ -z "$name" ]; then name=$a
                else print_error "Too many arguments."; return 1
                fi ;;
        esac
    done
    if [ -z "$name" ]; then
        print_error "Usage: workreminder complete <name>"; return 1
    fi
    wr_finish "$name" completed
}

wr_cancel() {
    local name='' a
    for a in "$@"; do
        case "$a" in
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)
                if [ -z "$name" ]; then name=$a
                else print_error "Too many arguments."; return 1
                fi ;;
        esac
    done
    if [ -z "$name" ]; then
        print_error "Usage: workreminder cancel <name>"; return 1
    fi
    wr_finish "$name" cancelled
}

# Argument parsing here is deliberately different from every other
# subcommand in this file: consume exactly one positional (name), then
# treat everything remaining as an opaque pass-through array for
# `workitem create` with zero interpretation -- those are workitem's own
# flags, not this command's, so this is a one-shift-then-take-the-rest
# parse, not a case-loop rejecting `-*`.
wr_promote() {
    if [ $# -eq 0 ]; then
        print_error "Usage: workreminder promote <name> [workitem create args...]"; return 1
    fi
    local name=$1
    shift
    local create_args=("$@")

    local root="$WORK/data/reminders"
    if [ -f "$root/archived/$name.md" ]; then
        print_error "'$name' is archived — promote only applies to active reminders."
        return 1
    fi
    local src="$root/$name.md"
    if [ ! -f "$src" ]; then
        print_error "No reminder '$name' found."
        return 1
    fi

    if [ ${#create_args[@]} -eq 0 ]; then
        local heading
        heading=$(sed -n 's/^# *//p' "$src" | head -1)
        # An empty heading here just means wi_create sees an empty title
        # and errors "title is required" -- already safe by construction,
        # surfaces through the same abort path below.
        create_args=("$heading")
    fi

    # Uncaptured (not wrapped in $(...)) so workitem create's own
    # "Created -> ..." banner reaches the user directly; only the exit
    # status is checked. Subprocess call (found via $PATH), not duplicated
    # inline -- same precedent as wi_complete/wi_delete calling `worktree rm`.
    if ! workitem create "${create_args[@]}"; then
        print_error "workitem create failed — '$name' left untouched."
        return 1
    fi

    wr_finish "$name" completed || {
        print_error "Work item was created, but completing '$name' failed (see above) — complete it manually."
        return 1
    }
}

wr_delete() {
    local name='' force=false a
    for a in "$@"; do
        case "$a" in
            --force) force=true ;;
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)
                if [ -z "$name" ]; then name=$a
                else print_error "Too many arguments."; return 1
                fi ;;
        esac
    done
    if [ -z "$name" ]; then
        print_error "Usage: workreminder delete <name> [--force]"; return 1
    fi

    local src
    src="$(resolve_reminder "$name")" || {
        print_error "No reminder '$name' found."; return 1
    }

    # Deletion is the one path that doesn't preserve the body -- see the root
    # CLAUDE.md's "nothing is deleted" principle. --force is the same explicit
    # admission `workitem delete` requires, so the two content types agree on
    # how dangerous this is; without it, the interactive prompt stands. The
    # prompt alone made this uncallable from a script or a non-interactive
    # session, which is why --force exists rather than replacing it.
    if [ "$force" != true ]; then
        if [ ! -t 0 ]; then
            print_error "Refusing to delete '$name' non-interactively without --force."
            return 1
        fi
        print_warning "About to permanently delete: ${src/#$HOME/\~}"
        read -r -p "This cannot be undone. Delete? [y/N] " yn
        if ! printf '%s' "$yn" | grep -qiE '^y'; then
            print_status "Cancelled — nothing deleted."; return 0
        fi
    fi

    rm -f "$src"
    print_success "Deleted ${src/#$HOME/\~}"
}

wr_due() {
    local name='' newdate='' a
    while [ $# -gt 0 ]; do
        a=$1
        case "$a" in
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)
                if [ -z "$name" ]; then name=$a
                elif [ -z "$newdate" ]; then newdate=$a
                else print_error "Too many arguments."; return 1
                fi ;;
        esac
        shift
    done
    if [ -z "$name" ]; then
        print_error "Usage: workreminder due <name> [date]"; return 1
    fi

    local src
    src="$(resolve_reminder "$name")" || {
        print_error "No reminder '$name' found."; return 1
    }

    if [ -n "$newdate" ] && ! [[ "$newdate" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
        print_error "Date must be YYYY-MM-DD."; return 1
    fi

    local tmp; tmp=$(mktemp)
    if grep -q '^due:' "$src"; then
        if [ -n "$newdate" ]; then
            sed "s/^due:.*/due: $newdate/" "$src" > "$tmp"
        else
            sed '/^due:/d' "$src" > "$tmp"
        fi
    elif [ -n "$newdate" ]; then
        awk -v d="$newdate" '/^status:/ { print; print "due: " d; next } { print }' "$src" > "$tmp"
    else
        cp "$src" "$tmp"
    fi
    mv "$tmp" "$src"

    if [ -n "$newdate" ]; then
        print_success "Set due: $newdate on ${src/#$HOME/\~}"
    else
        print_success "Cleared due date on ${src/#$HOME/\~}"
    fi
}

###
### Dispatch
###
# Parse global options before the subcommand so `workreminder -v list` works.
# -d implies -v.
# shellcheck disable=SC2034  # VERBOSE/DEBUG are read by print_* in lib.sh
while [ $# -gt 0 ]; do
    case "$1" in
        -v|--verbose) VERBOSE=true; shift ;;
        -d|--debug)   DEBUG=true; VERBOSE=true; shift ;;
        -h|--help|help) printf '%s\n' "$usage"; exit 0 ;;
        *) break ;;
    esac
done

cmd="${1:-}"
[ "$#" -gt 0 ] && shift
case "$cmd" in
    create)   wr_create "$@" ;;
    list)     wr_list "$@" ;;
    show)     wr_show "$@" ;;
    complete) wr_complete "$@" ;;
    cancel)   wr_cancel "$@" ;;
    delete)   wr_delete "$@" ;;
    due)      wr_due "$@" ;;
    promote)  wr_promote "$@" ;;
    '')      printf '%s\n' "$usage" ;;
    *)       print_error "Unknown command '$cmd' (try: workreminder help)"; exit 1 ;;
esac
