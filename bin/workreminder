#!/usr/bin/env bash
#
# workreminder — create, list, archive, delete, and set due dates on
# reminders under ~/work/data/reminders/.
#
# Engine tool for the work system. Lives at ~/work/engine/bin/workreminder
# (the work-engine repo, on PATH). Companion completion:
# ~/work/engine/bin/completions/workreminder.fish.
#

set -u

WORK="${WORK_ROOT:-$HOME/work}"

###
### Output functions
###
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NORMAL='\033[0m'
VERBOSE=false
DEBUG=false

print_status()  { echo -e "${BLUE}[INFO]${NORMAL} $1"; }
print_success() { echo -e "${GREEN}[SUCCESS]${NORMAL} $1"; }
print_warning() { echo -e "${YELLOW}[WARNING]${NORMAL} $1" >&2; }
print_error()   { echo -e "${RED}[ERROR]${NORMAL} $1" >&2; }
print_verbose() { [ "$VERBOSE" = true ] && echo -e "${BLUE}[VERBOSE]${NORMAL} $1" >&2 || true; }
print_debug()   { [ "$DEBUG" = true ] && echo -e "${BLUE}[DEBUG]${NORMAL} $1" >&2 || true; }

IFS='' read -r -d '' usage <<"EOF"

workreminder: create, list, show, archive, delete, and set due dates on reminders

Usage:
   workreminder [ -h|--help ]
   workreminder [ -v|--verbose ] [ -d|--debug ] create  [-i|--item <slug>]
   workreminder [ -v|--verbose ] [ -d|--debug ] list    [--archived|--all]
   workreminder [ -v|--verbose ] [ -d|--debug ] show    <name>
   workreminder [ -v|--verbose ] [ -d|--debug ] archive <name> [--addressed|--dismissed]
   workreminder [ -v|--verbose ] [ -d|--debug ] delete  <name>
   workreminder [ -v|--verbose ] [ -d|--debug ] due     <name> [date]

Arguments:
   -h|--help     Show what you are seeing right now
   -v|--verbose  Show what is happening as it happens
   -d|--debug    Show diagnostic detail (implies --verbose)

Description:
   create   Prompts for a description and creates reminders/<slug>.md.

   list     Display active reminders, sorted by created date; 
            --archived/--all broaden the scope

   show     Prints the reminder informatio — piped through $PAGER if set,
            else plain output

   archive  Sets status to addressed/dismissed (prompted if not given as a
            flag) and moves the reminder to reminders/archived/

   delete   Removes a reminder outright (delete from inventory)

   due      Sets or changes the (optional) due date (bare YYYY-MM-DD format);
            omitting the date clears any existing due date.

Examples:
   workreminder create
   workreminder create -i nagios
   workreminder list
   workreminder list --all
   workreminder show check-on-mikes-pr-progress
   workreminder archive check-on-mikes-pr-progress --addressed
   workreminder due check-on-mikes-pr-progress 2026-05-15
   workreminder due check-on-mikes-pr-progress

EOF

trim()  { printf '%s' "$1" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'; }

# Kebab-case $1, truncated to at most $2 characters (default 30). Truncation
# snaps back to the last complete word boundary that fits rather than
# cutting mid-word -- a long description should still read as words, not a
# ragged fragment. (A single first word longer than the cap is the one
# case that still gets a hard cut -- nothing left to snap back to.)
kebab() {
    local s max cut
    s=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')
    max=${2:-30}
    if [ ${#s} -le "$max" ]; then
        printf '%s' "$s"
        return
    fi
    cut="${s:0:$max}"
    [[ "$cut" == *-* ]] && cut="${cut%-*}"
    printf '%s' "$cut"
}

# Truncate to at most $2 chars, marking truncation with a trailing '..'.
trunc() {
    local s=$1 max=$2
    if [ ${#s} -le "$max" ]; then
        printf '%s' "$s"
    else
        printf '%s..' "${s:0:$((max - 2))}"
    fi
}

# Resolve a reminder name to its full path, checking both zones. Echoes the
# path and returns 0 if found; returns 1 with no output otherwise.
resolve_reminder() {
    local name=$1 root="$WORK/data/reminders"
    if [ -f "$root/$name.md" ]; then
        printf '%s' "$root/$name.md"; return 0
    elif [ -f "$root/archived/$name.md" ]; then
        printf '%s' "$root/archived/$name.md"; return 0
    fi
    return 1
}

###
### Subcommands
###
wr_create() {
    local item='' a
    while [ $# -gt 0 ]; do
        a=$1
        case "$a" in
            -i|--item) shift; item=${1:-} ;;
            --item=*)  item=${a#--item=} ;;
            -*)        print_error "Unknown option: $a"; return 1 ;;
            *)         print_error "workreminder create takes no positional arguments — it always prompts for the description."; return 1 ;;
        esac
        shift
    done

    # --- description: always prompted, never positional ---
    local desc
    read -r -p "reminder: " desc
    desc="$(trim "$desc")"
    if [ -z "$desc" ]; then
        print_error "Empty description — nothing created."; return 1
    fi

    if [ -z "$item" ]; then
        read -r -p "related item (slug, blank for none): " item
        item="$(trim "$item")"
    fi
    if [ -n "$item" ] && [ ! -f "$WORK/data/items/$item/$item.md" ] \
       && [ ! -f "$WORK/data/items/backlog/$item/$item.md" ] \
       && [ ! -f "$WORK/data/items/archived/$item/$item.md" ]; then
        print_warning "'$item' isn't an existing item; tagging anyway."
    fi

    # --- slug: proffer a truncated default, let the user override it right
    # here -- now that the description is fully written out, this is the
    # best moment to judge whether the mechanical slug is any good. ---
    local default_slug slug
    default_slug=$(kebab "$desc")
    read -r -p "slug [$default_slug]: " slug
    slug="$(trim "$slug")"
    if [ -n "$slug" ]; then
        slug=$(kebab "$slug" 200)
    else
        slug="$default_slug"
    fi

    # Resolve a collision by appending -2, -3, ... rather than refusing --
    # once slugs are truncated/short, two unrelated descriptions legitimately
    # landing on the same slug is expected, not an error.
    local base="$slug" n=1
    while [ -e "$WORK/data/reminders/$slug.md" ] || [ -e "$WORK/data/reminders/archived/$slug.md" ]; do
        n=$((n + 1))
        slug="$base-$n"
    done
    [ "$slug" != "$base" ] && print_verbose "Slug '$base' taken — using '$slug'"

    local date_str file
    date_str=$(date +%Y-%m-%d)
    file="$WORK/data/reminders/$slug.md"
    print_verbose "Creating reminder: $file"

    {
        echo "---"
        echo "created: $date_str"
        echo "status: active"
        echo "source: manual"
        [ -n "$item" ] && echo "related-item: [[$item]]"
        echo "---"
        echo
        echo "# $desc"
    } > "$file"

    print_success "Created → ${file/#$HOME/\~}"
}

wr_list() {
    local scope=active a
    while [ $# -gt 0 ]; do
        a=$1
        case "$a" in
            --archived) scope=archived ;;
            --all)      scope=all ;;
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)  print_error "Unexpected argument: $a"; return 1 ;;
        esac
        shift
    done

    local root="$WORK/data/reminders"
    local show_status=false
    [ "$scope" != active ] && show_status=true

    local dirs=()
    case "$scope" in
        active)   dirs=("$root") ;;
        archived) dirs=("$root/archived") ;;
        all)      dirs=("$root" "$root/archived") ;;
    esac

    # Gather rows as tab-separated fields and sort by created date ascending
    # (oldest first) -- filenames no longer carry the date (it's frontmatter
    # only), so chronological order can't just fall out of an alphabetical
    # glob anymore.
    local rows='' dir f name status due desc created
    for dir in "${dirs[@]}"; do
        [ -d "$dir" ] || continue
        for f in "$dir"/*.md; do
            [ -f "$f" ] || continue
            name=$(basename "$f" .md)
            status=$(sed -n 's/^status: *//p' "$f" | head -1)
            [ "$scope" = active ] && [ "$status" != active ] && continue
            created=$(sed -n 's/^created: *//p' "$f" | head -1)
            due=$(sed -n 's/^due: *//p' "$f" | head -1)
            desc=$(sed -n 's/^# *//p' "$f" | head -1)
            rows="${rows}${created:-9999-99-99}"$'\t'"${due:--}"$'\t'"$status"$'\t'"$desc"$'\t'"$name"$'\n'
        done
    done

    if [ -z "$rows" ]; then
        echo "(none)"
        return 0
    fi

    if [ "$show_status" = true ]; then
        printf '%-11s %-9s %-44s %s\n' DUE STATUS DESC NAME
    else
        printf '%-11s %-44s %s\n' DUE DESC NAME
    fi

    while IFS=$'\t' read -r created due status desc name; do
        [ -n "$created" ] || continue
        if [ "$show_status" = true ]; then
            printf '%-11s %-9s %-44s %s\n' "$due" "$status" "$(trunc "$desc" 44)" "$name"
        else
            printf '%-11s %-44s %s\n' "$due" "$(trunc "$desc" 44)" "$name"
        fi
    done < <(printf '%s' "$rows" | sort -t $'\t' -k1,1)
}

wr_show() {
    local name='' a
    for a in "$@"; do
        case "$a" in
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)
                if [ -z "$name" ]; then name=$a
                else print_error "Too many arguments."; return 1
                fi ;;
        esac
    done
    if [ -z "$name" ]; then
        print_error "Usage: workreminder show <name>"; return 1
    fi

    local src
    src="$(resolve_reminder "$name")" || {
        print_error "No reminder '$name' found."; return 1
    }

    if [ -n "${PAGER:-}" ]; then
        # Intentionally unquoted: $PAGER commonly carries flags (e.g. "less -R"),
        # and quoting it would treat the whole string as one command name.
        $PAGER "$src"
    else
        cat "$src"
    fi
}

wr_archive() {
    local name='' newstatus='' a
    while [ $# -gt 0 ]; do
        a=$1
        case "$a" in
            --addressed) newstatus=addressed ;;
            --dismissed) newstatus=dismissed ;;
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)
                if [ -z "$name" ]; then name=$a
                else print_error "Too many arguments."; return 1
                fi ;;
        esac
        shift
    done
    if [ -z "$name" ]; then
        print_error "Usage: workreminder archive <name> [--addressed|--dismissed]"; return 1
    fi

    local root="$WORK/data/reminders"
    if [ -f "$root/archived/$name.md" ]; then
        print_error "'$name' is already archived."; return 1
    fi
    local src="$root/$name.md"
    if [ ! -f "$src" ]; then
        print_error "No reminder '$name' found."; return 1
    fi

    if [ -z "$newstatus" ]; then
        read -r -p "addressed or dismissed? [a/d] " reply
        case "$(printf '%s' "$reply" | tr '[:upper:]' '[:lower:]')" in
            a*) newstatus=addressed ;;
            d*) newstatus=dismissed ;;
            *) print_error "Cancelled — nothing changed."; return 1 ;;
        esac
    fi

    local tmp; tmp=$(mktemp)
    sed "s/^status:.*/status: $newstatus/" "$src" > "$tmp"
    mv "$tmp" "$src"
    print_debug "Frontmatter updated: status=$newstatus"
    # Stage the edit now, at its current path, before the `git mv` below --
    # otherwise `git mv` can stage the rename using the index's stale
    # (pre-edit) blob instead of this file's current content, silently
    # dropping the frontmatter edit from the eventual commit.
    if git -C "$WORK/data" rev-parse --git-dir >/dev/null 2>&1; then
        git -C "$WORK/data" add "$src" 2>/dev/null || true
    fi

    mkdir -p "$root/archived"
    local dest="$root/archived/$name.md"
    if [ -e "$dest" ]; then
        print_error "Target already exists: reminders/archived/$name.md"; return 1
    fi
    if git -C "$WORK/data" rev-parse --git-dir >/dev/null 2>&1 \
       && [ -n "$(git -C "$WORK/data" ls-files "reminders/$name.md")" ]; then
        git -C "$WORK/data" mv "reminders/$name.md" "reminders/archived/$name.md" || {
            print_error "Move to reminders/archived/$name.md failed — reminder left in place."
            return 1
        }
    else
        mv "$src" "$dest" || {
            print_error "Move to reminders/archived/$name.md failed — reminder left in place."
            return 1
        }
    fi

    print_success "Archived → reminders/archived/$name.md ($newstatus)"
}

wr_delete() {
    local name='' a
    for a in "$@"; do
        case "$a" in
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)
                if [ -z "$name" ]; then name=$a
                else print_error "Too many arguments."; return 1
                fi ;;
        esac
    done
    if [ -z "$name" ]; then
        print_error "Usage: workreminder delete <name>"; return 1
    fi

    local src
    src="$(resolve_reminder "$name")" || {
        print_error "No reminder '$name' found."; return 1
    }

    print_warning "About to permanently delete: ${src/#$HOME/\~}"
    read -r -p "This cannot be undone. Delete? [y/N] " yn
    if ! printf '%s' "$yn" | grep -qiE '^y'; then
        print_status "Cancelled — nothing deleted."; return 0
    fi

    rm -f "$src"
    print_success "Deleted ${src/#$HOME/\~}"
}

wr_due() {
    local name='' newdate='' a
    while [ $# -gt 0 ]; do
        a=$1
        case "$a" in
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)
                if [ -z "$name" ]; then name=$a
                elif [ -z "$newdate" ]; then newdate=$a
                else print_error "Too many arguments."; return 1
                fi ;;
        esac
        shift
    done
    if [ -z "$name" ]; then
        print_error "Usage: workreminder due <name> [date]"; return 1
    fi

    local src
    src="$(resolve_reminder "$name")" || {
        print_error "No reminder '$name' found."; return 1
    }

    if [ -n "$newdate" ] && ! [[ "$newdate" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
        print_error "Date must be YYYY-MM-DD."; return 1
    fi

    local tmp; tmp=$(mktemp)
    if grep -q '^due:' "$src"; then
        if [ -n "$newdate" ]; then
            sed "s/^due:.*/due: $newdate/" "$src" > "$tmp"
        else
            sed '/^due:/d' "$src" > "$tmp"
        fi
    elif [ -n "$newdate" ]; then
        awk -v d="$newdate" '/^status:/ { print; print "due: " d; next } { print }' "$src" > "$tmp"
    else
        cp "$src" "$tmp"
    fi
    mv "$tmp" "$src"

    if [ -n "$newdate" ]; then
        print_success "Set due: $newdate on ${src/#$HOME/\~}"
    else
        print_success "Cleared due date on ${src/#$HOME/\~}"
    fi
}

###
### Dispatch
###
# Parse global options before the subcommand so `workreminder -v list` works.
# -d implies -v.
while [ $# -gt 0 ]; do
    case "$1" in
        -v|--verbose) VERBOSE=true; shift ;;
        -d|--debug)   DEBUG=true; VERBOSE=true; shift ;;
        -h|--help|help) printf '%s\n' "$usage"; exit 0 ;;
        *) break ;;
    esac
done

cmd="${1:-}"
[ "$#" -gt 0 ] && shift
case "$cmd" in
    create)  wr_create "$@" ;;
    list)    wr_list "$@" ;;
    show)    wr_show "$@" ;;
    archive) wr_archive "$@" ;;
    delete)  wr_delete "$@" ;;
    due)     wr_due "$@" ;;
    '')      printf '%s\n' "$usage" ;;
    *)       print_error "Unknown command '$cmd' (try: workreminder help)"; exit 1 ;;
esac
