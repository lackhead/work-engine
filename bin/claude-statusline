#!/usr/bin/env bash
#
# claude-statusline — minimal Claude Code statusline for the work system.
#
# Engine tool for the work system. Lives at ~/work/engine/bin/claude-statusline
# (the work-engine repo); runs once per render with the statusline JSON on stdin.
# Shows just two Claude-pane-relevant things:
#
#   <slug>·<repo>   ctx <used>/<window> <pct>%
#
#   - the active work item, derived from the cwd the same way workon lands you
#     there (worktrees/<slug>/<repo>/ or items/<slug>/); falls back to an
#     abbreviated path when you're not inside a work item.
#   - live context-window usage, read from the transcript's latest token-usage
#     record (post-compact aware). Coloured amber past 70%, red past 90%.
#
# Wire it up in ~/.claude/settings.json:
#   "statusLine": { "type": "command", "command": "bash ~/work/engine/bin/claude-statusline" }
#
# Context-window size is mapped from the model id, overridable with
# CLAUDE_CONTEXT_WINDOW=<tokens> if a session runs on a different tier.

set -u

WORK="${WORK_ROOT:-$HOME/work}"

input=$(cat)

# One jq pass for everything we need off the statusline JSON, joined on '|'.
# A non-whitespace delimiter is deliberate: it preserves empty fields, so a
# missing key (e.g. no model.id) doesn't collapse and shift the remaining
# values the way a tab (IFS whitespace) would. '|' can't appear in a path,
# cwd, or model id. Keeps per-render cost to a single jq spawn.
IFS='|' read -r cwd transcript model_id big <<EOF
$(printf '%s' "$input" | jq -r '
    [ (.workspace.current_dir // .cwd // "")
    , (.transcript_path // "")
    , (.model.id // "")
    , (.exceeds_200k_tokens // false | tostring)
    ] | join("|")' 2>/dev/null)
EOF

# --- which work item is this? (cwd encodes it; mirrors workon's resolution) ---
label=""
case "$cwd" in
    "$WORK"/worktrees/*)
        rest=${cwd#"$WORK"/worktrees/}      # <slug>/<repo>/... or <slug>
        slug=${rest%%/*}
        repo=""
        case "$rest" in
            */*) tail=${rest#*/}; repo=${tail%%/*} ;;
        esac
        [ -n "$slug" ] && label="$slug${repo:+·$repo}"
        ;;
    "$WORK"/data/items/*)
        rest=${cwd#"$WORK"/data/items/}
        case "$rest" in
            backlog/*|archived/*)
                zone=${rest%%/*}; rest=${rest#*/}; label="${rest%%/*} ($zone)" ;;
            *)  label="${rest%%/*}" ;;
        esac
        ;;
esac
[ -z "$label" ] && label="~${cwd#"$HOME"}"   # not a work item: abbreviated cwd

# --- context usage: sum the transcript's most recent usage record ---
ctx=0
if [ -n "$transcript" ] && [ -f "$transcript" ]; then
    # Last usage record wins (post-compact aware). grep|tail, not `tail -r`:
    # tail -r is BSD-only and this runs inside the Debian sandbox container.
    line=$(grep '"input_tokens"' "$transcript" 2>/dev/null | tail -n1)
    if [ -n "$line" ]; then
        n=$(printf '%s' "$line" | jq '
            (.message.usage.input_tokens              // 0)
          + (.message.usage.cache_read_input_tokens   // 0)
          + (.message.usage.cache_creation_input_tokens // 0)' 2>/dev/null)
        case "$n" in (''|*[!0-9]*) n=0 ;; esac
        ctx=$n
    fi
fi

# --- context window: model map, env override, lift if clearly large ---
win="${CLAUDE_CONTEXT_WINDOW:-}"
if [ -z "$win" ]; then
    case "$model_id" in
        *opus-4-8*) win=1000000 ;;
        *)          win=200000 ;;
    esac
fi
[ "$big" = "true" ] && [ "$win" -lt 1000000 ] && win=1000000
[ "$ctx" -gt "$win" ] && win=1000000
pct=$(( ctx * 100 / win ))

human() {   # 72002 -> 72k ; 451402 -> 451k ; 1500000 -> 1.5M
    local n=$1
    if   [ "$n" -ge 1000000 ]; then printf '%d.%dM' $((n / 1000000)) $(((n % 1000000) / 100000))
    elif [ "$n" -ge 1000 ];    then printf '%dk' $((n / 1000))
    else printf '%d' "$n"; fi
}
case "$win" in
    1000000) winh="1M" ;;
    200000)  winh="200k" ;;
    *)       winh=$(human "$win") ;;
esac

if   [ "$pct" -ge 90 ]; then c='\033[31m'    # red
elif [ "$pct" -ge 70 ]; then c='\033[33m'    # amber
else                         c='\033[2m'; fi # dim
r='\033[0m'; b='\033[1m'

printf '%b%s%b   %bctx %s/%s %d%%%b' "$b" "$label" "$r" "$c" "$(human "$ctx")" "$winh" "$pct" "$r"
