#!/usr/bin/env bash
#
# sandbox — lifecycle for the isolated Claude workspace container.
#
# Engine tool for the work system. Lives at ~/work/engine/bin/sandbox (the
# work-engine repo); ~/work/engine/bin is on PATH. Builds and runs the single
# persistent Docker container that Claude Code sessions run inside (every
# session `docker exec`s in via workon). Design + decisions:
# ~/work/data/items/archived/isolated-claude-workspace/.
#

set -u

IMAGE=work-sandbox:latest
BASE_IMAGE=work-sandbox-base:latest
CONTAINER=work-sandbox
VOLUME=claude-home
CACHE_VOLUME=claude-cache
WORK="${WORK_ROOT:-$HOME/work}"
RECIPE="$WORK/engine/sandbox"
# Optional gitignored host file holding CLAUDE_CODE_OAUTH_TOKEN (a long-lived
# token from `claude setup-token` on the host), injected into the container so
# sessions authenticate without an in-container browser login. Kept OUT of ~/work
# and the image; only this path is referenced, never the token itself.
SANDBOX_ENV="${SANDBOX_ENV:-$HOME/.config/claude-sandbox.env}"
# Optional per-instance Dockerfile, layered on top of the engine's base image
# (e.g. a work instance's Ansible/pre-commit toolchain that a personal
# instance doesn't want). Lives in data/ since it's instance-specific, not
# engine content — adding a package here never touches the engine. Absent by
# default: no file means the base image ships as-is.
LOCAL_DOCKERFILE="${LOCAL_DOCKERFILE:-$WORK/data/sandbox/Dockerfile.local}"

###
### Output functions
###
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NORMAL='\033[0m'
VERBOSE=false
DEBUG=false

print_status()  { echo -e "${BLUE}[INFO]${NORMAL} $1"; }
print_success() { echo -e "${GREEN}[SUCCESS]${NORMAL} $1"; }
print_warning() { echo -e "${YELLOW}[WARNING]${NORMAL} $1" >&2; }
print_error()   { echo -e "${RED}[ERROR]${NORMAL} $1" >&2; }
print_verbose() { [ "$VERBOSE" = true ] && echo -e "${BLUE}[VERBOSE]${NORMAL} $1" >&2 || true; }
print_debug()   { [ "$DEBUG" = true ] && echo -e "${BLUE}[DEBUG]${NORMAL} $1" >&2 || true; }

IFS='' read -r -d '' usage <<"EOF"

sandbox: lifecycle for the isolated Claude workspace container

Usage:
   sandbox [ -h|--help ]
   sandbox [ -v|--verbose ] [ -d|--debug ] <command>

Commands:
   build      Build the image from ~/work/engine/sandbox/
   up         Create or start the persistent container (builds if needed)
   down       Stop the container (keeps it and the named volumes)
   restart    Stop then start the container (no rebuild) — down + up
   status     Show image / container / volume state
   shell      Open an interactive fish shell inside the container
   rebuild    Rebuild the image (--no-cache) and recreate the container

Options:
   -h|--help     Show what you are seeing right now
   -v|--verbose  Show what is happening as it happens
   -d|--debug    Show diagnostic detail (implies --verbose)

Description:
   Manages the single persistent Docker container that Claude Code sessions
   run inside. workon exec's into the container; sandbox manages its lifecycle.
   The container bind-mounts the ~/work tree at the same absolute path and keeps login
   + transcripts on the claude-home named volume; regenerable caches (e.g.
   pre-commit hook environments under ~/.cache) persist on the claude-cache
   volume, so nothing is lost — and no hook re-downloads — when the container
   is recreated. The image itself bakes no secrets.

   A gitignored env-file at ~/.config/claude-sandbox.env (if present) is
   injected at container creation via --env-file, making CLAUDE_CODE_OAUTH_TOKEN
   available inside for passwordless auth. The SSH keys sandbox_github and
   sandbox_deploy are bind-mounted read-only if present under ~/.ssh/.

   data/sandbox/Dockerfile.local (if present) layers instance-specific
   tooling on top of the engine's base image — e.g. a work instance's
   Ansible/pre-commit toolchain that a personal instance doesn't want.
   Adding a package here never touches the engine's Dockerfile. It must
   start with `ARG BASE_IMAGE` / `FROM ${BASE_IMAGE}` and end back at
   `USER root` (see the file's own template comments). No file means the
   base image ships as-is.

Examples:
   sandbox up            # start or create the container
   sandbox restart       # stop + start, no rebuild (e.g. a hung container)
   sandbox status        # check image / container / volume state
   sandbox rebuild       # rebuild after a Dockerfile change
   sandbox shell         # drop into a fish shell inside the box

EOF

###
### Helpers
###
need_docker() {
    command -v docker >/dev/null 2>&1 || { print_error "docker not found on PATH."; exit 1; }
    docker info >/dev/null 2>&1 || { print_error "Can't reach the Docker daemon — is Docker Desktop running?"; exit 1; }
}

container_exists()  { docker ps -a --format '{{.Names}}' | grep -qx "$CONTAINER"; }
container_running() { docker ps    --format '{{.Names}}' | grep -qx "$CONTAINER"; }

###
### Commands
###
build() {
    need_docker
    [ -f "$RECIPE/Dockerfile" ] || { print_error "No Dockerfile at $RECIPE."; exit 1; }

    print_status "Building base image ($BASE_IMAGE) from $RECIPE ..."
    docker build "$@" -t "$BASE_IMAGE" "$RECIPE" \
        || { print_error "Base image build failed."; return 1; }

    if [ -f "$LOCAL_DOCKERFILE" ]; then
        print_verbose "Layering instance overlay: $LOCAL_DOCKERFILE"
        docker build "$@" --build-arg "BASE_IMAGE=$BASE_IMAGE" \
            -f "$LOCAL_DOCKERFILE" -t "$IMAGE" "$(dirname "$LOCAL_DOCKERFILE")" \
            || { print_error "Instance overlay build failed."; return 1; }
    else
        print_verbose "No overlay at $LOCAL_DOCKERFILE — $IMAGE is the base image"
        docker tag "$BASE_IMAGE" "$IMAGE"
    fi
}

run_container() {
    # Dedicated sandbox SSH keys, mounted read-only at the same path so the
    # baked ~/.ssh/config finds them. Conditional: the box runs fine before the
    # keys exist, and picks them up on the next `up`/`rebuild` once generated.
    local ssh_mounts=() k
    for k in sandbox_github sandbox_deploy; do
        if [ -f "$HOME/.ssh/$k" ]; then
            ssh_mounts+=( -v "$HOME/.ssh/$k:$HOME/.ssh/$k:ro" )
            print_verbose "Mounting SSH key: $HOME/.ssh/$k"
        fi
    done

    # Long-lived auth token injection (see SANDBOX_ENV at the top of this file).
    local env_args=()
    if [ -f "$SANDBOX_ENV" ]; then
        env_args+=( --env-file "$SANDBOX_ENV" )
        print_verbose "Injecting env-file: $SANDBOX_ENV"
    else
        print_verbose "No env-file at $SANDBOX_ENV — no oauth token injection"
    fi

    print_verbose "Creating container: name=$CONTAINER hostname=sandbox image=$IMAGE"
    print_debug   "Mounts: work=$WORK claude-home=$HOME/.claude cache=$HOME/.cache ssh=${ssh_mounts[*]:-none}"

    # Same absolute path inside and out is the whole point — don't change the
    # mount target. --hostname makes shell prompts read `clake@sandbox`.
    # claude-cache persists ~/.cache (pre-commit hook envs, etc.) across recreates.
    docker run -d \
        --name "$CONTAINER" \
        --hostname sandbox \
        --restart unless-stopped \
        -v "$WORK:$WORK" \
        -v "$VOLUME:$HOME/.claude" \
        -v "$CACHE_VOLUME:$HOME/.cache" \
        ${ssh_mounts[@]+"${ssh_mounts[@]}"} \
        ${env_args[@]+"${env_args[@]}"} \
        "$IMAGE" >/dev/null
}

up() {
    need_docker
    if container_running; then
        print_status "Container already up ($CONTAINER)."
        return 0
    fi
    if container_exists; then
        print_status "Starting existing container ..."
        docker start "$CONTAINER" >/dev/null || { print_error "Failed to start $CONTAINER."; exit 1; }
    else
        docker image inspect "$IMAGE" >/dev/null 2>&1 || build
        print_status "Creating container ..."
        run_container || { print_error "Failed to create $CONTAINER."; exit 1; }
    fi
    print_success "Container up ($CONTAINER)."
}

down() {
    need_docker
    if container_running; then
        docker stop "$CONTAINER" >/dev/null
    fi
    print_status "Container down."
}

restart() {
    need_docker
    down
    up
}

status() {
    need_docker
    if docker image inspect "$BASE_IMAGE" >/dev/null 2>&1; then
        print_status "Base image: $BASE_IMAGE (built)"
    else
        print_warning "Base image: $BASE_IMAGE (not built — run 'sandbox build')"
    fi
    if [ -f "$LOCAL_DOCKERFILE" ]; then
        print_status "Overlay:    $LOCAL_DOCKERFILE (present)"
    else
        print_verbose "Overlay:    none at $LOCAL_DOCKERFILE"
    fi
    if docker image inspect "$IMAGE" >/dev/null 2>&1; then
        print_status "Image:     $IMAGE (built)"
    else
        print_warning "Image:     $IMAGE (not built — run 'sandbox build')"
    fi
    if container_exists; then
        local cstatus
        cstatus=$(docker ps -a --filter "name=^${CONTAINER}\$" --format '{{.Status}}')
        print_status "Container: $CONTAINER — $cstatus"
    else
        print_warning "Container: not created — run 'sandbox up'"
    fi
    if docker volume inspect "$VOLUME" >/dev/null 2>&1; then
        print_status "Volume:    $VOLUME (present — login + transcripts)"
    else
        print_warning "Volume:    $VOLUME (none yet — created on first 'up')"
    fi
    if docker volume inspect "$CACHE_VOLUME" >/dev/null 2>&1; then
        print_status "Volume:    $CACHE_VOLUME (present — ~/.cache, e.g. pre-commit hook envs)"
    else
        print_warning "Volume:    $CACHE_VOLUME (none yet — created on first 'up')"
    fi
}

shell() {
    need_docker
    container_running || up
    exec docker exec -it --user clake -w "$HOME" -e TERM "$CONTAINER" fish
}

rebuild() {
    need_docker
    build --no-cache "$@"
    if container_exists; then
        print_status "Recreating container on the new image ..."
        docker rm -f "$CONTAINER" >/dev/null
        run_container || { print_error "Failed to recreate $CONTAINER."; exit 1; }
        print_success "Container recreated ($CONTAINER)."
    fi
}

###
### Dispatch
###
# Parse global options before the subcommand so `sandbox -v up` works.
# -d implies -v.
while [ $# -gt 0 ]; do
    case "$1" in
        -v|--verbose) VERBOSE=true; shift ;;
        -d|--debug)   DEBUG=true; VERBOSE=true; shift ;;
        -h|--help|help) printf '%s\n' "$usage"; exit 0 ;;
        *) break ;;
    esac
done

cmd="${1:-}"
[ "$#" -gt 0 ] && shift
case "$cmd" in
    build)   build "$@" ;;
    up)      up ;;
    down)    down ;;
    restart) restart ;;
    status)  status ;;
    shell)   shell ;;
    rebuild) rebuild "$@" ;;
    '')      printf '%s\n' "$usage" ;;
    *)       print_error "Unknown command '$cmd' (try: sandbox help)"; exit 1 ;;
esac
