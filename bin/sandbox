#!/usr/bin/env bash
#
# sandbox — lifecycle for the isolated Claude workspace container.
#
# Engine tool for the work system. Lives at ~/work/engine/bin/sandbox (the
# work-engine repo); ~/work/engine/bin is on PATH. Builds and runs the single
# persistent Docker container that Claude Code sessions run inside (every
# session `docker exec`s in via workon). Design + decisions:
# ~/work/data/items/archived/isolated-claude-workspace/.
#
#   sandbox build     build the image from ~/work/engine/sandbox/
#   sandbox up        create-or-start the persistent container (builds if needed)
#   sandbox down      stop the container (keeps it and the ~/.claude volume)
#   sandbox status    show image / container / volume state
#   sandbox shell     open an interactive fish shell inside the container
#   sandbox rebuild   rebuild the image (--no-cache) and recreate the container
#
# The container bind-mounts ~/work at the same absolute path and keeps login +
# transcripts on the `claude-home` named volume (survives recreate/rebuild). The
# image bakes no secrets, so tearing the container down and recreating loses no work.

set -u

IMAGE=work-sandbox:latest
CONTAINER=work-sandbox
VOLUME=claude-home
WORK="${WORK_ROOT:-$HOME/work}"
RECIPE="$WORK/engine/sandbox"

die() { echo "sandbox: $*" >&2; exit 1; }

need_docker() {
    command -v docker >/dev/null 2>&1 || die "docker not found on PATH."
    docker info >/dev/null 2>&1 || die "can't reach the Docker daemon — is Docker Desktop running?"
}

container_exists()  { docker ps -a --format '{{.Names}}' | grep -qx "$CONTAINER"; }
container_running() { docker ps    --format '{{.Names}}' | grep -qx "$CONTAINER"; }

build() {
    need_docker
    [ -f "$RECIPE/Dockerfile" ] || die "no Dockerfile at $RECIPE."
    echo "sandbox: building $IMAGE from $RECIPE ..."
    docker build "$@" -t "$IMAGE" "$RECIPE"
}

run_container() {
    # Dedicated sandbox SSH keys, mounted read-only at the same path so the
    # baked ~/.ssh/config finds them. Conditional: the box runs fine before the
    # keys exist (Phase 2 setup), and picks them up on the next `up`/`rebuild`
    # once they're generated. The keys are never baked into the image.
    local ssh_mounts=() k
    for k in sandbox_github sandbox_deploy; do
        [ -f "$HOME/.ssh/$k" ] && ssh_mounts+=( -v "$HOME/.ssh/$k:$HOME/.ssh/$k:ro" )
    done

    # Same absolute path inside and out is the whole point — don't change the
    # mount target. Login + transcripts persist on the named volume.
    docker run -d \
        --name "$CONTAINER" \
        --restart unless-stopped \
        -v "$WORK:$WORK" \
        -v "$VOLUME:$HOME/.claude" \
        ${ssh_mounts[@]+"${ssh_mounts[@]}"} \
        "$IMAGE" >/dev/null
}

up() {
    need_docker
    if container_running; then echo "sandbox: already up."; return 0; fi
    if container_exists; then
        echo "sandbox: starting existing container ..."
        docker start "$CONTAINER" >/dev/null || die "failed to start $CONTAINER."
    else
        docker image inspect "$IMAGE" >/dev/null 2>&1 || build
        echo "sandbox: creating container ..."
        run_container || die "failed to create $CONTAINER."
    fi
    echo "sandbox: up ($CONTAINER)."
}

down() {
    need_docker
    if container_running; then docker stop "$CONTAINER" >/dev/null; fi
    echo "sandbox: down."
}

status() {
    need_docker
    if docker image inspect "$IMAGE" >/dev/null 2>&1; then
        echo "image:     $IMAGE (built)"
    else
        echo "image:     $IMAGE (not built — run 'sandbox build')"
    fi
    if container_exists; then
        docker ps -a --filter "name=^${CONTAINER}\$" --format 'container: {{.Names}} — {{.Status}}'
    else
        echo "container: not created — run 'sandbox up'"
    fi
    if docker volume inspect "$VOLUME" >/dev/null 2>&1; then
        echo "volume:    $VOLUME (present — login + transcripts)"
    else
        echo "volume:    $VOLUME (none yet — created on first 'up')"
    fi
}

shell() {
    need_docker
    container_running || up
    exec docker exec -it --user clake -w "$HOME" -e TERM "$CONTAINER" fish
}

rebuild() {
    need_docker
    build --no-cache "$@"
    if container_exists; then
        echo "sandbox: recreating container on the new image ..."
        docker rm -f "$CONTAINER" >/dev/null
        run_container || die "failed to recreate $CONTAINER."
        echo "sandbox: recreated."
    fi
}

cmd="${1:-}"
[ "$#" -gt 0 ] && shift
case "$cmd" in
    build)   build "$@" ;;
    up)      up ;;
    down)    down ;;
    status)  status ;;
    shell)   shell ;;
    rebuild) rebuild "$@" ;;
    ''|-h|--help|help)
        cat <<'EOF'
usage: sandbox <command>
  build      build the image from ~/work/engine/sandbox/
  up         create-or-start the persistent container (builds if needed)
  down       stop the container (keeps it and the ~/.claude volume)
  status     show image / container / volume state
  shell      open an interactive fish shell inside the container
  rebuild    rebuild the image (--no-cache) and recreate the container
EOF
        ;;
    *) die "unknown command '$cmd' (try: sandbox help)" ;;
esac
