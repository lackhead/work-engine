#!/usr/bin/env bash
#
# worktree — manage per-work-item git worktrees under ~/work.
#
# Engine tool for the work system. Lives at ~/work/engine/bin/worktree (the
# work-engine repo); ~/work/engine/bin is on PATH, so it runs from any shell
# and inside the sandbox container. Companion completions:
# ~/work/engine/bin/completions/worktree.fish.
#
# Layout:  ~/work/repos/<repo>/              canonical clones (integration branch)
#          ~/work/worktrees/<slug>/<repo>/   per-item checkouts
#

set -u

# Shared boilerplate: WORK root, print_* output functions, trim/kebab/trunc/
# iso_now. Resolves to lib.sh in this script's own bin/ dir. See
# docs/bin-coding-standards.md.
# shellcheck source=lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

IFS='' read -r -d '' usage <<"EOF"

worktree: manage per-work-item git worktrees under ~/work

Usage:
   worktree [ -h|--help ]
   worktree [ -v|--verbose ] [ -d|--debug ] add            <slug> <repo> [branch] [--base <ref>]
   worktree [ -v|--verbose ] [ -d|--debug ] rm             <slug> [repo] [--delete-branch]
   worktree [ -v|--verbose ] [ -d|--debug ] mv             <old-slug> <new-slug>
   worktree [ -v|--verbose ] [ -d|--debug ] list           [slug]
   worktree [ -v|--verbose ] [ -d|--debug ] refresh        [repo] [--if-stale]
   worktree [ -v|--verbose ] [ -d|--debug ] prune-branches [repo] [--apply]

Arguments:
   -h|--help         Show what you are seeing right now
   -v|--verbose      Show what is happening as it happens
   -d|--debug        Show diagnostic detail (implies --verbose)

   <slug>            Work item basename (must be an active top-level item)
   <repo>            Canonical clone under ~/work/repos/
   [branch]          Branch name (defaults to <slug>); an existing local or
                     remote-tracking branch is checked out, else a new
                     branch is created off --base
   --base <ref>      Base ref for a new branch (default: clone HEAD)
   --delete-branch   (rm) Also delete the branch, but only if it's merged
                     into the clone's current branch; left in place otherwise
   <old-slug>        (mv) Existing worktree slug to relocate
   <new-slug>        (mv) Slug to relocate it to
   --if-stale        (refresh) Skip clones fetched within the last 24h
   --apply           (prune-branches) Delete the branches found safe to
                     delete; without it, only lists what would happen

Description:
   Manages git worktrees under ~/work/worktrees/<slug>/<repo>/, each
   checked out to its own branch off the canonical clone in ~/work/repos/.
   Worktrees are created when an item goes active and removed when it
   finishes; rm leaves the branch and history intact unless --delete-branch
   is given.

   mv relocates every worktree under worktrees/<old-slug>/ to
   worktrees/<new-slug>/ via `git worktree move` (branch and history
   untouched). If a repo's checked-out branch is named after <old-slug> --
   the `add` default -- it's renamed to <new-slug> too; an explicitly-named
   branch is left as-is. Used by `workitem rename` to keep an item's
   worktree(s) attached under its new name.

   list shows, per worktree:
     STATE     dirty = uncommitted changes present, clean = none.
     AHEAD     commits on this branch the canonical clone's current branch
               doesn't have -- an integration signal (not yet merged
               locally), not a safety one.
     UNPUSHED  commits on this branch that origin doesn't have under the
               same name -- the actual "could this be lost" signal.
               'no-remote' means the branch has never been pushed at all.
   All three can be '-'/none and the worktree still be worth keeping around;
   what to actually worry about is dirty and/or a nonzero UNPUSHED --
   that's local-only content. AHEAD and UNPUSHED both reflect this repo's
   state as of its last `git fetch` (see `worktree refresh`) -- refresh
   first if a number looks stale.

   refresh fast-forwards each canonical clone's integration branch from
   upstream (--ff-only, so it never rewrites). Used by workon on launch
   to keep drift counts honest.

   prune-branches finds local branches with no live worktree and sorts
   them into SAFE (an ancestor of the clone's current branch, or of a
   branch some other live worktree has checked out, or every commit on
   it already applied to the integration branch some other way — e.g.
   cherry-picked) and REVIEW (everything else). Without --apply it only
   prints the split; with --apply it deletes the SAFE set and leaves
   REVIEW alone.

Examples:
   worktree add nagios Ansible feature/nagios-pushover
   worktree add my-item Internal                       # branch defaults to my-item
   worktree list
   worktree list nagios
   worktree rm nagios
   worktree rm nagios --delete-branch
   worktree mv nagios-pushover nagios-alerting
   worktree refresh
   worktree refresh Ansible --if-stale
   worktree prune-branches Ansible
   worktree prune-branches Ansible --apply

EOF

###
### Helpers
###

# Echo "<remote>/<branch>" iff exactly one remote has the branch, else nothing.
remote_ref() {
    local repo_dir=$1 branch=$2 matches
    matches=$(git -C "$repo_dir" for-each-ref --format='%(refname:short)' "refs/remotes/*/$branch" 2>/dev/null)
    [ -n "$matches" ] || return 0
    [ "$(printf '%s\n' "$matches" | grep -c .)" -eq 1 ] && printf '%s\n' "$matches"
}

# Install/refresh the work-item commit-msg trailer hook (bin/hooks/commit-msg)
# into a canonical clone's .git/hooks/ — shared by every worktree of that
# repo, since git hooks aren't per-worktree, so one install covers them all.
# Called from both `add` (new clone) and `refresh` (backfills clones that
# predate this hook, or picks up template updates) — cheap and idempotent
# either way. Never overwrites a commit-msg hook that isn't already ours;
# see bin/hooks/commit-msg's header for the marker this checks.
install_commit_hook() {
    local repo_dir=$1 repo=$2
    local hook_src hook_dest marker
    hook_src="$(dirname "${BASH_SOURCE[0]}")/hooks/commit-msg"
    hook_dest="$repo_dir/.git/hooks/commit-msg"
    marker='work-engine: commit-msg work-item trailer hook'

    [ -f "$hook_src" ] || { print_warning "[$repo] Missing $hook_src — skipping work-item commit-msg hook install."; return; }
    if [ -f "$hook_dest" ] && ! grep -q "$marker" "$hook_dest" 2>/dev/null; then
        print_warning "[$repo] Existing commit-msg hook isn't engine-managed — leaving it in place; commits here won't get a Work-Item trailer automatically."
        return
    fi

    mkdir -p "$(dirname "$hook_dest")"
    if cp "$hook_src" "$hook_dest" && chmod +x "$hook_dest"; then
        print_verbose "[$repo] Installed work-item commit-msg hook"
    else
        print_warning "[$repo] Couldn't install commit-msg hook at $hook_dest"
    fi
}

###
### Subcommands
###
wt_add() {
    local base='' a
    local positional=()
    while [ $# -gt 0 ]; do
        a=$1
        case "$a" in
            --base)   shift; base=${1:-} ;;
            --base=*) base=${a#--base=} ;;
            -*)       print_error "Unknown option: $a"; return 1 ;;
            *)        positional+=("$a") ;;
        esac
        shift
    done

    local slug=${positional[0]:-} repo=${positional[1]:-} branch=${positional[2]:-}
    if [ -z "$slug" ] || [ -z "$repo" ]; then
        print_error "Usage: worktree add <slug> <repo> [branch] [--base <ref>]"; return 1
    fi
    [ -n "$branch" ] || branch=$slug

    local root; root=$WORK
    print_verbose "Adding worktree: slug=$slug repo=$repo branch=$branch"
    print_debug   "Work root: $root"

    # Worktrees are only set up for active (top-level) work items -- the
    # directory form only. A legacy single-file item (items/<slug>.md, no
    # directory) is refused here too, matching workon's own refusal, rather
    # than silently accepting a form the schema no longer produces.
    if [ -f "$root/data/items/$slug.md" ] && [ ! -f "$root/data/items/$slug/$slug.md" ]; then
        print_error "'$slug' is a legacy single-file item (items/$slug.md, no directory)."
        print_error "Migrate it by hand: create items/$slug/$slug.md and remove the old file."
        return 1
    fi
    if [ ! -f "$root/data/items/$slug/$slug.md" ]; then
        print_error "'$slug' is not an active work item under items/ — activate it first (it may be in backlog/ or archived/)."
        return 1
    fi

    local repo_dir=$root/repos/$repo
    if [ ! -d "$repo_dir" ]; then print_error "No canonical clone at repos/$repo"; return 1; fi
    if ! git -C "$repo_dir" rev-parse --git-dir >/dev/null 2>&1; then
        print_error "repos/$repo is not a git repo"; return 1
    fi

    install_commit_hook "$repo_dir" "$repo"

    # Keep the branch-off point honest before branching (--if-stale gate,
    # non-fatal when offline). Manual equivalent: `worktree refresh`.
    print_verbose "[$repo] Running worktree refresh --if-stale $repo"
    wt_refresh --if-stale "$repo" || true

    local dest=$root/worktrees/$slug/$repo
    if [ -e "$dest" ]; then print_error "Worktree path already exists: $dest"; return 1; fi
    mkdir -p "$root/worktrees/$slug"

    local ok=1 rref start
    if git -C "$repo_dir" show-ref --verify --quiet "refs/heads/$branch"; then
        print_status "Checking out existing local branch '$branch' of $repo"
        git -C "$repo_dir" worktree add "$dest" "$branch" || ok=0
    else
        rref=$(remote_ref "$repo_dir" "$branch")
        if [ -n "$rref" ]; then
            print_status "Creating local branch '$branch' tracking '$rref' of $repo"
            git -C "$repo_dir" worktree add -b "$branch" "$dest" "$rref" || ok=0
        else
            start=HEAD; [ -n "$base" ] && start=$base
            print_status "Creating new branch '$branch' off '$start' of $repo"
            git -C "$repo_dir" worktree add -b "$branch" "$dest" "$start" || ok=0
        fi
    fi

    if [ "$ok" -eq 0 ]; then rmdir "$root/worktrees/$slug" 2>/dev/null; return 1; fi
    rmdir "$root/worktrees/$slug" 2>/dev/null
    print_success "Worktree ready at worktrees/$slug/$repo"
}

wt_rm() {
    local delete_branch=0 a
    local positional=()
    while [ $# -gt 0 ]; do
        a=$1
        case "$a" in
            --delete-branch) delete_branch=1 ;;
            -*)              print_error "Unknown option: $a"; return 1 ;;
            *)               positional+=("$a") ;;
        esac
        shift
    done
    local slug=${positional[0]:-} repo=${positional[1]:-}
    if [ -z "$slug" ]; then print_error "Usage: worktree rm <slug> [repo] [--delete-branch]"; return 1; fi

    local root; root=$WORK
    local slug_dir=$root/worktrees/$slug
    if [ ! -d "$slug_dir" ]; then print_error "No worktrees for slug '$slug'"; return 1; fi

    local targets=() d r
    if [ -n "$repo" ]; then
        if [ ! -d "$slug_dir/$repo" ]; then print_error "No worktree at worktrees/$slug/$repo"; return 1; fi
        targets=("$repo")
    else
        for d in "$slug_dir"/*/; do [ -d "$d" ] && targets+=("$(basename "$d")"); done
    fi
    [ ${#targets[@]} -eq 0 ] && { print_error "No worktrees under slug '$slug'"; return 1; }

    # Branch names must be read before removal -- the worktree's .git is gone
    # once `git worktree remove` succeeds.
    local branches=()
    for r in "${targets[@]}"; do
        branches+=("$(git -C "$slug_dir/$r" rev-parse --abbrev-ref HEAD 2>/dev/null)")
    done

    for r in "${targets[@]}"; do
        print_status "Removing worktrees/$slug/$r"
        if ! git -C "$root/repos/$r" worktree remove "$slug_dir/$r"; then
            print_error "git refused to remove worktrees/$slug/$r (uncommitted changes or locked worktree — resolve, or 'git -C repos/$r worktree remove -f' manually)"
            return 1
        fi
    done

    # Finder can drop a .DS_Store into worktrees/<slug>/ if it's ever browsed,
    # which would make rmdir see a non-empty dir and silently leave it behind.
    rm -f "$slug_dir/.DS_Store" 2>/dev/null
    rmdir "$slug_dir" 2>/dev/null

    if [ "$delete_branch" -eq 1 ]; then
        local i=0 branch
        for r in "${targets[@]}"; do
            branch=${branches[$i]}
            i=$((i + 1))
            if [ -z "$branch" ] || [ "$branch" = HEAD ]; then
                print_warning "Couldn't determine branch for $r — left in place."
                continue
            fi
            # -d (not -D): only deletes if merged into repos/$r's current
            # (integration) branch. Refuses otherwise rather than losing work.
            if git -C "$root/repos/$r" branch -d "$branch" >/dev/null 2>&1; then
                print_success "Deleted branch '$branch' from $r (merged)"
            else
                print_warning "Branch '$branch' not merged into $r's integration branch — left in place (see 'worktree prune-branches $r')"
            fi
        done
        print_success "Done"
    else
        print_success "Done (branches and history left intact)"
    fi
}

# Relocate every worktree under worktrees/<old>/ to worktrees/<new>/ via
# `git worktree move` -- a raw `mv` would corrupt the administrative link
# git keeps between the main repo and the worktree, so this always goes
# through git. Called by `workitem rename` after it renames the item itself.
wt_mv() {
    local positional=() a
    for a in "$@"; do
        case "$a" in
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)  positional+=("$a") ;;
        esac
    done
    local old=${positional[0]:-} new=${positional[1]:-}
    if [ -z "$old" ] || [ -z "$new" ]; then
        print_error "Usage: worktree mv <old-slug> <new-slug>"; return 1
    fi

    local root; root=$WORK
    local old_dir=$root/worktrees/$old new_dir=$root/worktrees/$new
    if [ ! -d "$old_dir" ]; then print_error "No worktrees for slug '$old'"; return 1; fi
    if [ -e "$new_dir" ]; then print_error "Worktree path already exists: worktrees/$new"; return 1; fi
    mkdir -p "$new_dir"

    local r repo branch rc=0
    for r in "$old_dir"/*/; do
        [ -d "$r" ] || continue
        repo=$(basename "$r")
        print_status "Moving worktrees/$old/$repo -> worktrees/$new/$repo"
        if ! git -C "$root/repos/$repo" worktree move "$old_dir/$repo" "$new_dir/$repo"; then
            print_error "git worktree move failed for $repo — left at worktrees/$old/$repo."
            rc=1
            continue
        fi
        # `add`'s default names the branch after the slug -- rename it to
        # match so it doesn't read stale after the item's renamed. A
        # branch named explicitly at `add` time is left alone.
        branch=$(git -C "$new_dir/$repo" rev-parse --abbrev-ref HEAD 2>/dev/null)
        if [ "$branch" = "$old" ]; then
            if git -C "$new_dir/$repo" branch -m "$new"; then
                print_verbose "Renamed branch '$old' -> '$new' in $repo"
            else
                print_warning "Couldn't rename branch in $repo — left as '$old'."
            fi
        fi
    done

    rm -f "$old_dir/.DS_Store" 2>/dev/null
    rmdir "$old_dir" 2>/dev/null

    [ "$rc" -eq 0 ] || return 1
    print_success "Worktrees moved -> worktrees/$new"
}

wt_list() {
    local want=${1:-}
    local root; root=$WORK
    local wt=$root/worktrees

    printf '%-28s %-10s %-32s %-6s %-6s %s\n' SLUG REPO BRANCH STATE AHEAD UNPUSHED

    if [ ! -d "$wt" ]; then echo "(no worktrees yet)"; return 0; fi

    local found=0 slug_dir slug repo_dir repo branch st dirty clone intbr ahead unpushed
    for slug_dir in "$wt"/*/; do
        [ -d "$slug_dir" ] || continue
        slug=$(basename "$slug_dir")
        if [ -n "$want" ] && [ "$want" != "$slug" ]; then continue; fi
        for repo_dir in "$slug_dir"*/; do
            [ -d "$repo_dir" ] || continue
            repo=$(basename "$repo_dir")
            branch=$(git -C "$repo_dir" rev-parse --abbrev-ref HEAD 2>/dev/null); [ -n "$branch" ] || branch='?'
            st=$(git -C "$repo_dir" status --porcelain 2>/dev/null)
            if [ -n "$st" ]; then dirty=dirty; else dirty=clean; fi

            # Commits in this worktree's HEAD that the canonical clone's
            # current (integration) branch doesn't have — an integration
            # signal, not a safety one: it reflects the clone's local branch
            # as of its last refresh (`worktree refresh`/`workon`), which
            # can lag what's actually on origin. See UNPUSHED for that.
            clone="$root/repos/$repo"
            intbr=$(git -C "$clone" rev-parse --abbrev-ref HEAD 2>/dev/null)
            ahead='?'
            if [ -n "$intbr" ] && [ "$intbr" != HEAD ]; then
                ahead=$(git -C "$repo_dir" rev-list --count "$intbr..HEAD" 2>/dev/null)
                [ -n "$ahead" ] || ahead='?'
            fi
            [ "$ahead" = 0 ] && ahead='-'

            # Commits on this branch that origin doesn't have under the same
            # name -- the actual "could this be lost" signal, independent of
            # local main: a worktree can vanish (disk failure, accidental rm)
            # without losing anything only if every commit already exists
            # elsewhere. 'no-remote' means the branch has never been pushed
            # under this name at all -- nothing on it is backed up anywhere.
            # Reflects the last `git fetch` in this repo, same staleness
            # caveat as AHEAD -- `worktree refresh <repo>` first if unsure.
            unpushed='?'
            if [ "$branch" != '?' ] && [ "$branch" != HEAD ]; then
                if git -C "$repo_dir" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
                    unpushed=$(git -C "$repo_dir" rev-list --count "origin/$branch..HEAD" 2>/dev/null)
                    [ -n "$unpushed" ] || unpushed='?'
                    [ "$unpushed" = 0 ] && unpushed='-'
                else
                    unpushed='no-remote'
                fi
            fi

            printf '%-28s %-10s %-32s %-6s %-6s %s\n' \
                "$(trunc "$slug" 28)" "$(trunc "$repo" 10)" "$(trunc "$branch" 32)" "$dirty" "$ahead" "$unpushed"
            found=1
        done
    done

    if [ "$found" -eq 0 ]; then
        if [ -n "$want" ]; then echo "(no worktrees for '$want')"; else echo "(no worktrees)"; fi
    fi
}

# For each canonical clone (or one named repo), find local branches with no
# live worktree and classify them: SAFE if the branch is an ancestor of the
# clone's integration branch (shipped and merged) or of any branch currently
# checked out in a live worktree for that repo (mid-item rename -- the old
# name is fully subsumed by the new one); REVIEW otherwise. Dry-run unless
# --apply, which deletes (git branch -D -- safe here because ancestry was
# already verified via merge-base, not git's own weaker "merged into current
# HEAD" check) only the SAFE bucket; REVIEW branches are never touched.
#
# Ancestry alone misses a repo that pushes straight to its integration branch
# instead of merging feature branches (a deliberate workflow some team repos
# use, not a mistake) -- a cherry-picked or manually reapplied commit never
# becomes an ancestor of anything, no matter how thoroughly its content
# landed. So a branch that fails the ancestry check gets one more look via
# `git cherry`, which compares by patch-id (the actual diff) rather than
# commit identity: if every commit unique to the branch has an equivalent
# already on the integration branch, it's SAFE too, just for a different
# reason -- surfaced in the message so the two cases aren't confused. A
# branch with some but not all commits landed this way reports the split
# and stays REVIEW; nothing here changes what --apply is willing to delete.
wt_prune_branches() {
    local apply=0 want='' a
    while [ $# -gt 0 ]; do
        a=$1
        case "$a" in
            --apply) apply=1 ;;
            -*)      print_error "Unknown option: $a"; return 1 ;;
            *)       want=$a ;;
        esac
        shift
    done

    local root; root=$WORK
    local repos="$root/repos"
    [ -d "$repos" ] || { print_error "No repos/ directory at $repos"; return 1; }

    local targets=() d
    if [ -n "$want" ]; then
        [ -d "$repos/$want" ] || { print_error "No canonical clone at repos/$want"; return 1; }
        targets=("$want")
    else
        for d in "$repos"/*/; do [ -d "$d" ] && targets+=("$(basename "$d")"); done
    fi
    [ ${#targets[@]} -eq 0 ] && { echo "(no clones under repos/)"; return 0; }

    local r repo_dir intbr live safe_count=0 review_count=0
    for r in "${targets[@]}"; do
        repo_dir="$repos/$r"
        if ! git -C "$repo_dir" rev-parse --git-dir >/dev/null 2>&1; then
            print_verbose "$r: not a git repo, skipping"
            continue
        fi
        intbr=$(git -C "$repo_dir" rev-parse --abbrev-ref HEAD 2>/dev/null)
        [ "$intbr" = HEAD ] && intbr=''

        # Branches currently checked out in a live worktree for this repo --
        # never candidates, and a valid merge target for the ancestry check.
        local live=() slug_dir b
        for slug_dir in "$root/worktrees"/*/; do
            [ -d "${slug_dir}${r}" ] || continue
            b=$(git -C "${slug_dir}${r}" rev-parse --abbrev-ref HEAD 2>/dev/null)
            [ -n "$b" ] && [ "$b" != HEAD ] && live+=("$b")
        done

        echo "=== $r ==="
        local branch merged_into is_live lb found_any=0
        local cl cherry_landed cherry_total cherry_unlanded
        while IFS= read -r branch; do
            [ -n "$branch" ] || continue
            [ "$branch" = "$intbr" ] && continue
            is_live=0
            for lb in "${live[@]}"; do [ "$branch" = "$lb" ] && is_live=1 && break; done
            [ "$is_live" -eq 1 ] && continue

            found_any=1
            merged_into=''
            if [ -n "$intbr" ] && git -C "$repo_dir" merge-base --is-ancestor "$branch" "$intbr" 2>/dev/null; then
                merged_into=$intbr
            else
                for lb in "${live[@]}"; do
                    if git -C "$repo_dir" merge-base --is-ancestor "$branch" "$lb" 2>/dev/null; then
                        merged_into=$lb
                        break
                    fi
                done
            fi

            if [ -n "$merged_into" ]; then
                safe_count=$((safe_count + 1))
                if [ "$apply" -eq 1 ]; then
                    if git -C "$repo_dir" branch -D "$branch" >/dev/null 2>&1; then
                        printf '  %-6s %-32s deleted (was merged into %s)\n' SAFE "$branch" "$merged_into"
                    else
                        printf '  %-6s %-32s FAILED to delete (merged into %s)\n' SAFE "$branch" "$merged_into"
                    fi
                else
                    printf '  %-6s %-32s merged into %s\n' SAFE "$branch" "$merged_into"
                fi
                continue
            fi

            # Not an ancestor of anything -- but a repo that pushes straight to
            # main rather than merging feature branches (no merge commit, often
            # a cherry-pick or a manual reapply) leaves a branch that will NEVER
            # become an ancestor even once its content has fully landed.
            # git cherry compares commits by patch-id instead of identity, so a
            # reapplied commit still reads as equivalent to its origin. Only
            # checked against the integration branch -- landing into some other
            # live worktree branch this way is rare enough not to bother with.
            cherry_landed=0 cherry_total=0 cherry_unlanded=false
            if [ -n "$intbr" ]; then
                while IFS= read -r cl; do
                    [ -n "$cl" ] || continue
                    cherry_total=$((cherry_total + 1))
                    case "$cl" in
                        -\ *) cherry_landed=$((cherry_landed + 1)) ;;
                        +\ *) cherry_unlanded=true ;;
                    esac
                done < <(git -C "$repo_dir" cherry "$intbr" "$branch" 2>/dev/null)
            fi

            if [ "$cherry_total" -gt 0 ] && [ "$cherry_unlanded" = false ]; then
                safe_count=$((safe_count + 1))
                if [ "$apply" -eq 1 ]; then
                    if git -C "$repo_dir" branch -D "$branch" >/dev/null 2>&1; then
                        printf '  %-6s %-32s deleted (all %d commit(s) already applied to %s)\n' SAFE "$branch" "$cherry_total" "$intbr"
                    else
                        printf '  %-6s %-32s FAILED to delete (all commits already applied to %s)\n' SAFE "$branch" "$intbr"
                    fi
                else
                    printf '  %-6s %-32s all %d commit(s) already applied to %s (cherry-picked, not merged)\n' SAFE "$branch" "$cherry_total" "$intbr"
                fi
            else
                review_count=$((review_count + 1))
                if [ "$cherry_total" -gt 0 ] && [ "$cherry_landed" -gt 0 ]; then
                    printf '  %-6s %-32s %d of %d commit(s) already applied to %s -- rest outstanding\n' REVIEW "$branch" "$cherry_landed" "$cherry_total" "$intbr"
                else
                    printf '  %-6s %-32s not an ancestor of %s or any live worktree branch\n' REVIEW "$branch" "${intbr:-<none>}"
                fi
            fi
        done < <(git -C "$repo_dir" for-each-ref --format='%(refname:short)' refs/heads)

        [ "$found_any" -eq 0 ] && echo "  (no orphaned branches)"
    done

    echo
    if [ "$apply" -eq 1 ]; then
        print_success "$safe_count branch(es) deleted, $review_count left for manual review"
    else
        print_status "$safe_count safe to delete, $review_count need manual review -- rerun with --apply to delete the safe set"
    fi
}

# True (0) if the clone should be fetched: never fetched, or its last fetch is
# older than $2 minutes. Uses FETCH_HEAD's mtime, so there's no extra state to keep.
clone_stale() {
    local gd fh
    gd=$(git -C "$1" rev-parse --absolute-git-dir 2>/dev/null) || return 0
    fh="$gd/FETCH_HEAD"
    [ -f "$fh" ] || return 0
    [ -n "$(find "$fh" -mmin +"$2" 2>/dev/null)" ]
}

# Fast-forward canonical clones' integration branch to their upstream. Clones are
# never worked in directly, so this is always a clean FF; --ff-only refuses (rather
# than mangles) anything unexpected. No <repo> -> every clone under repos/. With
# --if-stale, skip any clone fetched within the gate (default 24h, override with
# WORKTREE_REFRESH_MAX_AGE_HOURS) — that's the mode workon and worktree add use.
wt_refresh() {
    local if_stale=0 want='' a
    local gate_h=${WORKTREE_REFRESH_MAX_AGE_HOURS:-24}
    while [ $# -gt 0 ]; do
        a=$1
        case "$a" in
            --if-stale) if_stale=1 ;;
            -*)         print_error "Unknown option: $a"; return 1 ;;
            *)          want=$a ;;
        esac
        shift
    done
    local gate_min=$(( gate_h * 60 ))
    print_debug "refresh params: if_stale=$if_stale gate=${gate_h}h (${gate_min}min) target='${want:-all}'"

    local root; root=$WORK
    local repos="$root/repos"
    [ -d "$repos" ] || { print_error "No repos/ directory at $repos"; return 1; }

    local targets=() d
    if [ -n "$want" ]; then
        [ -d "$repos/$want" ] || { print_error "No canonical clone at repos/$want"; return 1; }
        targets=("$want")
    else
        for d in "$repos"/*/; do [ -d "$d" ] && targets+=("$(basename "$d")"); done
    fi
    [ ${#targets[@]} -eq 0 ] && { echo "(no clones under repos/)"; return 0; }

    local r repo_dir branch before after rc=0
    for r in "${targets[@]}"; do
        repo_dir="$repos/$r"
        if ! git -C "$repo_dir" rev-parse --git-dir >/dev/null 2>&1; then
            printf '  %-12s %s\n' "$r" "skipped (not a git repo)"; continue
        fi

        install_commit_hook "$repo_dir" "$r"

        branch=$(git -C "$repo_dir" rev-parse --abbrev-ref HEAD 2>/dev/null)
        if [ -z "$branch" ] || [ "$branch" = HEAD ]; then
            printf '  %-12s %s\n' "$r" "skipped (detached HEAD)"; continue
        fi
        if [ "$if_stale" -eq 1 ]; then
            if clone_stale "$repo_dir" "$gate_min"; then
                print_debug "$r: FETCH_HEAD older than ${gate_h}h — will fetch"
            else
                print_debug "$r: FETCH_HEAD within ${gate_h}h — skipping"
                printf '  %-12s %s\n' "$r" "fresh (fetched <${gate_h}h ago)"; continue
            fi
        fi
        print_verbose "Fetching $r ($branch) ..."
        if ! git -C "$repo_dir" fetch --prune --quiet origin 2>/dev/null; then
            printf '  %-12s %s\n' "$r" "FETCH FAILED (offline?) — left as-is"; rc=1; continue
        fi
        before=$(git -C "$repo_dir" rev-parse --short HEAD 2>/dev/null)
        if git -C "$repo_dir" merge --ff-only --quiet "origin/$branch" 2>/dev/null; then
            after=$(git -C "$repo_dir" rev-parse --short HEAD 2>/dev/null)
            if [ "$before" = "$after" ]; then
                printf '  %-12s %s\n' "$r" "up to date ($branch @ $after)"
            else
                printf '  %-12s %s\n' "$r" "updated $before -> $after ($branch)"
            fi
        else
            printf '  %-12s %s\n' "$r" "NOT fast-forward ($branch) — left as-is, reconcile by hand"; rc=1
        fi
    done
    return "$rc"
}

###
### Dispatch
###
# Parse global options before the subcommand so `worktree -v refresh` works.
# -d implies -v.
# shellcheck disable=SC2034  # VERBOSE/DEBUG are read by print_* in lib.sh
while [ $# -gt 0 ]; do
    case "$1" in
        -v|--verbose) VERBOSE=true; shift ;;
        -d|--debug)   DEBUG=true; VERBOSE=true; shift ;;
        -h|--help|help) printf '%s\n' "$usage"; exit 0 ;;
        *) break ;;
    esac
done

sub="${1:-}"
[ $# -gt 0 ] && shift
case "$sub" in
    add)                wt_add "$@" ;;
    rm|remove)          wt_rm "$@" ;;
    mv|rename)          wt_mv "$@" ;;
    list|ls)            wt_list "$@" ;;
    refresh|sync)       wt_refresh "$@" ;;
    prune-branches)     wt_prune_branches "$@" ;;
    '')                 printf '%s\n' "$usage" ;;
    *)                  print_error "Unknown subcommand: $sub (try --help)"; exit 1 ;;
esac
