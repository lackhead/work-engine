#!/usr/bin/env bash
#
# workitem — create, list, and archive work items under ~/work/data/items/.
#
# Engine tool for the work system. Lives at ~/work/engine/bin/workitem (the
# work-engine repo, on PATH). Companion completion:
# ~/work/engine/bin/completions/workitem.fish.
#

set -u

WORK="${WORK_ROOT:-$HOME/work}"

###
### Output functions
###
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NORMAL='\033[0m'
VERBOSE=false
DEBUG=false

print_status()  { echo -e "${BLUE}[INFO]${NORMAL} $1"; }
print_success() { echo -e "${GREEN}[SUCCESS]${NORMAL} $1"; }
print_warning() { echo -e "${YELLOW}[WARNING]${NORMAL} $1" >&2; }
print_error()   { echo -e "${RED}[ERROR]${NORMAL} $1" >&2; }
print_verbose() { [ "$VERBOSE" = true ] && echo -e "${BLUE}[VERBOSE]${NORMAL} $1" >&2 || true; }
print_debug()   { [ "$DEBUG" = true ] && echo -e "${BLUE}[DEBUG]${NORMAL} $1" >&2 || true; }

IFS='' read -r -d '' usage <<"EOF"

workitem: create, list, show, and transition the lifecycle of work items under ~/work/data/items/

Usage:
   workitem [ -h|--help ]
   workitem [ -v|--verbose ] [ -d|--debug ] create   [-q|--quick] [-b|--backlog] [-s|--slug <slug>] [title...]
   workitem [ -v|--verbose ] [ -d|--debug ] list     [--backlog|--archived|--all] [--status <value>]
   workitem [ -v|--verbose ] [ -d|--debug ] show     <slug>
   workitem [ -v|--verbose ] [ -d|--debug ] activate <slug>
   workitem [ -v|--verbose ] [ -d|--debug ] defer    <slug>
   workitem [ -v|--verbose ] [ -d|--debug ] block    <slug>
   workitem [ -v|--verbose ] [ -d|--debug ] unblock  <slug>
   workitem [ -v|--verbose ] [ -d|--debug ] archive  <slug> [--completed|--cancelled]
   workitem [ -v|--verbose ] [ -d|--debug ] delete   <slug> [--force]

Arguments:
   -h|--help     Show what you are seeing right now
   -v|--verbose  Show what is happening as it happens
   -d|--debug    Show diagnostic detail (implies --verbose)

Description:
   create   Creates items/<slug>/<slug>.md from the title, status active,
            top-level. -s/--slug sets the slug explicitly. -q/--quick
            skips the title requirement for a throwaway item (tags:
            [quick]). -b/--backlog creates in items/backlog/<slug>/
            instead, status proposed. -q and -b are mutually exclusive.

   list     Display work items: slug, status, due, last update. Defaults
            to top-level (active + blocked); --backlog/--archived/--all
            broaden the scope.

   show     Prints the item's front door (<slug>.md) — piped through
            $PAGER if set, else plain output.

   activate Moves a backlog item to items/<slug>/, status active.

   defer    Moves a top-level item to items/backlog/<slug>/, status
            deferred.

   block    Sets a top-level item's status from active to blocked.
            Frontmatter only, no move.

   unblock  Sets a top-level item's status from blocked to active.
            Frontmatter only, no move.

   archive  Sets status to completed/cancelled (prompted if not given as a
            flag) and moves the item to items/archived/<slug>/.

   delete   Removes the item's directory outright. Refuses unless <slug>
            is tagged `quick` (--force overrides).

Examples:
   workitem create Rework cache host info
   workitem create -q
   workitem create --quick Fix the Ansible lint warning
   workitem create -b Investigate the new vendor API
   workitem create -s ad-backup-crons Remove -n from the AD backup crons once...
   workitem list
   workitem list --backlog
   workitem list --all --status blocked
   workitem show nagios
   workitem activate some-backlog-item
   workitem defer some-active-item
   workitem block some-active-item
   workitem unblock some-blocked-item
   workitem archive nagios --completed
   workitem delete quick-task-2026-07-11-10-56

EOF

trim()  { printf '%s' "$1" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'; }

# Kebab-case $1, truncated to at most $2 characters (default 30). Truncation
# snaps back to the last complete word boundary that fits rather than
# cutting mid-word -- a long title should still read as words, not a
# ragged fragment. (A single first word longer than the cap is the one
# case that still gets a hard cut -- nothing left to snap back to.)
kebab() {
    local s max cut
    s=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')
    max=${2:-30}
    if [ ${#s} -le "$max" ]; then
        printf '%s' "$s"
        return
    fi
    cut="${s:0:$max}"
    [[ "$cut" == *-* ]] && cut="${cut%-*}"
    printf '%s' "$cut"
}

# Truncate to at most $2 chars, marking truncation with a trailing '..'
# (plain ASCII, not a unicode ellipsis, to avoid locale-dependent character
# counting in ${#s} throwing the width off). Keeps table columns aligned
# regardless of how long a slug is.
trunc() {
    local s=$1 max=$2
    if [ ${#s} -le "$max" ]; then
        printf '%s' "$s"
    else
        printf '%s..' "${s:0:$((max - 2))}"
    fi
}

# Portable last-modified date (BSD/macOS stat and GNU/Linux stat use
# incompatible flags — branch on uname rather than probing flags, since
# GNU's -f means something else entirely and won't reliably fail).
file_mtime_date() {
    case "$(uname -s)" in
        Darwin|*BSD) stat -f '%Sm' -t '%Y-%m-%d' "$1" 2>/dev/null ;;
        *)           stat -c '%y' "$1" 2>/dev/null | cut -d' ' -f1 ;;
    esac
}

# transition_status <front> <new_status> <stamp_field> <destdir>
#
# Shared by every subcommand that changes an item's status and/or zone
# (archive, activate, defer, block, unblock). front is the item's front-door
# file at its CURRENT location; new_status is the value to write into
# status:; stamp_field is a frontmatter field to stamp with today's date
# ('' to skip -- block/unblock/activate/defer don't stamp anything);
# destdir is the directory to move the item to ('' for a frontmatter-only
# transition that never moves, e.g. block/unblock).
#
# Order matters here and is the entire reason this function exists: the
# frontmatter edit is staged with `git add` at the CURRENT path BEFORE any
# `git mv` of the directory. Staging after the move (or not at all) lets
# `git mv` pick up the index's stale pre-edit blob instead of the file's
# actual current content, silently dropping the edit from the eventual
# commit -- a real bug, found and fixed in this function's ancestor (the
# inline logic that used to live in wi_archive alone).
#
# Returns 0 on success. On failure, prints an error and returns 1 -- but if
# the failure is in the move step, the frontmatter edit has already
# happened and is already staged; callers shouldn't imply a clean no-op.
transition_status() {
    local front=$1 newstatus=$2 stamp_field=${3:-} destdir=${4:-}
    local srcdir; srcdir=$(dirname "$front")

    if [ ! -f "$front" ]; then
        print_error "Front-door file not found: ${front#"$WORK"/data/}"
        return 1
    fi
    if [ -n "$destdir" ] && [ -e "$destdir" ]; then
        print_error "Target already exists: ${destdir#"$WORK"/data/}"
        return 1
    fi

    local today; today=$(date +%Y-%m-%d)
    local tmp; tmp=$(mktemp)
    if [ -n "$stamp_field" ] && grep -q "^${stamp_field}:" "$front"; then
        sed -e "s/^status:.*/status: $newstatus/" \
            -e "s/^${stamp_field}:.*/${stamp_field}: $today/" "$front" > "$tmp"
    elif [ -n "$stamp_field" ]; then
        awk -v s="$newstatus" -v f="$stamp_field" -v d="$today" '
            /^status:/ { print "status: " s; print f ": " d; next }
            { print }
        ' "$front" > "$tmp"
    else
        sed -e "s/^status:.*/status: $newstatus/" "$front" > "$tmp"
    fi
    mv "$tmp" "$front"
    print_debug "Frontmatter updated: status=$newstatus${stamp_field:+ $stamp_field=$today}"

    if git -C "$WORK/data" rev-parse --git-dir >/dev/null 2>&1; then
        git -C "$WORK/data" add "$front" 2>/dev/null || true
    fi

    [ -n "$destdir" ] || return 0

    mkdir -p "$(dirname "$destdir")"
    local rel_src rel_dest
    rel_src="${srcdir#"$WORK"/data/}"
    rel_dest="${destdir#"$WORK"/data/}"
    # `git mv` refuses untracked paths outright ("fatal: not under version
    # control") — a --quick item transitioned in the same session it was
    # created in was never `git add`ed, so only fall back to plain `mv` when
    # nothing under srcdir is actually tracked yet; use `git mv` (preserving
    # rename history) whenever the item has been committed at least once.
    if git -C "$WORK/data" rev-parse --git-dir >/dev/null 2>&1 \
       && [ -n "$(git -C "$WORK/data" ls-files "$rel_src")" ]; then
        git -C "$WORK/data" mv "$rel_src" "$rel_dest" || {
            print_error "Move to $rel_dest failed — frontmatter updated, item left in place."
            return 1
        }
    else
        mv "$srcdir" "$destdir" || {
            print_error "Move to $rel_dest failed — frontmatter updated, item left in place."
            return 1
        }
    fi
}

###
### Subcommands
###
wi_create() {
    local quick=false backlog=false slug_opt='' title_parts=() title made slug itemdir file a
    while [ $# -gt 0 ]; do
        a=$1
        case "$a" in
            -q|--quick)   quick=true ;;
            -b|--backlog) backlog=true ;;
            -s|--slug)    shift; slug_opt=${1:-} ;;
            --slug=*)     slug_opt=${a#--slug=} ;;
            *)            title_parts+=("$a") ;;
        esac
        shift
    done

    if [ "$quick" = true ] && [ "$backlog" = true ]; then
        print_error "-q/--quick and -b/--backlog are mutually exclusive (quick items are always active/top-level)."
        return 1
    fi

    title=''
    [ ${#title_parts[@]} -gt 0 ] && title="${title_parts[*]}"
    title="$(trim "$title")"
    if [ -z "$title" ] && [ "$quick" = true ]; then
        # Seconds, not just minutes — two `--quick` runs inside the same
        # minute would otherwise generate the same slug before the
        # collision-suffix loop below even gets a chance to kick in.
        title="Quick task — $(date '+%Y-%m-%d %H:%M:%S')"
    fi
    if [ -z "$title" ]; then
        print_error "Usage: workitem create [-q|--quick] [-b|--backlog] [-s|--slug <slug>] <title...> — title is required."
        return 1
    fi

    made=$(date +%Y-%m-%d)
    # An explicit -s/--slug is sanitized but not truncated -- it's already a
    # deliberate short name, not something derived from a long title.
    if [ -n "$slug_opt" ]; then
        slug=$(kebab "$slug_opt" 200)
    else
        slug=$(kebab "$title")
    fi
    print_debug "Creating item: slug=$slug quick=$quick backlog=$backlog"

    # Resolve a collision by appending -2, -3, ... rather than refusing --
    # once slugs are truncated/short, two unrelated titles legitimately
    # landing on the same slug is expected, not an error.
    local base="$slug" n=1 z collide
    while true; do
        collide=false
        for z in '' backlog/ archived/; do
            if [ -e "$WORK/data/items/$z$slug.md" ] || [ -d "$WORK/data/items/$z$slug" ]; then
                collide=true; break
            fi
        done
        [ "$collide" = true ] || break
        n=$((n + 1))
        slug="$base-$n"
    done
    [ "$slug" != "$base" ] && print_verbose "Slug '$base' taken — using '$slug'"

    local zone='' status='active'
    if [ "$backlog" = true ]; then
        zone='backlog/'
        status='proposed'
    fi

    itemdir="$WORK/data/items/${zone}$slug"
    file="$itemdir/$slug.md"
    mkdir -p "$itemdir"
    {
        echo "---"
        echo "title: $title"
        echo "status: $status"
        echo "made: $made"
        [ "$quick" = true ] && echo "tags: [quick]"
        echo "---"
        echo
        echo "# $title"
    } > "$file"

    # --quick is meant to be consumed by scripts (workon --quick captures
    # this via command substitution) — bare slug only, no banner.
    if [ "$quick" = true ]; then
        printf '%s\n' "$slug"
    else
        print_success "Created → ${file/#$HOME/\~}"
    fi
}

wi_list() {
    local zones=() show_zone_col=false status_filter='' a
    while [ $# -gt 0 ]; do
        a=$1
        case "$a" in
            --backlog)  zones+=(backlog) ;;
            --archived) zones+=(archived) ;;
            --all)      zones=(top backlog archived); show_zone_col=true ;;
            --status)   shift; status_filter=${1:-} ;;
            --status=*) status_filter=${a#--status=} ;;
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)  print_error "Unexpected argument: $a"; return 1 ;;
        esac
        shift
    done
    [ ${#zones[@]} -eq 0 ] && zones=(top)

    local root="$WORK/data/items"
    if [ "$show_zone_col" = true ]; then
        printf '%-28s %-9s %-11s %-11s %s\n' SLUG STATUS DUE UPDATED ZONE
    else
        printf '%-28s %-9s %-11s %-11s\n' SLUG STATUS DUE UPDATED
    fi

    local zone dir itemdir slug front status due updated found=0
    for zone in "${zones[@]}"; do
        dir="$root"
        [ "$zone" != top ] && dir="$root/$zone"
        [ -d "$dir" ] || continue
        for itemdir in "$dir"/*/; do
            [ -d "$itemdir" ] || continue
            slug=$(basename "$itemdir")
            front="$itemdir$slug.md"
            [ -f "$front" ] || continue
            status=$(sed -n 's/^status: *//p' "$front" | head -1)
            [ -n "$status_filter" ] && [ "$status" != "$status_filter" ] && continue
            due=$(sed -n 's/^due: *//p' "$front" | head -1)
            updated=$(file_mtime_date "$front")
            if [ "$show_zone_col" = true ]; then
                printf '%-28s %-9s %-11s %-11s %s\n' \
                    "$(trunc "$slug" 28)" "$status" "${due:--}" "${updated:--}" "$zone"
            else
                printf '%-28s %-9s %-11s %-11s\n' \
                    "$(trunc "$slug" 28)" "$status" "${due:--}" "${updated:--}"
            fi
            found=1
        done
    done
    [ "$found" -eq 1 ] || echo "(none)"
}

wi_show() {
    local slug='' a
    for a in "$@"; do
        case "$a" in
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)
                if [ -z "$slug" ]; then slug=$a
                else print_error "Too many arguments."; return 1
                fi ;;
        esac
    done
    if [ -z "$slug" ]; then
        print_error "Usage: workitem show <slug>"; return 1
    fi

    local root="$WORK/data/items" front='' z
    for z in '' backlog/ archived/; do
        if [ -f "$root/$z$slug/$slug.md" ]; then
            front="$root/$z$slug/$slug.md"
            break
        fi
    done
    if [ -z "$front" ]; then
        print_error "No item '$slug' found."; return 1
    fi

    if [ -n "${PAGER:-}" ]; then
        # Intentionally unquoted: $PAGER commonly carries flags (e.g. "less -R"),
        # and quoting it would treat the whole string as one command name.
        $PAGER "$front"
    else
        cat "$front"
    fi
}

# activate/defer/block/unblock deliberately never touch worktrees, unlike
# archive/delete: the item is staying in play, just changing zone/status,
# not leaving active circulation.

wi_activate() {
    local slug='' a
    for a in "$@"; do
        case "$a" in
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)
                if [ -z "$slug" ]; then slug=$a
                else print_error "Too many arguments."; return 1
                fi ;;
        esac
    done
    if [ -z "$slug" ]; then
        print_error "Usage: workitem activate <slug>"; return 1
    fi

    local root="$WORK/data/items"
    if [ ! -d "$root/backlog/$slug" ]; then
        if [ -d "$root/$slug" ]; then
            print_error "'$slug' is already top-level (not in backlog)."
        elif [ -d "$root/archived/$slug" ]; then
            print_error "'$slug' is archived — not in backlog."
        else
            print_error "No item '$slug' found in items/backlog/."
        fi
        return 1
    fi

    local srcdir="$root/backlog/$slug"
    transition_status "$srcdir/$slug.md" active '' "$root/$slug" || return 1
    print_success "Activated → items/$slug (active)"
}

wi_defer() {
    local slug='' a
    for a in "$@"; do
        case "$a" in
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)
                if [ -z "$slug" ]; then slug=$a
                else print_error "Too many arguments."; return 1
                fi ;;
        esac
    done
    if [ -z "$slug" ]; then
        print_error "Usage: workitem defer <slug>"; return 1
    fi

    local root="$WORK/data/items"
    if [ ! -d "$root/$slug" ]; then
        if [ -d "$root/backlog/$slug" ]; then
            print_error "'$slug' is already in backlog."
        elif [ -d "$root/archived/$slug" ]; then
            print_error "'$slug' is archived — not top-level."
        else
            print_error "No item '$slug' found at top level."
        fi
        return 1
    fi

    local srcdir="$root/$slug"
    transition_status "$srcdir/$slug.md" deferred '' "$root/backlog/$slug" || return 1
    print_success "Deferred → items/backlog/$slug (deferred)"
}

wi_block() {
    local slug='' a
    for a in "$@"; do
        case "$a" in
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)
                if [ -z "$slug" ]; then slug=$a
                else print_error "Too many arguments."; return 1
                fi ;;
        esac
    done
    if [ -z "$slug" ]; then
        print_error "Usage: workitem block <slug>"; return 1
    fi

    local root="$WORK/data/items"
    local srcdir="$root/$slug"
    if [ ! -d "$srcdir" ]; then
        if [ -d "$root/backlog/$slug" ]; then
            print_error "'$slug' is in backlog — block only applies to top-level items."
        elif [ -d "$root/archived/$slug" ]; then
            print_error "'$slug' is archived — block only applies to top-level items."
        else
            print_error "No item '$slug' found at top level."
        fi
        return 1
    fi

    local front="$srcdir/$slug.md"
    local status; status=$(sed -n 's/^status: *//p' "$front" | head -1)
    case "$status" in
        blocked) print_error "'$slug' is already blocked."; return 1 ;;
        active)  ;;
        *) print_error "'$slug' has status '$status', not active — refusing to override."; return 1 ;;
    esac

    transition_status "$front" blocked || return 1
    print_success "Blocked '$slug' (active → blocked)"
}

wi_unblock() {
    local slug='' a
    for a in "$@"; do
        case "$a" in
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)
                if [ -z "$slug" ]; then slug=$a
                else print_error "Too many arguments."; return 1
                fi ;;
        esac
    done
    if [ -z "$slug" ]; then
        print_error "Usage: workitem unblock <slug>"; return 1
    fi

    local root="$WORK/data/items"
    local srcdir="$root/$slug"
    if [ ! -d "$srcdir" ]; then
        if [ -d "$root/backlog/$slug" ]; then
            print_error "'$slug' is in backlog — unblock only applies to top-level items."
        elif [ -d "$root/archived/$slug" ]; then
            print_error "'$slug' is archived — unblock only applies to top-level items."
        else
            print_error "No item '$slug' found at top level."
        fi
        return 1
    fi

    local front="$srcdir/$slug.md"
    local status; status=$(sed -n 's/^status: *//p' "$front" | head -1)
    case "$status" in
        active)  print_error "'$slug' is not blocked (status: active)."; return 1 ;;
        blocked) ;;
        *) print_error "'$slug' has status '$status', not blocked — refusing to override."; return 1 ;;
    esac

    transition_status "$front" active || return 1
    print_success "Unblocked '$slug' (blocked → active)"
}

wi_archive() {
    local slug='' newstatus='' a
    while [ $# -gt 0 ]; do
        a=$1
        case "$a" in
            --completed) newstatus=completed ;;
            --cancelled) newstatus=cancelled ;;
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)
                if [ -z "$slug" ]; then slug=$a
                else print_error "Too many arguments."; return 1
                fi ;;
        esac
        shift
    done
    if [ -z "$slug" ]; then
        print_error "Usage: workitem archive <slug> [--completed|--cancelled]"; return 1
    fi

    local root="$WORK/data/items" srcdir=''
    if [ -d "$root/$slug" ]; then
        srcdir="$root/$slug"
    elif [ -d "$root/backlog/$slug" ]; then
        srcdir="$root/backlog/$slug"
    elif [ -d "$root/archived/$slug" ]; then
        print_error "'$slug' is already archived."; return 1
    else
        print_error "No item '$slug' found (checked items/ and items/backlog/)."; return 1
    fi
    print_verbose "Found item at ${srcdir/#$HOME/\~}"

    if [ -z "$newstatus" ]; then
        read -r -p "completed or cancelled? [c/x] " reply
        case "$(printf '%s' "$reply" | tr '[:upper:]' '[:lower:]')" in
            c*) newstatus=completed ;;
            x*|d*) newstatus=cancelled ;;
            *) print_error "Cancelled — nothing changed."; return 1 ;;
        esac
    fi

    local front="$srcdir/$slug.md"
    local destdir="$root/archived/$slug"
    transition_status "$front" "$newstatus" completed "$destdir" || return 1

    if [ -d "$WORK/worktrees/$slug" ]; then
        print_status "Removing worktree(s) for '$slug' ..."
        worktree rm "$slug" || print_warning "worktree rm failed — clean it up by hand."
    fi

    print_success "Archived → items/archived/$slug ($newstatus)"
}

wi_delete() {
    local slug='' force=false a
    for a in "$@"; do
        case "$a" in
            --force) force=true ;;
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)
                if [ -z "$slug" ]; then slug=$a
                else print_error "Too many arguments."; return 1
                fi ;;
        esac
    done
    if [ -z "$slug" ]; then
        print_error "Usage: workitem delete <slug> [--force]"; return 1
    fi

    local root="$WORK/data/items" srcdir=''
    if [ -d "$root/$slug" ]; then
        srcdir="$root/$slug"
    elif [ -d "$root/backlog/$slug" ]; then
        srcdir="$root/backlog/$slug"
    elif [ -d "$root/archived/$slug" ]; then
        srcdir="$root/archived/$slug"
    else
        print_error "No item '$slug' found."; return 1
    fi
    print_verbose "Found item at ${srcdir/#$HOME/\~}"

    # Deletion (not archiving) is a deliberate, narrow exception — see the
    # root CLAUDE.md's "nothing is deleted" principle. Reserved for `--quick`
    # items with nothing to preserve; anything else needs --force, an
    # explicit admission that there's real content being thrown away.
    if [ "$force" != true ] && ! grep -qE '^tags:.*\bquick\b' "$srcdir/$slug.md" 2>/dev/null; then
        print_error "'$slug' isn't tagged quick — refusing to delete without --force."
        return 1
    fi

    if [ -d "$WORK/worktrees/$slug" ]; then
        print_status "Removing worktree(s) for '$slug' ..."
        worktree rm "$slug" || print_warning "worktree rm failed — clean it up by hand."
    fi

    rm -rf "$srcdir"
    print_success "Deleted ${srcdir/#$HOME/\~}"
}

###
### Dispatch
###
# Parse global options before the subcommand so `workitem -v list` works.
# -d implies -v.
while [ $# -gt 0 ]; do
    case "$1" in
        -v|--verbose) VERBOSE=true; shift ;;
        -d|--debug)   DEBUG=true; VERBOSE=true; shift ;;
        -h|--help|help) printf '%s\n' "$usage"; exit 0 ;;
        *) break ;;
    esac
done

cmd="${1:-}"
[ "$#" -gt 0 ] && shift
case "$cmd" in
    create)   wi_create "$@" ;;
    list)     wi_list "$@" ;;
    show)     wi_show "$@" ;;
    activate) wi_activate "$@" ;;
    defer)    wi_defer "$@" ;;
    block)    wi_block "$@" ;;
    unblock)  wi_unblock "$@" ;;
    archive)  wi_archive "$@" ;;
    delete)   wi_delete "$@" ;;
    '')       printf '%s\n' "$usage" ;;
    *)        print_error "Unknown command '$cmd' (try: workitem help)"; exit 1 ;;
esac
