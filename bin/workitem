#!/usr/bin/env bash
#
# workitem — create, list, show, and transition the lifecycle of work items
# under ~/work/data/items/.
#
# Engine tool for the work system. Lives at ~/work/engine/bin/workitem (the
# work-engine repo, on PATH). Companion completion:
# ~/work/engine/bin/completions/workitem.fish.
#

set -u

# Shared boilerplate: WORK root, print_* output functions, trim/kebab/trunc/
# iso_now. Resolves to lib.sh in this script's own bin/ dir — works on $PATH,
# via an explicit path, host or container. See docs/bin-coding-standards.md.
# shellcheck source=lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

IFS='' read -r -d '' usage <<"EOF"

workitem: create, list, show, and transition the lifecycle of work items under ~/work/data/items/

Usage:
   workitem [ -h|--help ]
   workitem [ -v|--verbose ] [ -d|--debug ] create   [-q|--quick] [-b|--backlog] [-s|--slug <slug>] [title...]
   workitem [ -v|--verbose ] [ -d|--debug ] list     [--backlog|--archived|--all] [--status <value>]
   workitem [ -v|--verbose ] [ -d|--debug ] show     <slug>
   workitem [ -v|--verbose ] [ -d|--debug ] log      [-r|--repo <repo>] [item-slug]
   workitem [ -v|--verbose ] [ -d|--debug ] activate <slug>
   workitem [ -v|--verbose ] [ -d|--debug ] defer    <slug>
   workitem [ -v|--verbose ] [ -d|--debug ] block    <slug>
   workitem [ -v|--verbose ] [ -d|--debug ] unblock  <slug>
   workitem [ -v|--verbose ] [ -d|--debug ] complete <slug>
   workitem [ -v|--verbose ] [ -d|--debug ] cancel   <slug>
   workitem [ -v|--verbose ] [ -d|--debug ] delete   <slug> [--force]

Arguments:
   -h|--help     Show what you are seeing right now
   -v|--verbose  Show what is happening as it happens
   -d|--debug    Show diagnostic detail (implies --verbose)

Description:
   create   Creates items/<slug>/<slug>.md from the title, status active,
            top-level. -s/--slug sets the slug explicitly. -q/--quick
            skips the title requirement, generating one from a timestamp
            instead, for a throwaway item you'd rather not name yet.
            -b/--backlog creates in items/backlog/<slug>/ instead, status
            proposed. -q and -b are mutually exclusive.

   list     Display work items: slug, status, due, last update. Defaults
            to top-level (active + blocked); --backlog/--archived/--all
            broaden the scope.

   show     Prints the item's front door (<slug>.md) — piped through
            $PAGER if set, else plain output.

   log      Records a note for work done outside a Claude Code session.
            Prompts for the latest commit (in the given -r/--repo, or the
            current directory's repo if inside one) and for note text.
            Writes to item-slug's log/ if given (top-level or backlog
            only, never archived); else auto-detects the item if the
            current directory is one of its worktrees; else asks whether
            it belongs to an existing item (top-level items only, picked
            interactively) or creates a new completed item to hold it.

   activate Moves a backlog item to items/<slug>/, status active.

   defer    Moves a top-level item to items/backlog/<slug>/, status
            deferred.

   block    Sets a top-level item's status from active to blocked.
            Frontmatter only, no move.

   unblock  Sets a top-level item's status from blocked to active.
            Frontmatter only, no move.

   complete Sets status to completed, stamps completed: with today, moves
            the item to items/archived/<slug>/, and removes its worktree(s)
            if any. Item must be top-level (not backlog or archived) --
            activate a backlog item first, or delete it if it's not going
            anywhere.

   cancel   Sets status to cancelled, stamps completed: with today, moves
            the item to items/archived/<slug>/, and removes its worktree(s)
            if any. Item must be top-level (not backlog or archived) --
            activate a backlog item first, or delete it if it's not going
            anywhere.

   delete   Removes the item's directory outright. Always requires
            --force, an explicit admission there's nothing worth
            preserving — workon's own post-session sweep passes it after
            already verifying the item is empty.

Examples:
   workitem create Rework cache host info
   workitem create -q
   workitem create --quick Fix the Ansible lint warning
   workitem create -b Investigate the new vendor API
   workitem create -s ad-backup-crons Remove -n from the AD backup crons once...
   workitem list
   workitem list --backlog
   workitem list --all --status blocked
   workitem show nagios
   workitem log nagios
   workitem log --repo Ansible nagios
   workitem log
   workitem activate some-backlog-item
   workitem defer some-active-item
   workitem block some-active-item
   workitem unblock some-blocked-item
   workitem complete nagios
   workitem cancel some-active-item
   workitem delete quick-task-2026-07-11-10-56 --force

EOF

# Portable last-modified date (BSD/macOS stat and GNU/Linux stat use
# incompatible flags — branch on uname rather than probing flags, since
# GNU's -f means something else entirely and won't reliably fail).
file_mtime_date() {
    case "$(uname -s)" in
        Darwin|*BSD) stat -f '%Sm' -t '%Y-%m-%d' "$1" 2>/dev/null ;;
        *)           stat -c '%y' "$1" 2>/dev/null | cut -d' ' -f1 ;;
    esac
}

# transition_status <front> <new_status> <stamp_field> <destdir>
#
# Shared by every subcommand that changes an item's status and/or zone
# (complete, cancel, activate, defer, block, unblock). front is the item's front-door
# file at its CURRENT location; new_status is the value to write into
# status:; stamp_field is a frontmatter field to stamp with today's date
# ('' to skip -- block/unblock/activate/defer don't stamp anything);
# destdir is the directory to move the item to ('' for a frontmatter-only
# transition that never moves, e.g. block/unblock).
#
# Order matters here and is the entire reason this function exists: the
# frontmatter edit is staged with `git add` at the CURRENT path BEFORE any
# `git mv` of the directory. Staging after the move (or not at all) lets
# `git mv` pick up the index's stale pre-edit blob instead of the file's
# actual current content, silently dropping the edit from the eventual
# commit -- a real bug, found and fixed in this function's ancestor (the
# inline logic that used to live in wi_archive alone).
#
# Returns 0 on success. On failure, prints an error and returns 1 -- but if
# the failure is in the move step, the frontmatter edit has already
# happened and is already staged; callers shouldn't imply a clean no-op.
transition_status() {
    local front=$1 newstatus=$2 stamp_field=${3:-} destdir=${4:-}
    local srcdir; srcdir=$(dirname "$front")

    if [ ! -f "$front" ]; then
        print_error "Front-door file not found: ${front#"$WORK"/data/}"
        return 1
    fi
    if [ -n "$destdir" ] && [ -e "$destdir" ]; then
        print_error "Target already exists: ${destdir#"$WORK"/data/}"
        return 1
    fi

    local today; today=$(date +%Y-%m-%d)
    local tmp; tmp=$(mktemp)
    if [ -n "$stamp_field" ] && grep -q "^${stamp_field}:" "$front"; then
        sed -e "s/^status:.*/status: $newstatus/" \
            -e "s/^${stamp_field}:.*/${stamp_field}: $today/" "$front" > "$tmp"
    elif [ -n "$stamp_field" ]; then
        awk -v s="$newstatus" -v f="$stamp_field" -v d="$today" '
            /^status:/ { print "status: " s; print f ": " d; next }
            { print }
        ' "$front" > "$tmp"
    else
        sed -e "s/^status:.*/status: $newstatus/" "$front" > "$tmp"
    fi
    mv "$tmp" "$front"
    print_debug "Frontmatter updated: status=$newstatus${stamp_field:+ $stamp_field=$today}"

    if git -C "$WORK/data" rev-parse --git-dir >/dev/null 2>&1; then
        git -C "$WORK/data" add "$front" 2>/dev/null || true
    fi

    [ -n "$destdir" ] || return 0

    mkdir -p "$(dirname "$destdir")"
    local rel_src rel_dest
    rel_src="${srcdir#"$WORK"/data/}"
    rel_dest="${destdir#"$WORK"/data/}"
    # `git mv` refuses untracked paths outright ("fatal: not under version
    # control") — an item transitioned in the same session it was created in
    # was never `git add`ed, so only fall back to plain `mv` when
    # nothing under srcdir is actually tracked yet; use `git mv` (preserving
    # rename history) whenever the item has been committed at least once.
    if git -C "$WORK/data" rev-parse --git-dir >/dev/null 2>&1 \
       && [ -n "$(git -C "$WORK/data" ls-files "$rel_src")" ]; then
        git -C "$WORK/data" mv "$rel_src" "$rel_dest" || {
            print_error "Move to $rel_dest failed — frontmatter updated, item left in place."
            return 1
        }
    else
        mv "$srcdir" "$destdir" || {
            print_error "Move to $rel_dest failed — frontmatter updated, item left in place."
            return 1
        }
    fi
}

###
### Shared item helpers
###

# Parse exactly one positional <slug> from "$@" (no options accepted) and echo
# it. $1 is the subcommand name, used only in the usage error. Prints an error
# and returns 1 on an unknown option, a second positional, or a missing slug —
# so callers use:  slug=$(wi_one_slug <cmd> "$@") || return 1
wi_one_slug() {
    local cmd=$1; shift
    local slug='' a
    for a in "$@"; do
        case "$a" in
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)
                if [ -z "$slug" ]; then slug=$a
                else print_error "Too many arguments."; return 1
                fi ;;
        esac
    done
    [ -n "$slug" ] || { print_error "Usage: workitem $cmd <slug>"; return 1; }
    printf '%s' "$slug"
}

# Echo which attention zone an item's directory lives in — top | backlog |
# archived — or nothing if it doesn't exist anywhere. That's all a caller needs;
# the directory is "$WORK/data/items[/<zone>]/<slug>". Centralizes the existence
# ladder every slug-taking subcommand shares — the tailored "wrong zone" error
# wording stays with each subcommand.
wi_locate() {
    local slug=$1 root="$WORK/data/items"
    if   [ -d "$root/$slug" ];          then echo top
    elif [ -d "$root/backlog/$slug" ];  then echo backlog
    elif [ -d "$root/archived/$slug" ]; then echo archived
    fi
}

# Echo a slug colliding with no existing item in any zone: <base> if free, else
# <base>-2, <base>-3, ... Checks both the legacy <slug>.md file and <slug>/ dir.
wi_unique_slug() {
    local base=$1 slug=$1 n=1 z collide
    while true; do
        collide=false
        for z in '' backlog/ archived/; do
            if [ -e "$WORK/data/items/$z$slug.md" ] || [ -d "$WORK/data/items/$z$slug" ]; then
                collide=true; break
            fi
        done
        [ "$collide" = true ] || break
        n=$((n + 1))
        slug="$base-$n"
    done
    printf '%s' "$slug"
}

###
### Subcommands
###
wi_create() {
    local quick=false backlog=false slug_opt='' title_parts=() title made slug itemdir file a
    while [ $# -gt 0 ]; do
        a=$1
        case "$a" in
            -q|--quick)   quick=true ;;
            -b|--backlog) backlog=true ;;
            -s|--slug)    shift; slug_opt=${1:-} ;;
            --slug=*)     slug_opt=${a#--slug=} ;;
            *)            title_parts+=("$a") ;;
        esac
        shift
    done

    if [ "$quick" = true ] && [ "$backlog" = true ]; then
        print_error "-q/--quick and -b/--backlog are mutually exclusive (quick items are always active/top-level)."
        return 1
    fi

    title=''
    [ ${#title_parts[@]} -gt 0 ] && title="${title_parts[*]}"
    title="$(trim "$title")"
    if [ -z "$title" ] && [ "$quick" = true ]; then
        # Seconds, not just minutes — two `--quick` runs inside the same
        # minute would otherwise generate the same slug before the
        # collision-suffix loop below even gets a chance to kick in.
        title="Quick task — $(date '+%Y-%m-%d %H:%M:%S')"
    fi
    if [ -z "$title" ]; then
        print_error "Usage: workitem create [-q|--quick] [-b|--backlog] [-s|--slug <slug>] <title...> — title is required."
        return 1
    fi

    made=$(date +%Y-%m-%d)
    # An explicit -s/--slug is sanitized but not truncated -- it's already a
    # deliberate short name, not something derived from a long title.
    if [ -n "$slug_opt" ]; then
        slug=$(kebab "$slug_opt" 200)
    else
        slug=$(kebab "$title")
    fi
    print_debug "Creating item: slug=$slug quick=$quick backlog=$backlog"

    # Resolve a collision by appending -2, -3, ... rather than refusing --
    # once slugs are truncated/short, two unrelated titles legitimately
    # landing on the same slug is expected, not an error.
    local base="$slug"
    slug=$(wi_unique_slug "$base")
    [ "$slug" != "$base" ] && print_verbose "Slug '$base' taken — using '$slug'"

    local zone='' status='active'
    if [ "$backlog" = true ]; then
        zone='backlog/'
        status='proposed'
    fi

    itemdir="$WORK/data/items/${zone}$slug"
    file="$itemdir/$slug.md"
    mkdir -p "$itemdir"
    {
        echo "---"
        echo "title: $title"
        echo "status: $status"
        echo "made: $made"
        echo "---"
        echo
        echo "# $title"
    } > "$file"

    # --quick is meant to be consumed by scripts (workon --quick captures
    # this via command substitution) — bare slug only, no banner.
    if [ "$quick" = true ]; then
        printf '%s\n' "$slug"
    else
        print_success "Created → ${file/#$HOME/\~}"
    fi
}

wi_list() {
    local zones=() show_zone_col=false status_filter='' a
    while [ $# -gt 0 ]; do
        a=$1
        case "$a" in
            --backlog)  zones+=(backlog) ;;
            --archived) zones+=(archived) ;;
            --all)      zones=(top backlog archived); show_zone_col=true ;;
            --status)   shift; status_filter=${1:-} ;;
            --status=*) status_filter=${a#--status=} ;;
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)  print_error "Unexpected argument: $a"; return 1 ;;
        esac
        shift
    done
    [ ${#zones[@]} -eq 0 ] && zones=(top)

    local root="$WORK/data/items"
    if [ "$show_zone_col" = true ]; then
        printf '%-28s %-9s %-11s %-11s %s\n' SLUG STATUS DUE UPDATED ZONE
    else
        printf '%-28s %-9s %-11s %-11s\n' SLUG STATUS DUE UPDATED
    fi

    local zone dir itemdir slug front status due updated found=0
    for zone in "${zones[@]}"; do
        dir="$root"
        [ "$zone" != top ] && dir="$root/$zone"
        [ -d "$dir" ] || continue
        for itemdir in "$dir"/*/; do
            [ -d "$itemdir" ] || continue
            slug=$(basename "$itemdir")
            front="$itemdir$slug.md"
            [ -f "$front" ] || continue
            status=$(sed -n 's/^status: *//p' "$front" | head -1)
            [ -n "$status_filter" ] && [ "$status" != "$status_filter" ] && continue
            due=$(sed -n 's/^due: *//p' "$front" | head -1)
            updated=$(file_mtime_date "$front")
            if [ "$show_zone_col" = true ]; then
                printf '%-28s %-9s %-11s %-11s %s\n' \
                    "$(trunc "$slug" 28)" "$status" "${due:--}" "${updated:--}" "$zone"
            else
                printf '%-28s %-9s %-11s %-11s\n' \
                    "$(trunc "$slug" 28)" "$status" "${due:--}" "${updated:--}"
            fi
            found=1
        done
    done
    [ "$found" -eq 1 ] || echo "(none)"
}

wi_show() {
    local slug; slug=$(wi_one_slug show "$@") || return 1

    local root="$WORK/data/items" zone; zone=$(wi_locate "$slug")
    if [ -z "$zone" ]; then
        print_error "No item '$slug' found."; return 1
    fi
    local dir="$root/$slug"; [ "$zone" != top ] && dir="$root/$zone/$slug"
    local front="$dir/$slug.md"

    if [ -n "${PAGER:-}" ]; then
        # Intentionally unquoted: $PAGER commonly carries flags (e.g. "less -R"),
        # and quoting it would treat the whole string as one command name.
        $PAGER "$front"
    else
        cat "$front"
    fi
}

# Create a brand-new, itemless archived item as the container for a `log`
# entry that has no existing item to attach to. Mirrors wi_create's
# --quick timestamp-fallback (title) and collision-suffix loop (slug)
# exactly, but the slug is a fixed "log-<timestamp>" shape rather than a
# kebab-cased title -- there's no title to derive it from, and a fixed
# shape is what lets retrospective recognize these later.
wi_log_create_itemless() {
    local note=$1 repo=$2 commit_disp=$3

    local ts; ts=$(date +%Y-%m-%d-%H-%M-%S)
    local ts_title="${ts:0:10} ${ts:11:2}:${ts:14:2}:${ts:17:2}"

    local slug="log-$ts"
    local base="$slug"
    slug=$(wi_unique_slug "$base")
    [ "$slug" != "$base" ] && print_verbose "Slug '$base' taken — using '$slug'"

    local today; today=$(date +%Y-%m-%d)
    local title="Logged note — $ts_title"
    local itemdir="$WORK/data/items/archived/$slug"
    local file="$itemdir/$slug.md"
    mkdir -p "$itemdir"
    {
        echo "---"
        echo "title: $title"
        echo "status: completed"
        echo "made: $today"
        echo "completed: $today"
        [ -n "$repo" ] && echo "related-repos: [$repo]"
        echo "---"
        echo
        echo "# $title"
        echo
        echo "$note"
        if [ -n "$commit_disp" ]; then
            echo
            echo "Commit: $commit_disp"
        fi
    } > "$file"
    print_success "Recorded → ${file/#$HOME/\~}"
}

# Interactive picker over top-level (active/blocked) item slugs only -- not
# backlog/, not archived/. fzf if available, else a numbered-menu fallback
# in the same shape as workjot's retired choose_candidate() (copied, not
# shared -- see docs/bin-coding-standards.md's no-shared-library
# convention). Echoes the chosen slug on stdout. A clean cancel (empty fzf
# selection, or a blank answer in the fallback) prints a status line and
# returns 1 with nothing echoed -- never an error.
wi_log_pick_item() {
    local root="$WORK/data/items" slugs=() titles=() p slug title_f
    for p in "$root"/*/; do
        [ -d "$p" ] || continue
        slug=$(basename "$p")
        case "$slug" in backlog|archived) continue ;; esac
        [ -f "$p$slug.md" ] || continue
        title_f=$(sed -n 's/^title: *//p' "$p$slug.md" | head -1)
        slugs+=("$slug")
        titles+=("${title_f:-$slug}")
    done
    if [ ${#slugs[@]} -eq 0 ]; then
        print_status "No top-level items to attach to." >&2
        return 1
    fi

    if command -v fzf >/dev/null 2>&1; then
        local i entries=() choice
        for i in "${!slugs[@]}"; do
            entries+=("${slugs[$i]}  —  ${titles[$i]}")
        done
        choice=$(printf '%s\n' "${entries[@]}" | fzf --prompt='item> ') || true
        if [ -z "$choice" ]; then
            print_status "Cancelled — nothing recorded." >&2
            return 1
        fi
        printf '%s' "${choice%% *}"
    else
        local i choice
        for i in "${!slugs[@]}"; do
            printf '%2d) %s\n' "$((i + 1))" "${slugs[$i]} — ${titles[$i]}" >&2
        done
        read -r -p "Which item? [1-${#slugs[@]}, blank to cancel] " choice
        if [ -z "$choice" ]; then
            print_status "Cancelled — nothing recorded." >&2
            return 1
        fi
        if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt "${#slugs[@]}" ]; then
            print_error "Invalid selection."
            return 1
        fi
        printf '%s' "${slugs[$((choice - 1))]}"
    fi
}

# Prompt for note text; trim; error-and-return-1 if empty. Factors out a
# block that would otherwise repeat three times inside wi_log() -- a
# same-file simplification (not cross-script), so it doesn't conflict with
# the no-shared-library convention.
wi_log_read_note() {
    local note
    read -r -p "note: " note
    note="$(trim "$note")"
    if [ -z "$note" ]; then
        print_error "Empty note — nothing recorded."
        return 1
    fi
    printf '%s' "$note"
}

# Write a note into an already-resolved item's log/. Shared by both ways a
# slug can be pinned down (explicit/worktree-cwd, and picked interactively)
# so the write itself only lives in one place. Takes item_dir directly
# rather than recomputing it from slug -- a backlog/archived item's
# directory isn't $WORK/data/items/<slug>, and re-deriving that here would
# silently write to the wrong (nonexistent) path for anything not top-level.
wi_log_write_to_item() {
    local item_dir=$1 slug=$2 commit=$3
    local note; note=$(wi_log_read_note) || return 1

    local date_str; date_str=$(date +%Y-%m-%d)
    local log_dir="$item_dir/log" n nn file
    mkdir -p "$log_dir"
    n=1
    while [ -e "$log_dir/$date_str.$slug.log.$(printf '%02d' "$n").md" ]; do
        n=$((n + 1))
    done
    nn="$(printf '%02d' "$n")"
    file="$log_dir/$date_str.$slug.log.$nn.md"
    {
        echo "---"
        echo "type: workitem-log"
        echo "slug: $slug"
        echo "time: $(iso_now)"
        [ -n "$commit" ] && echo "commit: \"$commit\""
        echo "---"
        echo
        echo "# Log — $slug"
        echo
        echo "$note"
    } > "$file"
    print_success "Recorded → ${file/#$HOME/\~}"
}

wi_log() {
    local repo_opt='' slug_opt='' a
    while [ $# -gt 0 ]; do
        a=$1
        case "$a" in
            -r|--repo) shift; repo_opt=${1:-} ;;
            --repo=*)  repo_opt=${a#--repo=} ;;
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)
                if [ -z "$slug_opt" ]; then slug_opt=$a
                else print_error "Too many arguments."; return 1
                fi ;;
        esac
        shift
    done

    # --- Step 1: repo/commit context (same vault-git guard as the
    # SessionEnd hook). Independent of item resolution below -- gathered
    # here regardless of whether a slug ends up resolved at all. ---
    local gitdir='' from_cwd=false top
    if [ -n "$repo_opt" ]; then
        gitdir="$WORK/repos/$repo_opt"
        if ! git -C "$gitdir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            print_error "repos/$repo_opt is not a git repo"; return 1
        fi
    else
        top="$(git -C "$(pwd)" rev-parse --show-toplevel 2>/dev/null)"
        if [ -n "$top" ] && [ "$top" != "$WORK/data" ]; then
            gitdir="$(pwd)"
            from_cwd=true
        fi
    fi

    local commit='' rname='' br='' h='' subj=''
    if [ -n "$gitdir" ]; then
        rname=$(basename "$(git -C "$gitdir" rev-parse --show-toplevel 2>/dev/null)")
        br=$(git -C "$gitdir" rev-parse --abbrev-ref HEAD 2>/dev/null)
        h=$(git -C "$gitdir" log -1 --format=%h 2>/dev/null)
        if [ -n "$h" ]; then
            subj=$(git -C "$gitdir" log -1 --format=%s 2>/dev/null)
            print_status "Latest commit in $rname@$br:"
            echo "    $h  $subj"
            read -r -p "  Record this commit with the entry? [Y/n] " yn
            if [ -z "$yn" ] || printf '%s' "$yn" | grep -qiE '^y'; then
                commit="$rname@$br $h \"$subj\""
            fi
        fi
    fi

    # --- Step 2: target item. Explicit slug wins; else, only when context
    # came from cwd (not --repo), check whether cwd is inside a worktree
    # path -- that's the only case with a slug baked into the path at all. ---
    local slug="$slug_opt"
    if [ -z "$slug" ] && [ "$from_cwd" = true ]; then
        case "$gitdir" in
            "$WORK/worktrees/"*)
                local rest="${gitdir#"$WORK"/worktrees/}"
                slug="${rest%%/*}"
                ;;
        esac
    fi

    if [ -n "$slug" ]; then
        local root="$WORK/data/items" item_dir='' z
        for z in '' backlog/; do
            if [ -f "$root/$z$slug/$slug.md" ]; then
                item_dir="$root/$z$slug"
                break
            fi
        done
        if [ -z "$item_dir" ]; then
            if [ -f "$root/archived/$slug/$slug.md" ]; then
                print_error "'$slug' is archived — can't log to a closed item."
            else
                print_error "No item '$slug' found."
            fi
            return 1
        fi
        wi_log_write_to_item "$item_dir" "$slug" "$commit"
        return $?
    fi

    # --- Step 3: no slug resolved either way -- ask ---
    local reply
    read -r -p "Does this belong to an existing work item? [y/N] " reply
    if printf '%s' "$reply" | grep -qiE '^y'; then
        slug=$(wi_log_pick_item) || return 0
        # wi_log_pick_item only ever offers top-level slugs, so this path
        # is safe unlike the explicit-slug branch above.
        wi_log_write_to_item "$WORK/data/items/$slug" "$slug" "$commit"
    else
        local note; note=$(wi_log_read_note) || return 1
        local commit_disp=''
        [ -n "$commit" ] && commit_disp="\`$rname@$br $h\` — \"$subj\""
        wi_log_create_itemless "$note" "$rname" "$commit_disp"
    fi
}

# activate/defer/block/unblock deliberately never touch worktrees, unlike
# archive/delete: the item is staying in play, just changing zone/status,
# not leaving active circulation.

wi_activate() {
    local slug; slug=$(wi_one_slug activate "$@") || return 1

    local root="$WORK/data/items" zone; zone=$(wi_locate "$slug")
    if [ "$zone" != backlog ]; then
        case "$zone" in
            top)      print_error "'$slug' is already top-level (not in backlog)." ;;
            archived) print_error "'$slug' is archived — not in backlog." ;;
            *)        print_error "No item '$slug' found in items/backlog/." ;;
        esac
        return 1
    fi

    local srcdir="$root/backlog/$slug"
    transition_status "$srcdir/$slug.md" active '' "$root/$slug" || return 1
    print_success "Activated → items/$slug (active)"
}

wi_defer() {
    local slug; slug=$(wi_one_slug defer "$@") || return 1

    local root="$WORK/data/items" zone; zone=$(wi_locate "$slug")
    if [ "$zone" != top ]; then
        case "$zone" in
            backlog)  print_error "'$slug' is already in backlog." ;;
            archived) print_error "'$slug' is archived — not top-level." ;;
            *)        print_error "No item '$slug' found at top level." ;;
        esac
        return 1
    fi

    local srcdir="$root/$slug"
    transition_status "$srcdir/$slug.md" deferred '' "$root/backlog/$slug" || return 1
    print_success "Deferred → items/backlog/$slug (deferred)"
}

wi_block() {
    local slug; slug=$(wi_one_slug block "$@") || return 1

    local root="$WORK/data/items" zone; zone=$(wi_locate "$slug")
    if [ "$zone" != top ]; then
        case "$zone" in
            backlog)  print_error "'$slug' is in backlog — block only applies to top-level items." ;;
            archived) print_error "'$slug' is archived — block only applies to top-level items." ;;
            *)        print_error "No item '$slug' found at top level." ;;
        esac
        return 1
    fi

    local srcdir="$root/$slug"
    local front="$srcdir/$slug.md"
    local status; status=$(sed -n 's/^status: *//p' "$front" | head -1)
    case "$status" in
        blocked) print_error "'$slug' is already blocked."; return 1 ;;
        active)  ;;
        *) print_error "'$slug' has status '$status', not active — refusing to override."; return 1 ;;
    esac

    transition_status "$front" blocked || return 1
    print_success "Blocked '$slug' (active → blocked)"
}

wi_unblock() {
    local slug; slug=$(wi_one_slug unblock "$@") || return 1

    local root="$WORK/data/items" zone; zone=$(wi_locate "$slug")
    if [ "$zone" != top ]; then
        case "$zone" in
            backlog)  print_error "'$slug' is in backlog — unblock only applies to top-level items." ;;
            archived) print_error "'$slug' is archived — unblock only applies to top-level items." ;;
            *)        print_error "No item '$slug' found at top level." ;;
        esac
        return 1
    fi

    local srcdir="$root/$slug"
    local front="$srcdir/$slug.md"
    local status; status=$(sed -n 's/^status: *//p' "$front" | head -1)
    case "$status" in
        active)  print_error "'$slug' is not blocked (status: active)."; return 1 ;;
        blocked) ;;
        *) print_error "'$slug' has status '$status', not blocked — refusing to override."; return 1 ;;
    esac

    transition_status "$front" active || return 1
    print_success "Unblocked '$slug' (blocked → active)"
}

# Shared by wi_complete/wi_cancel: locate the item (top-level only --
# a backlog item never became active work, so completing/cancelling it
# makes no sense; activate it first, or delete it if it's not going
# anywhere. already-archived is a hard error too, not a no-op, since
# re-finishing a closed item makes no sense), stamp status + completed:,
# move to archived/, and remove any worktree(s). newstatus is 'completed'
# or 'cancelled'.
wi_finish() {
    local slug=$1 newstatus=$2

    local root="$WORK/data/items" srcdir='' zone; zone=$(wi_locate "$slug")
    case "$zone" in
        top)      srcdir="$root/$slug" ;;
        backlog)  print_error "'$slug' is in backlog — activate it first, or 'workitem delete' it if it's not going anywhere."; return 1 ;;
        archived) print_error "'$slug' is already archived."; return 1 ;;
        *)        print_error "No item '$slug' found at top level."; return 1 ;;
    esac
    print_verbose "Found item at ${srcdir/#$HOME/\~}"

    local front="$srcdir/$slug.md"
    local destdir="$root/archived/$slug"

    transition_status "$front" "$newstatus" completed "$destdir" || return 1

    if [ -d "$WORK/worktrees/$slug" ]; then
        print_status "Removing worktree(s) for '$slug' ..."
        worktree rm "$slug" --delete-branch || print_warning "worktree rm failed — clean it up by hand."
    fi

    print_success "Archived → items/archived/$slug ($newstatus)"
}

wi_complete() {
    local slug; slug=$(wi_one_slug complete "$@") || return 1
    wi_finish "$slug" completed
}

wi_cancel() {
    local slug; slug=$(wi_one_slug cancel "$@") || return 1
    wi_finish "$slug" cancelled
}

wi_delete() {
    local slug='' force=false a
    for a in "$@"; do
        case "$a" in
            --force) force=true ;;
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)
                if [ -z "$slug" ]; then slug=$a
                else print_error "Too many arguments."; return 1
                fi ;;
        esac
    done
    if [ -z "$slug" ]; then
        print_error "Usage: workitem delete <slug> [--force]"; return 1
    fi

    local root="$WORK/data/items" srcdir='' zone; zone=$(wi_locate "$slug")
    case "$zone" in
        top)      srcdir="$root/$slug" ;;
        backlog)  srcdir="$root/backlog/$slug" ;;
        archived) srcdir="$root/archived/$slug" ;;
        *)        print_error "No item '$slug' found."; return 1 ;;
    esac
    print_verbose "Found item at ${srcdir/#$HOME/\~}"

    # Deletion (not archiving) is a deliberate, narrow exception — see the
    # root CLAUDE.md's "nothing is deleted" principle. Always requires
    # --force, an explicit admission that there's real content being thrown
    # away. workon's own post-session sweep passes --force itself, having
    # already verified the item accumulated nothing durable — this guard is
    # for a human typing the command by hand.
    if [ "$force" != true ]; then
        print_error "Refusing to delete '$slug' without --force."
        return 1
    fi

    if [ -d "$WORK/worktrees/$slug" ]; then
        print_status "Removing worktree(s) for '$slug' ..."
        worktree rm "$slug" --delete-branch || print_warning "worktree rm failed — clean it up by hand."
    fi

    rm -rf "$srcdir"
    print_success "Deleted ${srcdir/#$HOME/\~}"
}

###
### Dispatch
###
# Parse global options before the subcommand so `workitem -v list` works.
# -d implies -v.
# shellcheck disable=SC2034  # VERBOSE/DEBUG are read by print_* in lib.sh
while [ $# -gt 0 ]; do
    case "$1" in
        -v|--verbose) VERBOSE=true; shift ;;
        -d|--debug)   DEBUG=true; VERBOSE=true; shift ;;
        -h|--help|help) printf '%s\n' "$usage"; exit 0 ;;
        *) break ;;
    esac
done

cmd="${1:-}"
[ "$#" -gt 0 ] && shift
case "$cmd" in
    create)   wi_create "$@" ;;
    list)     wi_list "$@" ;;
    show)     wi_show "$@" ;;
    log)      wi_log "$@" ;;
    activate) wi_activate "$@" ;;
    defer)    wi_defer "$@" ;;
    block)    wi_block "$@" ;;
    unblock)  wi_unblock "$@" ;;
    complete) wi_complete "$@" ;;
    cancel)   wi_cancel "$@" ;;
    delete)   wi_delete "$@" ;;
    '')       printf '%s\n' "$usage" ;;
    *)        print_error "Unknown command '$cmd' (try: workitem help)"; exit 1 ;;
esac
