#!/usr/bin/env bash
#
# workjot — create, list, edit, and delete ad-hoc work notes ("jots").
#
# Engine tool for the work system. Lives at ~/work/engine/bin/workjot (the
# work-engine repo, on PATH). Companion completion:
# ~/work/engine/bin/completions/workjot.fish.
#
# A jot tagged to a work item (-i/--item) is one piece of that item's own
# record — it's written as a dated file into items/<slug>/log/, the sparse
# end of the same timeline session breadcrumbs occupy at the rich end. An
# untagged jot has no item to belong to and lands in the top-level, itemless
# ~/work/data/jots/YYYY/MM/DD/<date>.log.md instead. See items/CLAUDE.md and
# jots/CLAUDE.md.
#
# Jots are append-only by default. `edit`/`delete` are narrow, tooled
# exceptions — edit adds follow-up context after the fact, delete is a
# confirm-gated removal for outright mistakes. Neither is a general
# rewrite-history tool.
#

set -u

WORK="${WORK_ROOT:-$HOME/work}"

###
### Output functions
###
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NORMAL='\033[0m'
VERBOSE=false
DEBUG=false

print_status()  { echo -e "${BLUE}[INFO]${NORMAL} $1"; }
print_success() { echo -e "${GREEN}[SUCCESS]${NORMAL} $1"; }
print_warning() { echo -e "${YELLOW}[WARNING]${NORMAL} $1" >&2; }
print_error()   { echo -e "${RED}[ERROR]${NORMAL} $1" >&2; }
print_verbose() { [ "$VERBOSE" = true ] && echo -e "${BLUE}[VERBOSE]${NORMAL} $1" >&2 || true; }
print_debug()   { [ "$DEBUG" = true ] && echo -e "${BLUE}[DEBUG]${NORMAL} $1" >&2 || true; }

IFS='' read -r -d '' usage <<"EOF"

workjot: create, list, edit, delete, and tag ad-hoc work notes ("jots")

Usage:
   workjot [ -h|--help ]
   workjot [ -v|--verbose ] [ -d|--debug ] create [-r|--repo <repo>] [-i|--item <slug>]
   workjot [ -v|--verbose ] [ -d|--debug ] list   [--on <date>|--since <date>]
   workjot [ -v|--verbose ] [ -d|--debug ] edit   [--on <date>]
   workjot [ -v|--verbose ] [ -d|--debug ] delete [--on <date>]
   workjot [ -v|--verbose ] [ -d|--debug ] tag    [--on <date>] [item-slug]

Arguments:
   -h|--help         Show what you are seeing right now
   -v|--verbose      Show what is happening as it happens
   -d|--debug        Show diagnostic detail (implies --verbose)

Description:
   create   Creates a new work entry for a given work item, or if not associated
            with an item, into the jots/ directory (by date). If --repo is given, 
            the latest commit in that repo will be included as context.

   list     Show untagged jots from jots/, defaulting to today. --on <date>
            shows one specific day; --since <date> shows a range from that
            day through today. 

   edit     Add follow-up context to an existing untagged jot — not a
            rewrite, an append. Lists candidates for the given date
            (default: today), asks which one, then appends the follow-up
            text. 

   delete   Deletes an untagged jot outright

   tag      Retroactively attribute an existing untagged jot to a work item

Examples:
   workjot create
   workjot create -i nagios
   workjot create -r Ansible
   workjot list
   workjot list --since 2026-07-01
   workjot edit --on 2026-07-10
   workjot delete
   workjot tag ad-upgrade
   workjot tag --on 2026-07-01

EOF

trim() { printf '%s' "$1" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'; }

# ISO 8601 with a colon in the TZ offset (matches the vault convention).
iso_now() {
    local t
    t="$(date +%Y-%m-%dT%H:%M:%S%z)"
    printf '%s' "$t" | sed -E 's/([0-9]{2})([0-9]{2})$/\1:\2/'
}

# Resolve a slug to its zone directory, if the item exists as a real
# directory item (front door present). Echoes the path and returns 0 if
# found; returns 1 with no output otherwise.
resolve_item_dir() {
    local slug=$1 z
    for z in '' backlog/ archived/; do
        if [ -f "$WORK/data/items/$z$slug/$slug.md" ]; then
            printf '%s' "$WORK/data/items/$z$slug"
            return 0
        fi
    done
    return 1
}

# Populate parallel arrays (path, lineno, label) with jot-bullet candidates
# (from a jots/ day-log) for the given single date. Once a jot is tagged
# into an item's log/ (via `create -i` or `tag`), it's no longer a jot --
# it's that item's history from then on, and workjot stops managing it
# entirely (no list/edit/delete). So this only ever looks at jots/.
# Shared by wj_edit, wj_delete, and wj_tag.
collect_candidates() {
    local on_date=$1
    path=(); lineno=(); label=()

    local logf="$WORK/data/jots/${on_date:0:4}/${on_date:5:2}/${on_date:8:2}/$on_date.log.md"
    if [ -e "$logf" ]; then
        local n=0 line
        while IFS= read -r line; do
            n=$((n + 1))
            case "$line" in
                '- '*)
                    path+=("$logf"); lineno+=("$n")
                    label+=("${line#- }") ;;
            esac
        done < "$logf"
    fi
}

# Print numbered candidates, prompt for a selection, echo the 0-based index
# on stdout. Returns 1 (nothing echoed) on an invalid or empty choice.
choose_candidate() {
    local prompt=$1 i
    for i in "${!label[@]}"; do
        printf '%2d) %s\n' "$((i + 1))" "${label[$i]}" >&2
    done
    read -r -p "$prompt [1-${#label[@]}] " choice
    if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt "${#label[@]}" ]; then
        print_error "Invalid selection."
        return 1
    fi
    printf '%s' "$((choice - 1))"
}

###
### Subcommands
###
wj_create() {
    local repo_opt='' item_opt='' a
    while [ $# -gt 0 ]; do
        a=$1
        case "$a" in
            -r|--repo) shift; repo_opt=${1:-} ;;
            --repo=*)  repo_opt=${a#--repo=} ;;
            -i|--item) shift; item_opt=${1:-} ;;
            --item=*)  item_opt=${a#--item=} ;;
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)  print_error "workjot create takes no positional arguments — it always prompts for the note."; return 1 ;;
        esac
        shift
    done
    print_debug "Options: repo=${repo_opt:-<none>} item=${item_opt:-<none>}"

    # --- git context (same vault-git guard as the SessionEnd hook) ---
    local gitdir='' top
    if [ -n "$repo_opt" ]; then
        gitdir="$WORK/repos/$repo_opt"
        if ! git -C "$gitdir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            print_error "repos/$repo_opt is not a git repo"; return 1
        fi
        print_verbose "Git dir: $gitdir (explicit --repo)"
    else
        top="$(git -C "$(pwd)" rev-parse --show-toplevel 2>/dev/null)"
        if [ -n "$top" ] && [ "$top" != "$WORK/data" ]; then
            gitdir="$(pwd)"
            print_verbose "Git dir: $gitdir (cwd)"
        fi
    fi

    local commit=''
    if [ -n "$gitdir" ]; then
        local h subj br rname
        h=$(git -C "$gitdir" log -1 --format=%h 2>/dev/null)
        if [ -n "$h" ]; then
            subj=$(git -C "$gitdir" log -1 --format=%s 2>/dev/null)
            br=$(git -C "$gitdir" rev-parse --abbrev-ref HEAD 2>/dev/null)
            rname=$(basename "$(git -C "$gitdir" rev-parse --show-toplevel 2>/dev/null)")
            print_status "Latest commit in $rname@$br:"
            echo "    $h  $subj"
            read -r -p "  Record this commit with the jot? [Y/n] " yn
            if [ -z "$yn" ] || printf '%s' "$yn" | grep -qiE '^y'; then
                commit="$rname@$br $h \"$subj\""
            fi
        fi
    fi
    print_debug "Commit attached: ${commit:-<none>}"

    # --- note text: always prompted, never positional ---
    local note
    read -r -p "jot: " note
    note="$(trim "$note")"
    if [ -z "$note" ]; then
        print_error "Empty note — nothing recorded."; return 1
    fi

    # --- item attribution ---
    local item="$item_opt"
    if [ -z "$item" ]; then
        read -r -p "attribute to item (slug, blank for none): " item
        item="$(trim "$item")"
    fi

    local item_dir=''
    if [ -n "$item" ]; then
        item_dir="$(resolve_item_dir "$item")" || {
            print_warning "'$item' isn't an existing item — recording as untagged instead. (Run 'workitem create $item' first if you want it attributed.)"
            item=''
        }
    fi
    print_verbose "Attribution: ${item:-<untagged>}${item_dir:+ ($item_dir)}"

    local date_str; date_str=$(date +%Y-%m-%d)

    if [ -n "$item" ]; then
        # --- tagged: one more dated file in the item's own log/ ---
        local log_dir="$item_dir/log" n nn file
        mkdir -p "$log_dir"
        n=1
        while [ -e "$log_dir/$date_str.$item.jot.$(printf '%02d' "$n").md" ]; do
            n=$((n + 1))
        done
        nn="$(printf '%02d' "$n")"
        file="$log_dir/$date_str.$item.jot.$nn.md"
        {
            echo "---"
            echo "type: jot"
            echo "slug: $item"
            echo "time: $(iso_now)"
            [ -n "$commit" ] && echo "commit: \"$commit\""
            echo "---"
            echo
            echo "# Jot — $item"
            echo
            echo "$note"
        } > "$file"
        print_success "Recorded → ${file/#$HOME/\~}"
    else
        # --- untagged: append to the day's itemless jots/ log ---
        local day_dir="$WORK/data/jots/$(date +%Y)/$(date +%m)/$(date +%d)" log line
        mkdir -p "$day_dir"
        log="$day_dir/$date_str.log.md"
        if [ ! -e "$log" ]; then
            printf -- '---\ntype: jot-log\ndate: %s\n---\n\n# Jot log — %s\n\n' "$date_str" "$date_str" > "$log"
        fi
        line="- $(date +%H:%M) — $note"
        [ -n "$commit" ] && line="$line ($commit)"
        printf '%s\n' "$line" >> "$log"
        print_success "Recorded → ${log/#$HOME/\~}"
        echo "  $line"
    fi
}

wj_list() {
    local on_date='' since_date='' a
    while [ $# -gt 0 ]; do
        a=$1
        case "$a" in
            --on)      shift; on_date=${1:-} ;;
            --on=*)    on_date=${a#--on=} ;;
            --since)   shift; since_date=${1:-} ;;
            --since=*) since_date=${a#--since=} ;;
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)  print_error "Unexpected argument: $a"; return 1 ;;
        esac
        shift
    done
    if [ -n "$on_date" ] && [ -n "$since_date" ]; then
        print_error "--on and --since are mutually exclusive."; return 1
    fi

    local today; today=$(date +%Y-%m-%d)
    local from_date="${since_date:-${on_date:-$today}}"
    local to_date="${on_date:-$today}"
    print_debug "Window: from=$from_date to=$to_date"
    # String compare is safe here: YYYY-MM-DD sorts lexicographically the
    # same as chronologically, so no date-arithmetic/portability concerns.
    in_range() { [[ "$1" > "$from_date" || "$1" == "$from_date" ]] && [[ "$1" < "$to_date" || "$1" == "$to_date" ]]; }

    local found=0 logf date_part line

    # jots/ only -- a jot tagged into an item's log/ (via `create -i` or
    # `tag`) stops being a jot at that point; browse it via `workitem show`
    # or the item's own log/ instead.
    for logf in "$WORK"/data/jots/*/*/*/*.log.md; do
        [ -e "$logf" ] || continue
        date_part=$(basename "$logf" .log.md)
        in_range "$date_part" || continue
        while IFS= read -r line; do
            [ -n "$line" ] || continue
            printf '%s  %s\n' "$date_part" "$line"
            found=1
        done < <(sed -n 's/^- //p' "$logf")
    done

    [ "$found" -eq 1 ] || echo "(none)"
}

wj_edit() {
    local on_date='' a
    while [ $# -gt 0 ]; do
        a=$1
        case "$a" in
            --on)      shift; on_date=${1:-} ;;
            --on=*)    on_date=${a#--on=} ;;
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)  print_error "Unexpected argument: $a"; return 1 ;;
        esac
        shift
    done
    on_date="${on_date:-$(date +%Y-%m-%d)}"
    print_debug "Date: $on_date"

    local path=() lineno=() label=()
    collect_candidates "$on_date"
    print_debug "Candidates: ${#label[@]}"
    if [ ${#label[@]} -eq 0 ]; then
        print_error "No jots found for $on_date."; return 1
    fi

    local idx
    idx=$(choose_candidate "Which jot to amend?") || return 1

    read -r -p "Follow-up to add: " followup
    followup="$(trim "$followup")"
    if [ -z "$followup" ]; then
        print_error "Empty follow-up — nothing changed."; return 1
    fi

    local f=${path[$idx]} n=${lineno[$idx]} tmp
    tmp=$(mktemp)
    awk -v n="$n" -v add=" — update: $followup" \
        'NR == n { $0 = $0 add } { print }' "$f" > "$tmp"
    mv "$tmp" "$f"
    print_success "Amended line $n of ${f/#$HOME/\~}"
}

wj_delete() {
    local on_date='' a
    while [ $# -gt 0 ]; do
        a=$1
        case "$a" in
            --on)      shift; on_date=${1:-} ;;
            --on=*)    on_date=${a#--on=} ;;
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)  print_error "Unexpected argument: $a"; return 1 ;;
        esac
        shift
    done
    on_date="${on_date:-$(date +%Y-%m-%d)}"
    print_debug "Date: $on_date"

    local path=() lineno=() label=()
    collect_candidates "$on_date"
    print_debug "Candidates: ${#label[@]}"
    if [ ${#label[@]} -eq 0 ]; then
        print_error "No jots found for $on_date."; return 1
    fi

    local idx
    idx=$(choose_candidate "Which jot to delete?") || return 1

    print_warning "About to permanently delete: ${label[$idx]}"
    read -r -p "This cannot be undone. Delete? [y/N] " yn
    if ! printf '%s' "$yn" | grep -qiE '^y'; then
        print_status "Cancelled — nothing deleted."; return 0
    fi

    local f=${path[$idx]} n=${lineno[$idx]} tmp
    tmp=$(mktemp)
    awk -v n="$n" 'NR != n' "$f" > "$tmp"
    mv "$tmp" "$f"
    print_success "Deleted line $n of ${f/#$HOME/\~}"
}

wj_tag() {
    local on_date='' item_opt='' a
    while [ $# -gt 0 ]; do
        a=$1
        case "$a" in
            --on) shift; on_date=${1:-} ;;
            --on=*) on_date=${a#--on=} ;;
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)
                if [ -z "$item_opt" ]; then item_opt=$a
                else print_error "Too many arguments."; return 1
                fi ;;
        esac
        shift
    done
    on_date="${on_date:-$(date +%Y-%m-%d)}"
    print_debug "Date: $on_date item=${item_opt:-<none>}"

    local path=() lineno=() label=()
    collect_candidates "$on_date"
    print_debug "Candidates: ${#label[@]}"
    if [ ${#label[@]} -eq 0 ]; then
        print_error "No jots found for $on_date."; return 1
    fi

    local idx
    idx=$(choose_candidate "Which jot to tag?") || return 1

    local item="$item_opt"
    if [ -z "$item" ]; then
        read -r -p "tag to item (slug): " item
        item="$(trim "$item")"
    fi
    if [ -z "$item" ]; then
        print_error "No item given — nothing tagged."; return 1
    fi
    local item_dir
    item_dir="$(resolve_item_dir "$item")" || {
        print_error "'$item' isn't an existing item. Run 'workitem create $item' first."; return 1
    }

    local f=${path[$idx]} n=${lineno[$idx]}
    local raw="${label[$idx]}"
    # raw is "HH:MM — note text (optionally, a commit clause)" -- kept
    # whole as the note body rather than trying to split out the commit
    # clause; a regex split risks mis-parsing a note that itself contains
    # parentheses, and nothing is lost by keeping it as plain text.
    local hhmm="${raw%% —*}" note="${raw#*— }"

    local log_dir="$item_dir/log" newn nn file
    mkdir -p "$log_dir"
    newn=1
    while [ -e "$log_dir/$on_date.$item.jot.$(printf '%02d' "$newn").md" ]; do
        newn=$((newn + 1))
    done
    nn="$(printf '%02d' "$newn")"
    file="$log_dir/$on_date.$item.jot.$nn.md"
    {
        echo "---"
        echo "type: jot"
        echo "slug: $item"
        echo "time: ${on_date}T${hhmm}:00$(date +%z | sed -E 's/([0-9]{2})([0-9]{2})$/\1:\2/')"
        echo "---"
        echo
        echo "# Jot — $item"
        echo
        echo "$note"
    } > "$file"

    local tmp; tmp=$(mktemp)
    awk -v n="$n" 'NR != n' "$f" > "$tmp"
    mv "$tmp" "$f"

    print_success "Tagged → ${file/#$HOME/\~}"
    print_status "Removed from ${f/#$HOME/\~}"
}

###
### Dispatch
###
# Parse global options before the subcommand so `workjot -v create` works.
# -d implies -v.
while [ $# -gt 0 ]; do
    case "$1" in
        -v|--verbose) VERBOSE=true; shift ;;
        -d|--debug)   DEBUG=true; VERBOSE=true; shift ;;
        -h|--help|help) printf '%s\n' "$usage"; exit 0 ;;
        *) break ;;
    esac
done

cmd="${1:-}"
[ "$#" -gt 0 ] && shift
case "$cmd" in
    create) wj_create "$@" ;;
    list)   wj_list "$@" ;;
    edit)   wj_edit "$@" ;;
    delete) wj_delete "$@" ;;
    tag)    wj_tag "$@" ;;
    '')     printf '%s\n' "$usage" ;;
    *)      print_error "Unknown command '$cmd' (try: workjot help)"; exit 1 ;;
esac
