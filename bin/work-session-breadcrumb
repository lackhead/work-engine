#!/usr/bin/env bash
#
# work-session-breadcrumb — Claude Code SessionEnd hook.
#
# Install at ~/.claude/hooks/work-session-breadcrumb (chmod +x) and register
# it in ~/.claude/settings.json (see the companion settings snippet).
#
# On session end it reads the SessionEnd JSON from stdin, and IF the session's
# cwd is inside the ~/work system (an item folder — workon always starts a
# session there now, never inside a worktree directly), writes a factual
# "breadcrumb" into the diary, aggregated across every worktree the item has:
#
#   ~/work/data/diary/YYYY/MM/DD/<date>.<slug>.session.NN.md
#
# It is a user-global hook, so it fires for EVERY Claude Code session; for any
# session not under ~/work it exits silently without writing anything.
#
# Deliberately dumb: it records git/session facts only. Curated, human-framed
# progress is written separately (the retrospective skill), never here.

# Never let a hook failure be noisy or disruptive; SessionEnd ignores our exit
# code anyway, but be tidy.
set -u
# Vault root: honor $WORK_ROOT if set, else default to ~/work. The default is
# the permanent mechanism — the var only needs setting if a second instance
# coexists on one machine. The hook runs under Claude Code's environment (not
# your interactive shell), so it cannot assume $WORK_ROOT is exported — hence
# the fallback.
WORK="${WORK_ROOT:-$HOME/work}"

# --- read stdin payload --------------------------------------------------
PAYLOAD="$(cat 2>/dev/null)"
[ -n "$PAYLOAD" ] || exit 0

# Extract a top-level string field from the payload (jq if available, else sed).
field() {
    if command -v jq >/dev/null 2>&1; then
        printf '%s' "$PAYLOAD" | jq -r --arg k "$1" '.[$k] // empty' 2>/dev/null
    else
        printf '%s' "$PAYLOAD" \
            | sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" \
            | head -n1
    fi
}

cwd="$(field cwd)"
session_id="$(field session_id)"
transcript="$(field transcript_path)"
reason="$(field reason)"
[ -n "$cwd" ] || exit 0

# --- quick-item helpers ---------------------------------------------------
# A `workon --quick` item is tagged `tags: [quick]` in its frontmatter
# (bin/workitem's wi_create --quick). Only items carrying that tag are ever
# candidates for the auto-archive below — git cleanliness alone never
# triggers it, so a normal item with a no-op planning session is untouched.
is_quick_item() {
    local front="$WORK/data/items/$1/$1.md"
    [ -f "$front" ] || return 1
    grep -qE '^tags:.*\bquick\b' "$front" 2>/dev/null
}

# True if the item folder holds anything beyond its own front-door file
# (plan.md, status/, notes dropped in by hand) — i.e. work happened there
# even if no repo was ever touched.
has_extra_item_files() {
    local dir="$WORK/data/items/$1"
    [ -d "$dir" ] || return 1
    find "$dir" -mindepth 1 ! -name "$1.md" 2>/dev/null | grep -q .
}

# --- derive the slug from the cwd -----------------------------------------
# cwd is always an item folder now — workon never launches a session with cwd
# inside a worktree directly. (A hand-launched session started that way,
# bypassing workon, would simply not match any case below and fall through
# to the catch-all — nothing has ever actually done this.)
slug=""
case "$cwd" in
    "$WORK/data/items/backlog/"*) rest="${cwd#"$WORK"/data/items/backlog/}";  slug="${rest%%/*}" ;;
    "$WORK/data/items/archived/"*) rest="${cwd#"$WORK"/data/items/archived/}"; slug="${rest%%/*}" ;;
    "$WORK/data/items/"*)          rest="${cwd#"$WORK"/data/items/}";          slug="${rest%%/*}" ;;
    *) exit 0 ;;
esac
[ -n "$slug" ] || exit 0

# --- timestamps ----------------------------------------------------------
# ISO 8601 with a colon in the TZ offset (matches the vault convention).
iso_now() {
    local t
    t="$(date +%Y-%m-%dT%H:%M:%S%z)"
    printf '%s' "$t" | sed -E 's/([0-9]{2})([0-9]{2})$/\1:\2/'
}
end_ts="$(iso_now)"

# Session window start = timestamp of the first *timestamped* transcript
# line. NOT necessarily line 1 — Claude Code now leads a transcript with a
# few untimestamped metadata records (mode, permission-mode,
# file-history-snapshot, ...) before the first real message, so a bare
# `head -n1` silently yields empty here. An empty start_ts zeroes out every
# repo's commit/file counts below (the `[ -n "$start_ts" ]` guards), which in
# turn blocks the auto-archive sweep for any quick item with an attached
# repo — accidentally fail-safe, but only by luck.
start_ts=""
if [ -n "$transcript" ] && [ -r "$transcript" ]; then
    if command -v jq >/dev/null 2>&1; then
        start_ts="$(jq -r '.timestamp // empty' "$transcript" 2>/dev/null | grep -m1 .)"
    else
        start_ts="$(sed -n 's/.*"timestamp"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$transcript" 2>/dev/null | head -n1)"
    fi
fi

# --- git facts across every worktree the item has -------------------------
# No vault-git guard needed here (unlike an item-folder cwd, which can
# resolve *up* into ~/work/data's own git repo) — each worktree directory has
# its own .git that shadows the vault, so `git -C <worktree>` always resolves
# to the worktree itself. See docs/bin-coding-standards.md.
wtbase="$WORK/worktrees/$slug"
repos_touched=()
agg_dirty=false
agg_commits=0
agg_files=0
body_repos=""
if [ -d "$wtbase" ]; then
    for d in "$wtbase"/*/; do
        [ -d "$d" ] || continue
        repo=$(basename "$d")
        branch=$(git -C "$d" rev-parse --abbrev-ref HEAD 2>/dev/null)
        repo_dirty=false
        [ -n "$(git -C "$d" status --porcelain 2>/dev/null)" ] && repo_dirty=true

        repo_commits=''
        repo_files=''
        if [ -n "$start_ts" ]; then
            repo_commits="$(git -C "$d" log --since="$start_ts" --pretty=format:'%h %s' 2>/dev/null)"
            repo_files="$(git -C "$d" log --since="$start_ts" --name-only --pretty=format: 2>/dev/null \
                         | sed '/^[[:space:]]*$/d' | sort -u)"
        fi
        repo_commit_count=0
        [ -n "$repo_commits" ] && repo_commit_count="$(printf '%s\n' "$repo_commits" | grep -c .)"
        repo_files_count=0
        [ -n "$repo_files" ] && repo_files_count="$(printf '%s\n' "$repo_files" | grep -c .)"

        repos_touched+=("$repo")
        [ "$repo_dirty" = true ] && agg_dirty=true
        # Plain arithmetic, never inside a `| while read` — bash runs a
        # pipeline's right-hand side in a subshell here (no `shopt -s
        # lastpipe`), so accumulating inside one would silently discard
        # every increment once the subshell exits.
        agg_commits=$((agg_commits + repo_commit_count))
        agg_files=$((agg_files + repo_files_count))

        body_repos="${body_repos}## \`$repo\`"$'\n\n'
        body_repos="${body_repos}\`$branch\` — $repo_commit_count commit(s), $repo_files_count file(s) changed"
        [ "$repo_dirty" = true ] && body_repos="${body_repos}, uncommitted changes present"
        body_repos="${body_repos}."$'\n\n'
        if [ "$repo_commit_count" -gt 0 ]; then
            body_repos="${body_repos}### Commits"$'\n\n'
            body_repos="${body_repos}$(printf '%s\n' "$repo_commits" | sed 's/^/- /')"$'\n\n'
        fi
        if [ "$repo_files_count" -gt 0 ]; then
            body_repos="${body_repos}### Files changed"$'\n\n'
            body_repos="${body_repos}$(printf '%s\n' "$repo_files" | sed 's/^/- `/; s/$/`/')"$'\n\n'
        fi
    done
fi

# --- choose the diary path + NN ------------------------------------------
day_dir="$WORK/data/diary/$(date +%Y)/$(date +%m)/$(date +%d)"
mkdir -p "$day_dir" 2>/dev/null || exit 0
date_str="$(date +%Y-%m-%d)"
n=1
while [ -e "$day_dir/$date_str.$slug.session.$(printf '%02d' "$n").md" ]; do
    n=$((n + 1))
done
nn="$(printf '%02d' "$n")"
file="$day_dir/$date_str.$slug.session.$nn.md"

# --- write the breadcrumb ------------------------------------------------
{
    echo "---"
    echo "type: session-breadcrumb"
    echo "slug: $slug"
    [ -n "$session_id" ] && echo "session-id: $session_id"
    echo "session-num: \"$nn\""
    [ -n "$start_ts" ] && echo "start: $start_ts"
    echo "end: $end_ts"
    if [ ${#repos_touched[@]} -gt 0 ]; then
        present=$(printf '%s, ' "${repos_touched[@]}"); present=${present%, }
        echo "repos: [$present]"
    fi
    echo "dirty: $agg_dirty"
    echo "commits: $agg_commits"
    echo "files-changed: $agg_files"
    [ -n "$reason" ] && echo "reason: $reason"
    [ -n "$transcript" ] && echo "transcript: $transcript"
    echo "---"
    echo
    echo "# Session — $slug"
    echo

    if [ ${#repos_touched[@]} -gt 0 ]; then
        printf 'Session on `%s` — %d repo(s), %s commit(s), %s file(s) changed' \
            "$slug" "${#repos_touched[@]}" "$agg_commits" "$agg_files"
        [ "$agg_dirty" = true ] && printf ', uncommitted changes present'
        echo "."
        echo
        printf '%s' "$body_repos"
    else
        echo "Item-folder session on \`$slug\` (no worktree — planning/tracking)."
        echo
    fi
} > "$file" 2>/dev/null

# --- sweep a clean --quick item -------------------------------------------
# Nothing landed anywhere for this session: no dirty/committed changes in any
# attached repo (or no repo at all — agg_dirty/agg_commits are already
# false/0 in that case) and nothing added to the item folder itself. Archive
# it the same way `workitem archive <slug> --completed` always does — moves
# it under items/archived/ and removes its worktree(s) — so quick items never
# need to be remembered or cleaned up by hand. Real work is left untouched.
#
# Each repo's commit count is windowed by `start_ts` (parsed from the
# transcript's first line, above) — if there's at least one repo but
# `start_ts` couldn't be read, the aggregate commit count is unreliable
# (stays 0 even if commits happened), so a missing start_ts blocks the sweep
# rather than being trusted as "clean".
if is_quick_item "$slug" \
   && [ "$agg_dirty" != true ] && [ "$agg_commits" -eq 0 ] \
   && { [ ${#repos_touched[@]} -eq 0 ] || [ -n "$start_ts" ]; } \
   && ! has_extra_item_files "$slug"; then
    workitem archive "$slug" --completed >/dev/null 2>&1
fi

exit 0
