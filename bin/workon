#!/usr/bin/env bash
#
# workon — open a Claude Code session for a work item, in the right place.
#
# Engine tool for the work system. Lives at ~/work/engine/bin/workon (the
# work-engine repo); ~/work/engine/bin is on PATH. Companion completions live
# at ~/work/engine/bin/completions/workon.fish.
#
# Model: the item's own folder (data/items/<slug>/) is always the session's
# working directory — never a specific repo's worktree. Every worktree the
# item has (zero, one, or several) is attached alongside it as its own
# --add-dir, all equally reachable; there's no "pick one to open." -r/--repo
# ensures a worktree exists (idempotent) and attaches it; an unknown slug
# offers to create the item first.
#
# NOTE (isolated-claude-workspace): the launch step at the bottom runs Claude
# inside the persistent sandbox container via `docker exec` (Phase 1 wiring). All
# the item/worktree resolution above is host-side and unchanged; only the final
# launch — and the resume probe that feeds it — target the container.
#
# Deliberately NOT `exec`'d into the final `docker exec` — this process stays
# alive as the session's parent so it can do post-session bookkeeping (the
# --quick sweep, below) once the container session ends, host-side, after
# Claude's own TUI has fully torn down. That's the whole point: the command
# line here is for managing work (create/start/end); the sandbox is where the
# work itself happens. The cost is one idle bash process for the life of the
# session — negligible next to what it buys.
#

set -u

WORK="${WORK_ROOT:-$HOME/work}"

###
### Output functions
###
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NORMAL='\033[0m'
VERBOSE=false
DEBUG=false

print_status()  { echo -e "${BLUE}[INFO]${NORMAL} $1"; }
print_success() { echo -e "${GREEN}[SUCCESS]${NORMAL} $1"; }
print_warning() { echo -e "${YELLOW}[WARNING]${NORMAL} $1" >&2; }
print_error()   { echo -e "${RED}[ERROR]${NORMAL} $1" >&2; }
print_verbose() { [ "$VERBOSE" = true ] && echo -e "${BLUE}[VERBOSE]${NORMAL} $1" >&2 || true; }
print_debug()   { [ "$DEBUG" = true ] && echo -e "${BLUE}[DEBUG]${NORMAL} $1" >&2 || true; }

IFS='' read -r -d '' usage <<"EOF"

workon: open a Claude Code session for a work item

Usage:
   workon [ -h|--help ]
   workon [ -v|--verbose ] [ -d|--debug ] [ -c|--create ] [ -r|--repo <repo> ]... <slug>
   workon [ -v|--verbose ] [ -d|--debug ] -q|--quick [ -r|--repo <repo> ]... [title...]

Arguments:
   -h|--help         Show what you are seeing right now
   -v|--verbose      Show what is happening as it happens
   -d|--debug        Show diagnostic detail (implies --verbose)
   <slug>            Work item basename. If it doesn't exist yet, you'll be
                     asked to create it (skip the prompt with -c/--create).
   -c|--create       Don't ask — create the item if <slug> doesn't exist.
   -r|--repo <repo>  Ensure a worktree exists for this repo (creates it if
                     missing, reuses it if already there) and attach it to
                     the session. Repeatable — pass it more than once for a
                     multi-repo item. Every worktree the item already has is
                     attached automatically, with or without -r.
   -q|--quick        Create a temporary item with a generated slug and open
                     it now — for work too small or exploratory to warrant
                     creating a fully tracked item off the bat.
                     [title...] becomes the item title (kebab-cased into the
                     slug); omit it for an auto-generated timestamp title.
                     At session end, workon checks every quick item attached
                     to this invocation: if nothing ever landed (no commits
                     unique to its branch, no uncommitted changes, no extra
                     files in the item folder) it's deleted outright — no
                     archived/ copy, there's nothing to preserve. Otherwise
                     it's left exactly as any other active item.

Description:
   Opens Claude Code with the item's folder as the working directory,­with
   each repo attached alongside it using --add-dir, Flags branch drift behind
   the integration branch, per repo, and offers to sync. Resumes the item's
   last session if one exists.

Examples:
   workon nagios
   workon ad-upgrade -r Ansible
   workon new-idea -r Ansible -r Internal
   workon some-new-thing -c -r work-engine
   workon -q
   workon --quick -r work-engine fix the lint warning

EOF

###
### Helpers
###

# Is the worktree mid-rebase or mid-merge? (robust for worktrees, where .git
# is a file pointing at the per-worktree git dir).
mid_sync() {
    local g
    g=$(git -C "$1" rev-parse --absolute-git-dir 2>/dev/null) || return 1
    [ -n "$g" ] || return 1
    [ -d "$g/rebase-merge" ] || [ -d "$g/rebase-apply" ] || [ -e "$g/MERGE_HEAD" ]
}

# Lowercase-kebab-case from $1 (for slugs) — duplicated from workitem's copy
# by house convention (docs/bin-coding-standards.md: no shared library).
# Idempotent, so re-kebabing an already-canonical slug is always a no-op —
# that's what lets workon compute the slug a new item *will* get without
# needing to parse it back out of `workitem create`'s output.
kebab() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'; }

###
### Parse arguments
###
quick=false
create=false
slug=''
repo_opts=()
title_parts=()
while [ $# -gt 0 ]; do
    case "$1" in
        -v|--verbose) VERBOSE=true ;;
        -d|--debug)   DEBUG=true; VERBOSE=true ;;
        -h|--help|help)
            printf '%s\n' "$usage"
            exit 0 ;;
        -q|--quick)  quick=true ;;
        -c|--create) create=true ;;
        -r|--repo)
            [ -z "${2:-}" ] && { print_error "Option -r/--repo requires an argument"; exit 1; }
            shift; repo_opts+=("$1") ;;
        --repo=*) repo_opts+=("${1#--repo=}") ;;
        -*)
            print_error "Unknown option: $1"
            exit 1 ;;
        *)
            if [ "$quick" = true ]; then
                title_parts+=("$1")
            elif [ -z "$slug" ]; then slug=$1
            else print_error "Too many arguments."; exit 1
            fi ;;
    esac
    shift
done

if [ "$quick" = false ] && [ -z "$slug" ]; then
    printf '%s\n' "$usage"
    exit 0
fi

root="$WORK"
print_debug "Work root: $root"

###
### Resolve (or create) the item
###
itemdir=''
item_created_this_run=false

if [ "$quick" = true ]; then
    if [ ${#title_parts[@]} -gt 0 ]; then
        slug=$(workitem create --quick "${title_parts[@]}")
    else
        slug=$(workitem create --quick)
    fi
    if [ -z "$slug" ]; then
        print_error "Could not create a quick item."
        exit 1
    fi
    itemdir="$root/data/items/$slug"
    item_created_this_run=true
    print_success "Quick item created: $slug"
else
    if [ -f "$root/data/items/$slug/$slug.md" ]; then
        itemdir="$root/data/items/$slug"
        print_verbose "Item found: $slug"
    elif [ -f "$root/data/items/$slug.md" ]; then
        print_error "'$slug' is a legacy single-file item (items/$slug.md, no directory)."
        print_error "Migrate it by hand: create items/$slug/$slug.md and remove the old file."
        exit 1
    elif [ -d "$root/data/items/backlog/$slug" ] || [ -d "$root/data/items/archived/$slug" ]; then
        print_error "'$slug' exists but is not an active top-level item."
        print_error "Activate it first (move it out of backlog/ or archived/)."
        exit 1
    else
        if [ "$create" = false ]; then
            read -r -p "Item '$slug' doesn't exist — create it? [y/N] " reply
            case "$reply" in
                y|Y|yes|Yes) ;;
                *) exit 0 ;;
            esac
        fi
        slug=$(kebab "$slug")
        if ! workitem create "$slug" >/dev/null; then
            print_error "Could not create item '$slug'."
            exit 1
        fi
        itemdir="$root/data/items/$slug"
        item_created_this_run=true
    fi
fi

###
### Ensure requested repos have worktrees (idempotent), collect the full set
###
wtbase="$root/worktrees/$slug"
created_this_run=()
for repo in ${repo_opts[@]+"${repo_opts[@]}"}; do
    if [ -d "$wtbase/$repo" ]; then
        print_verbose "Worktree already present: $repo"
    elif worktree add "$slug" "$repo"; then
        created_this_run+=("$repo")
    else
        # Roll back everything *this invocation* created — worktrees, and the
        # item itself if we're the ones who just created it — rather than
        # launching into a partial/inconsistent attachment set.
        for r in ${created_this_run[@]+"${created_this_run[@]}"}; do
            worktree rm "$slug" "$r" 2>/dev/null
        done
        [ "$item_created_this_run" = true ] && rm -rf "$itemdir"
        print_error "Could not create a worktree in '$repo' for '$slug'."
        exit 1
    fi
done

wt_repos=()
if [ -d "$wtbase" ]; then
    for d in "$wtbase"/*/; do [ -d "$d" ] && wt_repos+=("$(basename "$d")"); done
fi
print_verbose "Worktrees for '$slug': ${wt_repos[*]:-none}"

###
### Start directory — always the item folder itself
###
start="$itemdir"
print_verbose "Start directory: $start"

###
### Drift check — once per attached repo
###
for repo in ${wt_repos[@]+"${wt_repos[@]}"}; do
    wt_path="$wtbase/$repo"

    # Keep the branch-point honest before measuring drift: fast-forward the
    # clone's integration branch if it hasn't been fetched in a while (48h gate,
    # non-fatal when offline). Manual equivalent: `worktree refresh`.
    print_verbose "[$repo] Running worktree refresh --if-stale $repo"
    worktree refresh --if-stale "$repo" || true

    clone="$root/repos/$repo"
    intbr=$(git -C "$clone" rev-parse --abbrev-ref HEAD 2>/dev/null)
    wt=${wt_path/#$HOME/\~}
    if mid_sync "$wt_path"; then
        print_error "[$repo] This worktree is mid-rebase/merge — finish or abort it first:"
        print_error "  git -C $wt rebase --abort      # (or: merge --abort)"
    elif [ -n "$intbr" ] && [ "$intbr" != HEAD ]; then
        behind=$(git -C "$wt_path" rev-list --count "HEAD..$intbr" 2>/dev/null)
        if [ -n "$behind" ] && [ "$behind" -gt 0 ]; then
            print_warning "[$repo] This branch is $behind commit(s) behind $intbr (local clone — fetch for the latest)."
            dirty=$(git -C "$wt_path" status --porcelain 2>/dev/null)
            if [ "$behind" -gt 25 ]; then
                echo "  [$repo] That's a big gap — a deliberate integration, not a quick sync (expect conflicts)."
                echo "  Do it in the session with Claude's help, or by hand first:"
                echo "      git -C $wt merge $intbr     # often simpler than rebase for a large gap"
            elif [ -n "$dirty" ]; then
                echo "  [$repo] Uncommitted changes — commit or stash, then: git -C $wt rebase $intbr"
            else
                read -r -p "  [$repo] Sync now? [r]ebase / [m]erge / [s]kip: " sync
                sync=$(printf '%s' "$sync" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')
                case "$sync" in
                    r|rebase) git -C "$wt_path" rebase "$intbr" ;;
                    m|merge)  git -C "$wt_path" merge --no-edit "$intbr" ;;
                    *)        echo "  Skipped." ;;
                esac
                # Never launch into a half-finished sync.
                if mid_sync "$wt_path"; then
                    git -C "$wt_path" rebase --abort 2>/dev/null
                    git -C "$wt_path" merge --abort 2>/dev/null
                    print_warning "[$repo] Sync hit conflicts — rolled back, branch unchanged. Do it by hand: git -C $wt rebase $intbr"
                fi
            fi
        fi
    fi
done

###
### Flags for Claude
###
# bypassPermissions can only be *entered* by a session started with an enabling
# flag — settings.json defaultMode alone cannot (Claude Code behavior). workon is
# the blessed entry point into the isolated container, so it flips it here; a bare
# `claude` (e.g. via `sandbox shell`) stays safe-by-default under the allow/ask/deny
# lists. deny + ask rules are still enforced under bypass (see claude-settings.json).
flags=(--permission-mode bypassPermissions)
for repo in ${wt_repos[@]+"${wt_repos[@]}"}; do
    flags+=(--add-dir "$wtbase/$repo")
done

###
### Launch in the sandbox container
###
CONTAINER=work-sandbox

# Make sure the box is up before we exec into it (auto-start on workon). Usually
# a no-op — it runs --restart unless-stopped and Docker Desktop starts at login.
print_verbose "Checking container: $CONTAINER"
if ! docker ps --format '{{.Names}}' 2>/dev/null | grep -qx "$CONTAINER"; then
    print_status "Container not running — starting sandbox ..."
    sandbox up || {
        print_error "Sandbox isn't available — is Docker Desktop running?"
        exit 1
    }
fi

# Resume if a session already exists for this directory. Claude stores transcripts
# under ~/.claude/projects/<encoded-cwd>/ (the cwd with '/' and '.' turned to '-').
# The transcript store lives on the container's named volume, so probe inside the
# box. The encoded path is identical because the cwd path is identical.
enc=${start//\//-}; enc=${enc//./-}
print_debug "Transcript path encoding: $enc"
existing=$(docker exec "$CONTAINER" sh -c "ls '$HOME/.claude/projects/$enc'/*.jsonl 2>/dev/null" 2>/dev/null)
print_debug "Existing transcripts: ${existing:-none}"

pretty=${start/#$HOME/\~}
cd "$start" || { print_error "Cannot cd to $start"; exit 1; }

# Label the terminal tab/window with the item slug. CLAUDE_CODE_DISABLE_TERMINAL_TITLE=1
# keeps Claude from re-titling every turn; we pass it into the container explicitly.
: "${CLAUDE_CODE_DISABLE_TERMINAL_TITLE:=1}"
export CLAUDE_CODE_DISABLE_TERMINAL_TITLE
printf '\033]1;%s\007\033]2;workon: %s\007' "$slug" "$slug"

dexec=(docker exec -it --user clake -w "$start"
       -e TERM -e CLAUDE_CODE_DISABLE_TERMINAL_TITLE "$CONTAINER")
if [ -n "$existing" ]; then
    print_status "Resuming $slug in $pretty"
    "${dexec[@]}" claude --continue ${flags[@]+"${flags[@]}"}
else
    print_status "New session for $slug in $pretty"
    "${dexec[@]}" claude ${flags[@]+"${flags[@]}"}
fi
rc=$?

###
### Post-session: the --quick sweep
###
# Runs after the container session has fully exited — no `exec` hand-off — so
# nothing here races Claude's own terminal teardown (a message printed from
# *inside* the session, e.g. by the old SessionEnd hook, could flash and
# vanish; this can't). Only quick items are ever touched, and only based on
# what's cumulatively true right now (commits unique to the branch, not just
# this session's), so a later no-op session never mistakes a graduated item
# with real history for one that's still empty.
front="$itemdir/$slug.md"
if grep -qE '^tags:.*\bquick\b' "$front" 2>/dev/null; then
    sweep_dirty=false
    sweep_unique_commits=0
    sweep_unique_known=true
    for repo in ${wt_repos[@]+"${wt_repos[@]}"}; do
        wt_path="$wtbase/$repo"
        [ -n "$(git -C "$wt_path" status --porcelain 2>/dev/null)" ] && sweep_dirty=true
        clone="$root/repos/$repo"
        sweep_intbr=$(git -C "$clone" rev-parse --abbrev-ref HEAD 2>/dev/null)
        n=''
        if [ -n "$sweep_intbr" ] && [ "$sweep_intbr" != HEAD ]; then
            n=$(git -C "$wt_path" rev-list --count "$sweep_intbr..HEAD" 2>/dev/null)
        fi
        if [ -n "$n" ]; then
            sweep_unique_commits=$((sweep_unique_commits + n))
        else
            sweep_unique_known=false
        fi
    done
    sweep_has_extra=false
    find "$itemdir" -mindepth 1 ! -name "$slug.md" 2>/dev/null | grep -q . && sweep_has_extra=true

    if [ "$sweep_dirty" != true ] && [ "$sweep_unique_commits" -eq 0 ] \
       && { [ ${#wt_repos[@]} -eq 0 ] || [ "$sweep_unique_known" = true ]; } \
       && [ "$sweep_has_extra" != true ]; then
        workitem delete "$slug" >/dev/null 2>&1
        print_success "'$slug' was empty — deleted, nothing to keep."
    else
        why=()
        [ "$sweep_dirty" = true ] && why+=("uncommitted changes")
        [ "$sweep_unique_commits" -gt 0 ] && why+=("$sweep_unique_commits commit(s)")
        [ "$sweep_has_extra" = true ] && why+=("extra files in the item folder")
        [ "$sweep_unique_known" != true ] && why+=("couldn't verify repo history — skipping to be safe")
        if [ ${#why[@]} -gt 0 ]; then
            IFS=', '; reason="${why[*]}"; unset IFS
        else
            reason="unknown reason"
        fi
        print_status "'$slug' left active — $reason."
    fi
fi

exit $rc
