#!/usr/bin/env bash
#
# workon — open a Claude Code session for a work item, in the right place.
#
# Engine tool for the work system. Lives at ~/work/engine/bin/workon (the
# work-engine repo); ~/work/engine/bin is on PATH. Companion completions live
# at ~/work/engine/bin/completions/workon.fish.
#
# Model: the item's own folder (data/items/<slug>/) is always the session's
# working directory — never a specific repo's worktree. Every worktree the
# item has (zero, one, or several) is attached alongside it as its own
# --add-dir, all equally reachable; there's no "pick one to open." -r/--repo
# ensures a worktree exists (idempotent) and attaches it; an unknown slug
# offers to create the item first.
#
# NOTE (isolated-claude-workspace): the launch step at the bottom runs Claude
# inside the persistent sandbox container via `docker exec` (Phase 1 wiring). All
# the item/worktree resolution above is host-side and unchanged; only the final
# launch — and the resume probe that feeds it — target the container.
#
# Deliberately NOT `exec`'d into the final `docker exec` — this process stays
# alive as the session's parent so it can do post-session bookkeeping (the
# empty-item sweep, below) once the container session ends, host-side, after
# Claude's own TUI has fully torn down. That's the whole point: the command
# line here is for managing work (create/start/end); the sandbox is where the
# work itself happens. The cost is one idle bash process for the life of the
# session — negligible next to what it buys.
#

set -u

# Shared boilerplate: WORK root, print_* output functions, trim/kebab/trunc/
# iso_now. Resolves to lib.sh in this script's own bin/ dir. See
# docs/bin-coding-standards.md.
# shellcheck source=lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

IFS='' read -r -d '' usage <<"EOF"

workon: open a Claude Code session for a work item

Usage:
   workon [ -h|--help ]
   workon [ -v|--verbose ] [ -d|--debug ] [ -c|--create ] [ -r|--repo <repo> ]... <slug>
   workon [ -v|--verbose ] [ -d|--debug ] -q|--quick [ -r|--repo <repo> ]... [title...]

Arguments:
   -h|--help         Show what you are seeing right now
   -v|--verbose      Show what is happening as it happens
   -d|--debug        Show diagnostic detail (implies --verbose)
   <slug>            Work item basename. If it doesn't exist yet, you'll be
                     asked to create it (skip the prompt with -c/--create).
   -c|--create       Don't ask — create the item if <slug> doesn't exist.
   -r|--repo <repo>  Ensure a worktree exists for this repo (creates it if
                     missing, reuses it if already there) and attach it to
                     the session. Repeatable — pass it more than once for a
                     multi-repo item. Every worktree the item already has is
                     attached automatically, with or without -r.
   -q|--quick        Create a temporary item with a generated slug and open
                     it now — for work too small or exploratory to warrant
                     even typing a slug. [title...] becomes the item title
                     (kebab-cased into the slug); omit it for an
                     auto-generated timestamp title. If a top-level item
                     already exists under that exact slug, resumes it
                     instead of creating a new one — so re-running the same
                     `workon -q <title>` (e.g. via shell history) gets back
                     into the same item rather than minting a duplicate.

                     Any item workon creates this run — via -q/--quick or a
                     plain `workon <newslug> -c` — is swept at session end if
                     nothing durable landed: no commits (unmerged or already
                     merged), no uncommitted changes, no extra files in the
                     item folder, and no notes written into the front door
                     itself. It's deleted outright — no archived/ copy,
                     there's nothing to preserve. An item that already
                     existed before this invocation is never swept, no
                     matter how the session goes.

Description:
   Opens Claude Code with the item's folder as the working directory, with
   each repo's worktree attached alongside it via --add-dir. Flags branch
   drift behind the integration branch, per repo, and offers to sync. Resumes
   the item's last session if one exists.

Examples:
   workon nagios
   workon ad-upgrade -r Ansible
   workon new-idea -r Ansible -r Internal
   workon some-new-thing -c -r work-engine
   workon -q
   workon --quick -r work-engine fix the lint warning

EOF

###
### Helpers
###

# Is the worktree mid-rebase or mid-merge? (robust for worktrees, where .git
# is a file pointing at the per-worktree git dir).
mid_sync() {
    local g
    g=$(git -C "$1" rev-parse --absolute-git-dir 2>/dev/null) || return 1
    [ -n "$g" ] || return 1
    [ -d "$g/rebase-merge" ] || [ -d "$g/rebase-apply" ] || [ -e "$g/MERGE_HEAD" ]
}

###
### Parse arguments
###
quick=false
create=false
slug=''
repo_opts=()
title_parts=()
# shellcheck disable=SC2034  # VERBOSE/DEBUG are read by print_* in lib.sh
while [ $# -gt 0 ]; do
    case "$1" in
        -v|--verbose) VERBOSE=true ;;
        -d|--debug)   DEBUG=true; VERBOSE=true ;;
        -h|--help|help)
            printf '%s\n' "$usage"
            exit 0 ;;
        -q|--quick)  quick=true ;;
        -c|--create) create=true ;;
        -r|--repo)
            [ -z "${2:-}" ] && { print_error "Option -r/--repo requires an argument"; exit 1; }
            shift; repo_opts+=("$1") ;;
        --repo=*) repo_opts+=("${1#--repo=}") ;;
        -*)
            print_error "Unknown option: $1"
            exit 1 ;;
        *)
            if [ "$quick" = true ]; then
                title_parts+=("$1")
            elif [ -z "$slug" ]; then slug=$1
            else print_error "Too many arguments."; exit 1
            fi ;;
    esac
    shift
done

if [ "$quick" = false ] && [ -z "$slug" ]; then
    printf '%s\n' "$usage"
    exit 0
fi

root="$WORK"
print_debug "Work root: $root"

###
### Resolve (or create) the item
###
itemdir=''
item_created_this_run=false

# A brand-new item gets its -r worktrees from `workitem create` itself, which
# creates them atomically with the item (all or nothing). The loop below then
# only does real work for items that already existed.
create_repo_args=()
for repo in ${repo_opts[@]+"${repo_opts[@]}"}; do create_repo_args+=(-r "$repo"); done

if [ "$quick" = true ]; then
    if [ ${#title_parts[@]} -gt 0 ]; then
        # A title colliding with an existing top-level item under the exact
        # slug `workitem create --quick` would generate is most often the
        # same command re-run from shell history to get back into an
        # earlier quick session -- not a request for a second, unrelated
        # item of the same name. Resume it instead of minting a "-2"
        # duplicate. A name that's genuinely free (or sitting in
        # backlog/archived, where resuming doesn't apply) still goes
        # through create, -2 suffix and all.
        quick_title="$(trim "${title_parts[*]}")"
        quick_candidate=$(kebab "$quick_title")
        if [ -f "$root/data/items/$quick_candidate/$quick_candidate.md" ]; then
            slug=$quick_candidate
            print_verbose "Quick item '$slug' already exists — resuming it"
        else
            slug=$(workitem create --quick ${create_repo_args[@]+"${create_repo_args[@]}"} "${title_parts[@]}")
            item_created_this_run=true
        fi
    else
        slug=$(workitem create --quick ${create_repo_args[@]+"${create_repo_args[@]}"})
        item_created_this_run=true
    fi
    if [ -z "$slug" ]; then
        print_error "Could not create a quick item (see above)."
        exit 1
    fi
    itemdir="$root/data/items/$slug"
    [ "$item_created_this_run" = true ] && print_success "Quick item created: $slug"
else
    if [ -f "$root/data/items/$slug/$slug.md" ]; then
        itemdir="$root/data/items/$slug"
        print_verbose "Item found: $slug"
    elif [ -f "$root/data/items/$slug.md" ]; then
        print_error "'$slug' is a legacy single-file item (items/$slug.md, no directory)."
        print_error "Migrate it by hand: create items/$slug/$slug.md and remove the old file."
        exit 1
    elif [ -d "$root/data/items/backlog/$slug" ] || [ -d "$root/data/items/archived/$slug" ]; then
        print_error "'$slug' exists but is not an active top-level item."
        print_error "Activate it first (move it out of backlog/ or archived/)."
        exit 1
    else
        if [ "$create" = false ]; then
            read -r -p "Item '$slug' doesn't exist — create it? [y/N] " reply
            case "$reply" in
                y|Y|yes|Yes) ;;
                *) exit 0 ;;
            esac
        fi
        slug=$(kebab "$slug")
        # With -r, leave workitem's worktree output visible; without, only
        # the "Created" banner is noise.
        if [ ${#repo_opts[@]} -gt 0 ]; then
            workitem create ${create_repo_args[@]+"${create_repo_args[@]}"} "$slug"
        else
            workitem create "$slug" >/dev/null
        fi
        # shellcheck disable=SC2181
        if [ $? -ne 0 ]; then
            print_error "Could not create item '$slug' (see above)."
            exit 1
        fi
        itemdir="$root/data/items/$slug"
        item_created_this_run=true
    fi
fi

###
### Ensure requested repos have worktrees (idempotent), collect the full set
###
wtbase="$root/worktrees/$slug"
created_this_run=()
for repo in ${repo_opts[@]+"${repo_opts[@]}"}; do
    if [ -d "$wtbase/$repo" ]; then
        print_verbose "Worktree already present: $repo"
    elif worktree add "$slug" "$repo"; then
        created_this_run+=("$repo")
    else
        # Roll back the worktrees *this invocation* created rather than
        # launching into a partial attachment set. (A brand-new item never
        # reaches here: `workitem create -r` already made its worktrees, or
        # failed and removed the item.)
        for r in ${created_this_run[@]+"${created_this_run[@]}"}; do
            worktree rm "$slug" "$r" 2>/dev/null
        done
        print_error "Could not create a worktree in '$repo' for '$slug'."
        exit 1
    fi
done

wt_repos=()
if [ -d "$wtbase" ]; then
    for d in "$wtbase"/*/; do [ -d "$d" ] && wt_repos+=("$(basename "$d")"); done
fi
print_verbose "Worktrees for '$slug': ${wt_repos[*]:-none}"

###
### Start directory — always the item folder itself
###
start="$itemdir"
print_verbose "Start directory: $start"

###
### Drift check — once per attached repo
###
for repo in ${wt_repos[@]+"${wt_repos[@]}"}; do
    wt_path="$wtbase/$repo"

    # Keep the branch-point honest before measuring drift: fast-forward the
    # clone's integration branch if it hasn't been fetched in a while (24h gate,
    # non-fatal when offline). Manual equivalent: `worktree refresh`.
    print_verbose "[$repo] Running worktree refresh --if-stale $repo"
    worktree refresh --if-stale "$repo" || true

    clone="$root/repos/$repo"
    intbr=$(git -C "$clone" rev-parse --abbrev-ref HEAD 2>/dev/null)
    wt=${wt_path/#$HOME/\~}
    if mid_sync "$wt_path"; then
        print_error "[$repo] This worktree is mid-rebase/merge — finish or abort it first:"
        print_error "  git -C $wt rebase --abort      # (or: merge --abort)"
    elif [ -n "$intbr" ] && [ "$intbr" != HEAD ]; then
        behind=$(git -C "$wt_path" rev-list --count "HEAD..$intbr" 2>/dev/null)
        if [ -n "$behind" ] && [ "$behind" -gt 0 ]; then
            print_warning "[$repo] This branch is $behind commit(s) behind $intbr (local clone — fetch for the latest)."
            dirty=$(git -C "$wt_path" status --porcelain 2>/dev/null)
            if [ "$behind" -gt 25 ]; then
                echo "  [$repo] That's a big gap — a deliberate integration, not a quick sync (expect conflicts)."
                echo "  Do it in the session with Claude's help, or by hand first:"
                echo "      git -C $wt merge $intbr     # often simpler than rebase for a large gap"
            elif [ -n "$dirty" ]; then
                echo "  [$repo] Uncommitted changes — commit or stash, then: git -C $wt rebase $intbr"
            else
                read -r -p "  [$repo] Sync now? [r]ebase / [m]erge / [s]kip: " sync
                sync=$(printf '%s' "$sync" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')
                case "$sync" in
                    r|rebase) git -C "$wt_path" rebase "$intbr" ;;
                    m|merge)  git -C "$wt_path" merge --no-edit "$intbr" ;;
                    *)        echo "  Skipped." ;;
                esac
                # Never launch into a half-finished sync.
                if mid_sync "$wt_path"; then
                    git -C "$wt_path" rebase --abort 2>/dev/null
                    git -C "$wt_path" merge --abort 2>/dev/null
                    print_warning "[$repo] Sync hit conflicts — rolled back, branch unchanged. Do it by hand: git -C $wt rebase $intbr"
                fi
            fi
        fi
    fi
done

###
### Flags for Claude
###
# bypassPermissions can only be *entered* by a session started with an enabling
# flag — settings.json defaultMode alone cannot (Claude Code behavior). workon is
# the blessed entry point into the isolated container, so it flips it here; a bare
# `claude` (e.g. via `sandbox shell`) stays safe-by-default under the allow/ask/deny
# lists. deny + ask rules are still enforced under bypass (see claude-settings.json).
flags=(--permission-mode bypassPermissions)
for repo in ${wt_repos[@]+"${wt_repos[@]}"}; do
    flags+=(--add-dir "$wtbase/$repo")
done

###
### Launch in the sandbox container
###
CONTAINER=work-sandbox

# Make sure the box is up before we exec into it (auto-start on workon). Usually
# a no-op — it runs --restart unless-stopped and Docker Desktop starts at login.
print_verbose "Checking container: $CONTAINER"
if ! docker ps --format '{{.Names}}' 2>/dev/null | grep -qx "$CONTAINER"; then
    print_status "Container not running — starting sandbox ..."
    sandbox up || {
        print_error "Sandbox isn't available — is Docker Desktop running?"
        exit 1
    }
fi

###
### Sandbox freshness check
###
# Informational only, non-fatal. The image's packages (including the pinned
# gitleaks/trufflehog scanner versions) are only ever refreshed by an
# explicit `sandbox build`/`rebuild` -- Docker's own layer cache means a
# plain rebuild with an unchanged Dockerfile silently reuses old layers. The
# marker is touched by `sandbox build`'s success path; same mtime-based
# staleness idiom as `worktree`'s FETCH_HEAD check, so there's no date
# arithmetic to get wrong across the Mac's BSD tools. No marker means
# nothing's been built since this check shipped -- skip rather than guess.
stale_marker="$HOME/.cache/work-sandbox-build-stamp"
stale_days="${SANDBOX_STALE_DAYS:-30}"
if [ -f "$stale_marker" ] && [ -n "$(find "$stale_marker" -mtime +"$stale_days" 2>/dev/null)" ]; then
    print_warning "Sandbox image hasn't been rebuilt in over $stale_days days — run 'sandbox rebuild' to refresh packages and secret-scanner versions."
fi

# Resume if a session already exists for this directory. Claude stores transcripts
# under ~/.claude/projects/<encoded-cwd>/ (the cwd with '/' and '.' turned to '-').
# The transcript store lives on the container's named volume, so probe inside the
# box. The encoded path is identical because the cwd path is identical.
enc=${start//\//-}; enc=${enc//./-}
print_debug "Transcript path encoding: $enc"
existing=$(docker exec "$CONTAINER" sh -c "ls '$HOME/.claude/projects/$enc'/*.jsonl 2>/dev/null" 2>/dev/null)
print_debug "Existing transcripts: ${existing:-none}"

pretty=${start/#$HOME/\~}
cd "$start" || { print_error "Cannot cd to $start"; exit 1; }

# Label the terminal tab/window with the item slug. CLAUDE_CODE_DISABLE_TERMINAL_TITLE=1
# keeps Claude from re-titling every turn; we pass it into the container explicitly.
: "${CLAUDE_CODE_DISABLE_TERMINAL_TITLE:=1}"
export CLAUDE_CODE_DISABLE_TERMINAL_TITLE
printf '\033]1;%s\007\033]2;workon: %s\007' "$slug" "$slug"

# Start of THIS run, stamped locally — workon runs on the Mac, so this is real
# local time, not the box's UTC. Also drop a marker whose mtime IS the start
# moment; the breadcrumb finds item-folder files touched after it via portable
# `find -newer` (no GNU-only `-newermt`).
session_start=$(date +%Y-%m-%dT%H:%M:%S%z | sed -E 's/([0-9]{2})([0-9]{2})$/\1:\2/')
bc_marker=$(mktemp "${TMPDIR:-/tmp}/workon-bc.XXXXXX")

# Re-assert Claude's onboarding flag before every launch. The entrypoint seeds
# hasCompletedOnboarding=true at container *start*, but that's a one-shot: a
# Claude version upgrade's one-time migration (e.g. after a `sandbox rebuild`
# pulls a newer unpinned binary) can null the flag mid-life, on the persistent
# ~/.claude state. When it's not true, Claude runs the theme/welcome onboarding,
# which masquerades as an auth prompt on every session even though the injected
# token is valid. Re-asserting here — right before the exec — covers any drift,
# not just the moment the container came up. Mirrors the entrypoint's merge:
# preserve Claude's other keys when the file exists, create it minimally if not.
# $HOME is the same absolute path inside the box as out (the mount is 1:1).
# Best-effort; never block a session on it.
print_verbose "Ensuring hasCompletedOnboarding is set in the container"
docker exec --user clake "$CONTAINER" sh -c '
    f="$HOME/.claude.json"
    if [ -s "$f" ] && jq -e . "$f" >/dev/null 2>&1; then
        t=$(mktemp)
        jq ".hasCompletedOnboarding = true" "$f" > "$t" 2>/dev/null && mv "$t" "$f" || rm -f "$t"
    else
        printf "{\"hasCompletedOnboarding\":true}\n" > "$f"
    fi
' >/dev/null 2>&1 || print_verbose "onboarding-flag re-assert failed (non-fatal)"

dexec=(docker exec -it --user clake -w "$start"
       -e TERM -e CLAUDE_CODE_DISABLE_TERMINAL_TITLE "$CONTAINER")
if [ -n "$existing" ]; then
    print_status "Resuming $slug in $pretty"
    "${dexec[@]}" claude --continue ${flags[@]+"${flags[@]}"}
else
    print_status "New session for $slug in $pretty"
    "${dexec[@]}" claude ${flags[@]+"${flags[@]}"}
fi
rc=$?

###
### Post-session: write the session breadcrumb (host-side)
###
# Everything the breadcrumb records is available right here on the host — the
# item folder and worktrees are bind-mounted, and we stamped start/end
# ourselves — so it runs directly (no docker exec) and its times are local, not
# the box's UTC. This used to be a Claude Code SessionEnd hook, but that fired
# unreliably on some exit paths (a long session ended by a hard exit could
# leave no breadcrumb at all), so workon drives it deterministically instead.
session_end=$(date +%Y-%m-%dT%H:%M:%S%z | sed -E 's/([0-9]{2})([0-9]{2})$/\1:\2/')
print_verbose "Writing breadcrumb for $slug"
printf '{"cwd":"%s","start":"%s","end":"%s","since_ref":"%s"}' \
    "$start" "$session_start" "$session_end" "$bc_marker" \
    | "$WORK/engine/bin/work-session-breadcrumb"
rm -f "$bc_marker"

###
### Post-session: the empty-item sweep
###
# Runs after the container session has fully exited — no `exec` hand-off — so
# nothing here races Claude's own terminal teardown (a message printed from
# *inside* the session, e.g. by the old SessionEnd hook, could flash and
# vanish; this can't). Only an item THIS invocation created is ever touched —
# never one that already existed before it — and only based on what's
# cumulatively true right now (commits on the branch, not just this
# session's), so nothing with prior history is ever at risk. This is why the
# gate is item_created_this_run rather than a `quick` tag: the same "did
# anything durable land" question applies whether the item came from
# -q/--quick or from typing a brand-new slug at `workon <newslug> -c`.
#
# "Landed a commit" is checked two ways, not one, because a branch merged
# into the integration branch mid-session or right before exit is the
# opposite of empty: rev-list "$intbr..HEAD" alone would read that as zero
# unique commits and delete real, already-integrated work (this happened —
# see items/CLAUDE.md's "Commit provenance" section). sweep_unique_commits
# still catches the common not-yet-merged case; sweep_trailer_commits
# catches the merged one, via the Work-Item trailer every worktree commit
# carries, searched across all reachable history rather than just this
# branch relative to intbr.
if [ "$item_created_this_run" = true ]; then
    sweep_dirty=false
    sweep_unique_commits=0
    sweep_unique_known=true
    sweep_trailer_commits=0
    for repo in ${wt_repos[@]+"${wt_repos[@]}"}; do
        wt_path="$wtbase/$repo"
        [ -n "$(git -C "$wt_path" status --porcelain 2>/dev/null)" ] && sweep_dirty=true
        clone="$root/repos/$repo"
        sweep_intbr=$(git -C "$clone" rev-parse --abbrev-ref HEAD 2>/dev/null)
        n=''
        if [ -n "$sweep_intbr" ] && [ "$sweep_intbr" != HEAD ]; then
            n=$(git -C "$wt_path" rev-list --count "$sweep_intbr..HEAD" 2>/dev/null)
        fi
        if [ -n "$n" ]; then
            sweep_unique_commits=$((sweep_unique_commits + n))
        else
            sweep_unique_known=false
        fi
        # "$sweep_intbr..HEAD" goes to zero the moment the branch is merged
        # into the integration branch -- correct as an integration signal,
        # wrong as an emptiness signal, since it can't tell "nothing was ever
        # committed" from "everything was committed AND already merged" (see
        # items/CLAUDE.md's "Commit provenance" section). The Work-Item
        # trailer bin/hooks/commit-msg stamps on every worktree commit
        # doesn't have that blind spot -- it's still on the commit whichever
        # branch it ends up reachable from, so search reachable history
        # (--all) rather than just this branch relative to intbr.
        tn=$(git -C "$wt_path" rev-list --all --count --grep="^Work-Item: $slug\$" 2>/dev/null)
        [ -n "$tn" ] && sweep_trailer_commits=$((sweep_trailer_commits + tn))
    done
    # log/ is excluded deliberately: the breadcrumb just written above lands
    # there for every session (including a do-nothing one), so counting log/
    # itself as "extra" would defeat the sweep every time. Files elsewhere in
    # the item folder (plan.md, artifacts actually added) still count as
    # durable; <slug>.md itself is excluded here too, since it's always
    # present — content changes to it are caught separately below.
    sweep_has_extra=false
    find "$itemdir" -mindepth 1 -path "$itemdir/log" -prune -o ! -name "$slug.md" -print 2>/dev/null \
        | grep -q . && sweep_has_extra=true

    # A session that only ever wrote prose into the front door itself
    # (<slug>.md) — notes in Current state, nothing else — wouldn't show up
    # in the check above, since that file is always present and excluded by
    # name. The breadcrumb just written already recorded whether anything in
    # the item folder, front door included, changed mtime since session
    # start (item-files-changed) — reuse that number instead of re-deriving
    # it; bc_marker is already gone by this point and deliberately isn't
    # extended just for this.
    sweep_item_files_changed=0
    newest_bc=$(printf '%s\n' "$itemdir"/log/"${session_end%%T*}.$slug.session."*.md 2>/dev/null | sort | tail -1)
    if [ -n "$newest_bc" ] && [ -f "$newest_bc" ]; then
        n=$(sed -n 's/^item-files-changed: *//p' "$newest_bc" | head -1)
        [ -n "$n" ] && sweep_item_files_changed=$n
    fi

    if [ "$sweep_dirty" != true ] && [ "$sweep_unique_commits" -eq 0 ] && [ "$sweep_trailer_commits" -eq 0 ] \
       && { [ ${#wt_repos[@]} -eq 0 ] || [ "$sweep_unique_known" = true ]; } \
       && [ "$sweep_has_extra" != true ] && [ "$sweep_item_files_changed" -eq 0 ]; then
        workitem delete "$slug" --force >/dev/null 2>&1
        print_success "'$slug' was empty — deleted, nothing to keep."
    else
        why=()
        [ "$sweep_dirty" = true ] && why+=("uncommitted changes")
        [ "$sweep_unique_commits" -gt 0 ] && why+=("$sweep_unique_commits commit(s)")
        [ "$sweep_trailer_commits" -gt 0 ] && why+=("$sweep_trailer_commits already-merged commit(s)")
        [ "$sweep_has_extra" = true ] && why+=("extra files in the item folder")
        [ "$sweep_item_files_changed" -gt 0 ] && why+=("notes written into the front door")
        [ "$sweep_unique_known" != true ] && why+=("couldn't verify repo history — skipping to be safe")
        if [ ${#why[@]} -gt 0 ]; then
            IFS=', '; reason="${why[*]}"; unset IFS
        else
            reason="unknown reason"
        fi
        print_status "'$slug' left active — $reason."
    fi
fi

exit $rc
