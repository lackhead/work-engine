#!/usr/bin/env bash
#
# worktask — create, list, show, log progress, complete, cancel, delete,
# set due dates, and manage related-item associations on tasks under
# ~/work/data/tasks/.
#
# Engine tool for the work system. Lives at ~/work/engine/bin/worktask
# (the work-engine repo, on PATH). Companion completion:
# ~/work/engine/bin/completions/worktask.fish.
#

set -u

# Shared boilerplate: WORK root, print_* output functions, trim/kebab/trunc/
# iso_now. Resolves to lib.sh in this script's own bin/ dir. See
# docs/bin-coding-standards.md.
# shellcheck source=lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

IFS='' read -r -d '' usage <<"EOF"

worktask: create, list, show, log progress, complete, cancel, delete, promote, set due dates, and manage related-item associations on tasks

Usage:
   worktask [ -h|--help ]
   worktask [ -v|--verbose ] [ -d|--debug ] create   [-i|--item <slug>] [description...]
   worktask [ -v|--verbose ] [ -d|--debug ] list     [--archived|--all]
   worktask [ -v|--verbose ] [ -d|--debug ] show     <name>
   worktask [ -v|--verbose ] [ -d|--debug ] log      <name> [note...]
   worktask [ -v|--verbose ] [ -d|--debug ] complete <name>
   worktask [ -v|--verbose ] [ -d|--debug ] cancel   <name>
   worktask [ -v|--verbose ] [ -d|--debug ] delete   <name> [--force]
   worktask [ -v|--verbose ] [ -d|--debug ] due      <name> [date]
   worktask [ -v|--verbose ] [ -d|--debug ] item     <name> [slug|--clear]
   worktask [ -v|--verbose ] [ -d|--debug ] promote  <name> [workitem create args...]

Arguments:
   -h|--help     Show what you are seeing right now
   -v|--verbose  Show what is happening as it happens
   -d|--debug    Show diagnostic detail (implies --verbose)

Description:
   create   With a description given, creates tasks/<slug>.md
            immediately, no prompts. With none, prompts for the
            description, whether to attach an existing item (picked
            interactively), and a slug to confirm.

   list     Display active tasks, sorted by created date;
            --archived/--all broaden the scope

   show     Prints the task information — piped through $PAGER if set,
            else plain output

   log      Appends a timestamped note to the task's ## Log section. With
            a note given, records it immediately; with none, prompts for
            one. Works on active or archived tasks.

   complete Sets status to completed and moves the task to
            tasks/archived/.

   cancel   Sets status to cancelled and moves the task to
            tasks/archived/.

   delete   Removes a task outright (delete from inventory). Prompts
            for confirmation; --force skips the prompt and is required to
            delete non-interactively.

   due      Sets or changes the (optional) due date. Accepts YYYY-MM-DD, or
            a relative form: today, tomorrow, a weekday name (mon, monday,
            ...). Omitting the date clears any existing due date.

   item     Sets the related-item association to <slug>. With no slug,
            picks one interactively (same picker as create). --clear
            removes the association.

   promote  Creates a work item (title defaults to the task's own
            heading unless overridden by trailing args) and completes the
            task, in one step.

Examples:
   worktask create
   worktask create -i nagios
   worktask create Call John back about the firewall exception
   worktask list
   worktask list --all
   worktask show check-on-mikes-pr-progress
   worktask log check-on-mikes-pr-progress
   worktask log check-on-mikes-pr-progress Called Friday, no answer
   worktask complete check-on-mikes-pr-progress
   worktask cancel beta-lm-license-hague
   worktask due check-on-mikes-pr-progress 2026-05-15
   worktask due check-on-mikes-pr-progress monday
   worktask due check-on-mikes-pr-progress tomorrow
   worktask due check-on-mikes-pr-progress
   worktask item check-on-mikes-pr-progress nagios
   worktask item check-on-mikes-pr-progress
   worktask item check-on-mikes-pr-progress --clear
   worktask promote check-on-mikes-pr-progress
   worktask promote check-on-mikes-pr-progress -b Review Mike's PR properly

EOF

# Resolve a task name to its full path, checking both zones. Echoes the
# path and returns 0 if found; returns 1 with no output otherwise.
resolve_task() {
    local name=$1 root="$WORK/data/tasks"
    if [ -f "$root/$name.md" ]; then
        printf '%s' "$root/$name.md"; return 0
    elif [ -f "$root/archived/$name.md" ]; then
        printf '%s' "$root/archived/$name.md"; return 0
    fi
    return 1
}

###
### Subcommands
###
# Interactive picker over item slugs across all three zones (top-level,
# backlog/, archived/) -- a task's related-item is a soft cross-
# reference, not a write target the way workitem log's resolution is, so
# unlike wi_log_pick_item this deliberately doesn't exclude backlog/archived.
# fzf if available, else a numbered-menu fallback (copied, not shared --
# see docs/bin-coding-standards.md's no-shared-library convention -- this is
# a different script from workitem, so it gets its own copy of the same
# shape wi_log_pick_item uses). Echoes the chosen slug on stdout; a clean
# cancel (empty fzf selection, or a blank fallback answer) prints a status
# line and returns 1 with nothing echoed -- never an error.
task_pick_item() {
    local root="$WORK/data/items" slugs=() titles=() zones=() p slug title_f z dir
    for z in '' backlog/ archived/; do
        dir="$root/$z"
        [ -d "$dir" ] || continue
        for p in "$dir"*/; do
            [ -d "$p" ] || continue
            slug=$(basename "$p")
            case "$slug" in backlog|archived) continue ;; esac
            [ -f "$p$slug.md" ] || continue
            title_f=$(sed -n 's/^title: *//p' "$p$slug.md" | head -1)
            slugs+=("$slug")
            titles+=("${title_f:-$slug}")
            zones+=("$z")
        done
    done
    if [ ${#slugs[@]} -eq 0 ]; then
        print_status "No items to attach to." >&2
        return 1
    fi

    # Archived entries get a visual tag -- a combined-zone list shouldn't
    # silently blur "currently active" with "already closed".
    local i tag entries=()
    for i in "${!slugs[@]}"; do
        tag=''
        [ "${zones[$i]}" = "archived/" ] && tag=' (archived)'
        entries+=("${slugs[$i]}  —  ${titles[$i]}${tag}")
    done

    if command -v fzf >/dev/null 2>&1; then
        local choice
        choice=$(printf '%s\n' "${entries[@]}" | fzf --prompt='item> ') || true
        if [ -z "$choice" ]; then
            print_status "No item selected." >&2
            return 1
        fi
        printf '%s' "${choice%% *}"
    else
        local choice
        for i in "${!entries[@]}"; do
            printf '%2d) %s\n' "$((i + 1))" "${entries[$i]}" >&2
        done
        read -r -p "Which item? [1-${#slugs[@]}, blank for none] " choice
        if [ -z "$choice" ]; then
            print_status "No item selected." >&2
            return 1
        fi
        if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt "${#slugs[@]}" ]; then
            print_error "Invalid selection."
            return 1
        fi
        printf '%s' "${slugs[$((choice - 1))]}"
    fi
}

# True (0) if <slug> resolves to an existing item file in any zone (top,
# backlog/, archived/); false (1) otherwise. Used to warn -- not block --
# when tagging a task to a slug that doesn't (yet) exist. Shared by
# task_create and task_item.
task_item_known() {
    local slug=$1
    [ -f "$WORK/data/items/$slug/$slug.md" ] \
        || [ -f "$WORK/data/items/backlog/$slug/$slug.md" ] \
        || [ -f "$WORK/data/items/archived/$slug/$slug.md" ]
}

task_create() {
    local item='' desc_parts=() a
    while [ $# -gt 0 ]; do
        a=$1
        case "$a" in
            -i|--item) shift; item=${1:-} ;;
            --item=*)  item=${a#--item=} ;;
            -*)        print_error "Unknown option: $a"; return 1 ;;
            *)         desc_parts+=("$a") ;;
        esac
        shift
    done

    # --- description: positional args make this a fire-and-forget quick
    # add (skips every remaining prompt below); otherwise fall back to the
    # original always-prompted flow, unchanged. ---
    local desc=''
    [ ${#desc_parts[@]} -gt 0 ] && desc="${desc_parts[*]}"
    desc="$(trim "$desc")"

    local quick=false
    if [ -n "$desc" ]; then
        quick=true
    else
        read -r -p "task: " desc
        desc="$(trim "$desc")"
        if [ -z "$desc" ]; then
            print_error "Empty description — nothing created."; return 1
        fi
    fi

    if [ -z "$item" ] && [ "$quick" = false ]; then
        read -r -p "Attach to an existing item? [y/N] " reply
        if printf '%s' "$reply" | grep -qiE '^y'; then
            item=$(task_pick_item) || item=''
        fi
    fi
    # Unconditional on $item being non-empty, exactly as before -- quick
    # mode can only populate $item via -i, so this still fires correctly
    # for -i in quick mode with zero special-casing.
    if [ -n "$item" ] && ! task_item_known "$item"; then
        print_warning "'$item' isn't an existing item; tagging anyway."
    fi

    # --- slug: in quick mode, auto-generate silently; otherwise proffer a
    # truncated default and let the user override it right here -- now that
    # the description is fully written out, this is the best moment to
    # judge whether the mechanical slug is any good. ---
    local default_slug slug
    default_slug=$(kebab "$desc")
    if [ "$quick" = true ]; then
        slug="$default_slug"
    else
        read -r -p "slug [$default_slug]: " slug
        slug="$(trim "$slug")"
        if [ -n "$slug" ]; then
            slug=$(kebab "$slug" 200)
        else
            slug="$default_slug"
        fi
    fi

    # Resolve a collision by appending -2, -3, ... rather than refusing --
    # once slugs are truncated/short, two unrelated descriptions legitimately
    # landing on the same slug is expected, not an error.
    local base="$slug" n=1
    while [ -e "$WORK/data/tasks/$slug.md" ] || [ -e "$WORK/data/tasks/archived/$slug.md" ]; do
        n=$((n + 1))
        slug="$base-$n"
    done
    [ "$slug" != "$base" ] && print_verbose "Slug '$base' taken — using '$slug'"

    local date_str file
    date_str=$(date +%Y-%m-%d)
    file="$WORK/data/tasks/$slug.md"
    print_verbose "Creating task: $file"

    {
        echo "---"
        echo "created: $date_str"
        echo "status: active"
        echo "source: manual"
        # Quoted deliberately: a bare [[slug]] is a YAML flow sequence, so the
        # unquoted form parses as the nested list [['slug']] rather than the
        # wikilink string every reader expects. See schema/items/CLAUDE.md's
        # related-items row for the same trap.
        [ -n "$item" ] && echo "related-item: \"[[$item]]\""
        echo "---"
        echo
        echo "# $desc"
    } > "$file"

    print_success "Created → ${file/#$HOME/\~}"
}

task_list() {
    local scope=active a
    while [ $# -gt 0 ]; do
        a=$1
        case "$a" in
            --archived) scope=archived ;;
            --all)      scope=all ;;
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)  print_error "Unexpected argument: $a"; return 1 ;;
        esac
        shift
    done

    local root="$WORK/data/tasks"
    local show_status=false
    [ "$scope" != active ] && show_status=true

    local dirs=()
    case "$scope" in
        active)   dirs=("$root") ;;
        archived) dirs=("$root/archived") ;;
        all)      dirs=("$root" "$root/archived") ;;
    esac

    # Gather rows as tab-separated fields and sort by created date ascending
    # (oldest first) -- filenames no longer carry the date (it's frontmatter
    # only), so chronological order can't just fall out of an alphabetical
    # glob anymore.
    local rows='' dir f name status due desc created
    for dir in "${dirs[@]}"; do
        [ -d "$dir" ] || continue
        for f in "$dir"/*.md; do
            [ -f "$f" ] || continue
            name=$(basename "$f" .md)
            status=$(sed -n 's/^status: *//p' "$f" | head -1)
            [ "$scope" = active ] && [ "$status" != active ] && continue
            created=$(sed -n 's/^created: *//p' "$f" | head -1)
            due=$(sed -n 's/^due: *//p' "$f" | head -1)
            desc=$(sed -n 's/^# *//p' "$f" | head -1)
            rows="${rows}${created:-9999-99-99}"$'\t'"${due:--}"$'\t'"$status"$'\t'"$desc"$'\t'"$name"$'\n'
        done
    done

    if [ -z "$rows" ]; then
        echo "(none)"
        return 0
    fi

    if [ "$show_status" = true ]; then
        printf '%-11s %-9s %-44s %s\n' DUE STATUS DESC NAME
    else
        printf '%-11s %-44s %s\n' DUE DESC NAME
    fi

    while IFS=$'\t' read -r created due status desc name; do
        [ -n "$created" ] || continue
        if [ "$show_status" = true ]; then
            printf '%-11s %-9s %-44s %s\n' "$due" "$status" "$(trunc "$desc" 44)" "$name"
        else
            printf '%-11s %-44s %s\n' "$due" "$(trunc "$desc" 44)" "$name"
        fi
    done < <(printf '%s' "$rows" | sort -t $'\t' -k1,1)
}

task_show() {
    local name='' a
    for a in "$@"; do
        case "$a" in
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)
                if [ -z "$name" ]; then name=$a
                else print_error "Too many arguments."; return 1
                fi ;;
        esac
    done
    if [ -z "$name" ]; then
        print_error "Usage: worktask show <name>"; return 1
    fi

    local src
    src="$(resolve_task "$name")" || {
        print_error "No task '$name' found."; return 1
    }

    if [ -n "${PAGER:-}" ]; then
        # Intentionally unquoted: $PAGER commonly carries flags (e.g. "less -R"),
        # and quoting it would treat the whole string as one command name.
        $PAGER "$src"
    else
        cat "$src"
    fi
}

# Append a timestamped entry to the task's ## Log section. A note given on
# the command line is recorded immediately (fire-and-forget, same spirit as
# `create`'s quick add); omitted, falls back to a single-line prompt (same
# shape as workitem's wi_log_read_note). Works against active or archived
# tasks alike -- a wrap-up note at the moment of completion is a legitimate
# use, and resolve_task already searches both zones.
#
# ## Log is documented as always the last section of a task file, so a new
# entry is simply appended to the end of the file -- no parsing back into an
# existing section. Append-only, matching the vault's log-is-immutable
# convention: entries are never edited or reordered after the fact.
task_log() {
    local name='' note_parts=() a
    while [ $# -gt 0 ]; do
        a=$1
        case "$a" in
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)
                if [ -z "$name" ]; then name=$a
                else note_parts+=("$a")
                fi ;;
        esac
        shift
    done
    if [ -z "$name" ]; then
        print_error "Usage: worktask log <name> [note...]"; return 1
    fi

    local src
    src="$(resolve_task "$name")" || {
        print_error "No task '$name' found."; return 1
    }

    local note=''
    [ ${#note_parts[@]} -gt 0 ] && note="${note_parts[*]}"
    note="$(trim "$note")"
    if [ -z "$note" ]; then
        read -r -p "log: " note
        note="$(trim "$note")"
        if [ -z "$note" ]; then
            print_error "Empty note — nothing recorded."; return 1
        fi
    fi

    local ts; ts=$(iso_now)
    if grep -q '^## Log$' "$src"; then
        printf -- '- %s: %s\n' "$ts" "$note" >> "$src"
    else
        printf '\n## Log\n\n- %s: %s\n' "$ts" "$note" >> "$src"
    fi
    print_success "Logged to ${src/#$HOME/\~}"
}

task_finish() {
    local name=$1 newstatus=$2

    local root="$WORK/data/tasks"
    if [ -f "$root/archived/$name.md" ]; then
        print_error "'$name' is already archived."; return 1
    fi
    local src="$root/$name.md"
    if [ ! -f "$src" ]; then
        print_error "No task '$name' found."; return 1
    fi

    local tmp; tmp=$(mktemp)
    sed "s/^status:.*/status: $newstatus/" "$src" > "$tmp"
    mv "$tmp" "$src"
    print_debug "Frontmatter updated: status=$newstatus"
    # Stage the edit now, at its current path, before the `git mv` below --
    # otherwise `git mv` can stage the rename using the index's stale
    # (pre-edit) blob instead of this file's current content, silently
    # dropping the frontmatter edit from the eventual commit.
    if git -C "$WORK/data" rev-parse --git-dir >/dev/null 2>&1; then
        git -C "$WORK/data" add "$src" 2>/dev/null || true
    fi

    mkdir -p "$root/archived"
    local dest="$root/archived/$name.md"
    if [ -e "$dest" ]; then
        print_error "Target already exists: tasks/archived/$name.md"; return 1
    fi
    if git -C "$WORK/data" rev-parse --git-dir >/dev/null 2>&1 \
       && [ -n "$(git -C "$WORK/data" ls-files "tasks/$name.md")" ]; then
        git -C "$WORK/data" mv "tasks/$name.md" "tasks/archived/$name.md" || {
            print_error "Move to tasks/archived/$name.md failed — task left in place."
            return 1
        }
    else
        mv "$src" "$dest" || {
            print_error "Move to tasks/archived/$name.md failed — task left in place."
            return 1
        }
    fi

    print_success "Archived → tasks/archived/$name.md ($newstatus)"
}

task_complete() {
    local name='' a
    for a in "$@"; do
        case "$a" in
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)
                if [ -z "$name" ]; then name=$a
                else print_error "Too many arguments."; return 1
                fi ;;
        esac
    done
    if [ -z "$name" ]; then
        print_error "Usage: worktask complete <name>"; return 1
    fi
    task_finish "$name" completed
}

task_cancel() {
    local name='' a
    for a in "$@"; do
        case "$a" in
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)
                if [ -z "$name" ]; then name=$a
                else print_error "Too many arguments."; return 1
                fi ;;
        esac
    done
    if [ -z "$name" ]; then
        print_error "Usage: worktask cancel <name>"; return 1
    fi
    task_finish "$name" cancelled
}

# Argument parsing here is deliberately different from every other
# subcommand in this file: consume exactly one positional (name), then
# treat everything remaining as an opaque pass-through array for
# `workitem create` with zero interpretation -- those are workitem's own
# flags, not this command's, so this is a one-shift-then-take-the-rest
# parse, not a case-loop rejecting `-*`.
task_promote() {
    if [ $# -eq 0 ]; then
        print_error "Usage: worktask promote <name> [workitem create args...]"; return 1
    fi
    local name=$1
    shift
    local create_args=("$@")

    local root="$WORK/data/tasks"
    if [ -f "$root/archived/$name.md" ]; then
        print_error "'$name' is archived — promote only applies to active tasks."
        return 1
    fi
    local src="$root/$name.md"
    if [ ! -f "$src" ]; then
        print_error "No task '$name' found."
        return 1
    fi

    if [ ${#create_args[@]} -eq 0 ]; then
        local heading
        heading=$(sed -n 's/^# *//p' "$src" | head -1)
        # An empty heading here just means wi_create sees an empty title
        # and errors "title is required" -- already safe by construction,
        # surfaces through the same abort path below.
        create_args=("$heading")
    fi

    # Uncaptured (not wrapped in $(...)) so workitem create's own
    # "Created -> ..." banner reaches the user directly; only the exit
    # status is checked. Subprocess call (found via $PATH), not duplicated
    # inline -- same precedent as wi_complete/wi_delete calling `worktree rm`.
    if ! workitem create "${create_args[@]}"; then
        print_error "workitem create failed — '$name' left untouched."
        return 1
    fi

    task_finish "$name" completed || {
        print_error "Work item was created, but completing '$name' failed (see above) — complete it manually."
        return 1
    }
}

task_delete() {
    local name='' force=false a
    for a in "$@"; do
        case "$a" in
            --force) force=true ;;
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)
                if [ -z "$name" ]; then name=$a
                else print_error "Too many arguments."; return 1
                fi ;;
        esac
    done
    if [ -z "$name" ]; then
        print_error "Usage: worktask delete <name> [--force]"; return 1
    fi

    local src
    src="$(resolve_task "$name")" || {
        print_error "No task '$name' found."; return 1
    }

    # Deletion is the one path that doesn't preserve the body -- see the root
    # CLAUDE.md's "nothing is deleted" principle. --force is the same explicit
    # admission `workitem delete` requires, so the two content types agree on
    # how dangerous this is; without it, the interactive prompt stands. The
    # prompt alone made this uncallable from a script or a non-interactive
    # session, which is why --force exists rather than replacing it.
    if [ "$force" != true ]; then
        if [ ! -t 0 ]; then
            print_error "Refusing to delete '$name' non-interactively without --force."
            return 1
        fi
        print_warning "About to permanently delete: ${src/#$HOME/\~}"
        read -r -p "This cannot be undone. Delete? [y/N] " yn
        if ! printf '%s' "$yn" | grep -qiE '^y'; then
            print_status "Cancelled — nothing deleted."; return 0
        fi
    fi

    rm -f "$src"
    print_success "Deleted ${src/#$HOME/\~}"
}

task_due() {
    local name='' newdate='' a
    while [ $# -gt 0 ]; do
        a=$1
        case "$a" in
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)
                if [ -z "$name" ]; then name=$a
                elif [ -z "$newdate" ]; then newdate=$a
                else print_error "Too many arguments."; return 1
                fi ;;
        esac
        shift
    done
    if [ -z "$name" ]; then
        print_error "Usage: worktask due <name> [date]"; return 1
    fi

    local src
    src="$(resolve_task "$name")" || {
        print_error "No task '$name' found."; return 1
    }

    if [ -n "$newdate" ]; then
        local resolved
        resolved=$(resolve_date "$newdate") || {
            print_error "Date must be YYYY-MM-DD, or a relative form (today, tomorrow, a weekday name)."
            return 1
        }
        newdate="$resolved"
    fi

    local tmp; tmp=$(mktemp)
    if grep -q '^due:' "$src"; then
        if [ -n "$newdate" ]; then
            sed "s/^due:.*/due: $newdate/" "$src" > "$tmp"
        else
            sed '/^due:/d' "$src" > "$tmp"
        fi
    elif [ -n "$newdate" ]; then
        awk -v d="$newdate" '/^status:/ { print; print "due: " d; next } { print }' "$src" > "$tmp"
    else
        cp "$src" "$tmp"
    fi
    mv "$tmp" "$src"

    if [ -n "$newdate" ]; then
        print_success "Set due: $newdate on ${src/#$HOME/\~}"
    else
        print_success "Cleared due date on ${src/#$HOME/\~}"
    fi
}

# Set, pick, or clear a task's related-item association.
#   item <name> <slug>   -- set directly (tab-completable)
#   item <name>          -- interactive picker (same one create uses)
#   item <name> --clear  -- remove the association
task_item() {
    local name='' item='' clear=false a
    for a in "$@"; do
        case "$a" in
            --clear) clear=true ;;
            -*) print_error "Unknown option: $a"; return 1 ;;
            *)
                if [ -z "$name" ]; then name=$a
                elif [ -z "$item" ]; then item=$a
                else print_error "Too many arguments."; return 1
                fi ;;
        esac
    done
    if [ -z "$name" ]; then
        print_error "Usage: worktask item <name> [slug|--clear]"; return 1
    fi
    if [ "$clear" = true ] && [ -n "$item" ]; then
        print_error "--clear doesn't take a slug."; return 1
    fi

    local src
    src="$(resolve_task "$name")" || {
        print_error "No task '$name' found."; return 1
    }

    if [ "$clear" = true ]; then
        if ! grep -q '^related-item:' "$src"; then
            print_status "'$name' has no related item — nothing to clear."
            return 0
        fi
        local tmp; tmp=$(mktemp)
        sed '/^related-item:/d' "$src" > "$tmp"
        mv "$tmp" "$src"
        print_success "Cleared related item on ${src/#$HOME/\~}"
        return 0
    fi

    # No slug given -- fall back to the same interactive picker `create`
    # uses, rather than treating a bare `item <name>` as a clear the way
    # `due` treats a bare date arg; unlike due dates, items already have a
    # picker, so that's the more useful default and leaves --clear as the
    # one unambiguous way to remove.
    if [ -z "$item" ]; then
        item=$(task_pick_item) || return 1
    fi

    if ! task_item_known "$item"; then
        print_warning "'$item' isn't an existing item; tagging anyway."
    fi

    local tmp; tmp=$(mktemp)
    if grep -q '^related-item:' "$src"; then
        sed "s|^related-item:.*|related-item: \"[[$item]]\"|" "$src" > "$tmp"
    else
        awk -v i="$item" '/^status:/ { print; print "related-item: \"[[" i "]]\""; next } { print }' "$src" > "$tmp"
    fi
    mv "$tmp" "$src"
    print_success "Set related item: $item on ${src/#$HOME/\~}"
}

###
### Dispatch
###
# Parse global options before the subcommand so `worktask -v list` works.
# -d implies -v.
# shellcheck disable=SC2034  # VERBOSE/DEBUG are read by print_* in lib.sh
while [ $# -gt 0 ]; do
    case "$1" in
        -v|--verbose) VERBOSE=true; shift ;;
        -d|--debug)   DEBUG=true; VERBOSE=true; shift ;;
        -h|--help|help) printf '%s\n' "$usage"; exit 0 ;;
        *) break ;;
    esac
done

cmd="${1:-}"
[ "$#" -gt 0 ] && shift
case "$cmd" in
    create)   task_create "$@" ;;
    list)     task_list "$@" ;;
    show)     task_show "$@" ;;
    log)      task_log "$@" ;;
    complete) task_complete "$@" ;;
    cancel)   task_cancel "$@" ;;
    delete)   task_delete "$@" ;;
    due)      task_due "$@" ;;
    item)     task_item "$@" ;;
    promote)  task_promote "$@" ;;
    '')      printf '%s\n' "$usage" ;;
    *)       print_error "Unknown command '$cmd' (try: worktask help)"; exit 1 ;;
esac
